{%- liquid
  assign has_vsl = false
  if section.settings.vsl_video != blank or section.settings.vsl_video_url != blank
    assign has_vsl = true
  endif
-%}
{%- if has_vsl or request.design_mode -%}
<div class="cs cs-duo-vsl">
  <div class="cs-wrap cs-dv-in">
    <div class="cs-sec-head cs-dv-head">
      {%- if section.settings.eyebrow != blank -%}<span class="cs-eyebrow cs-on-night">✦ {{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="cs-dv-h">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p class="cs-dv-body">{{ section.settings.body }}</p>{%- endif -%}
    </div>

    {%- assign dv_cover = section.settings.poster -%}
    <div class="cs-dv-stage-wrap">
      {%- if section.settings.vsl_video != blank or section.settings.vsl_video_url != blank -%}
        <div class="cs-dv-stage" data-cs-duo-play>
          {%- if section.settings.vsl_video != blank -%}
            {{ section.settings.vsl_video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1920x', class: 'cs-dv-video' }}
          {%- else -%}
            <video class="cs-dv-video" controls playsinline preload="none"{% if dv_cover != blank %} poster="{{ dv_cover | image_url: width: 1920 }}"{% endif %}><source src="{{ section.settings.vsl_video_url | escape }}" type="video/mp4"></video>
          {%- endif -%}
          <button type="button" class="cs-dv-cover" data-cs-duo-trigger aria-label="{{ section.settings.play_label | default: 'Play' | escape }}">
            {%- if dv_cover != blank -%}<img src="{{ dv_cover | image_url: width: 1920 }}" alt="{{ dv_cover.alt | default: 'Watch' | escape }}" loading="lazy">{%- endif -%}
            <span class="cs-dv-scrim"></span>
            <span class="cs-dv-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
            {%- if section.settings.play_label != blank -%}<span class="cs-dv-playlabel">{{ section.settings.play_label }}</span>{%- endif -%}
          </button>
        </div>
      {%- else -%}
        <div class="cs-dv-stage cs-dv-stage-still">
          {%- if dv_cover != blank -%}
            <img src="{{ dv_cover | image_url: width: 1920 }}" alt="{{ dv_cover.alt | default: 'Watch' | escape }}" loading="lazy"><span class="cs-dv-scrim"></span>
          {%- else -%}
            <div class="cs-dv-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9l5 3-5 3z" stroke-linejoin="round"/></svg>{%- if request.design_mode -%}<span>Add the VSL — Theme editor ▸ CraftStory Duo VSL ▸ VSL video</span>{%- endif -%}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="cs-dv-marks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mark' and block.settings.text != blank -%}
            <li {{ block.shopify_attributes }}>{%- if block.settings.time != blank -%}<span class="cs-dv-t">{{ block.settings.time }}</span>{%- endif -%}<span>{{ block.settings.text }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="cs-dv-cta">
        <a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- if section.settings.cta_note != blank -%}<span class="cs-dv-note">{{ section.settings.cta_note }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
<script>
(function(){
  var stages = document.querySelectorAll('[data-cs-duo-play]');
  Array.prototype.forEach.call(stages, function(stage){
    if(stage.dataset.csDuoInit) return;
    stage.dataset.csDuoInit = '1';
    var cover = stage.querySelector('[data-cs-duo-trigger]');
    var video = stage.querySelector('video');
    if(!cover || !video) return;
    cover.addEventListener('click', function(){
      stage.classList.add('cs-duo-playing');
      try { video.setAttribute('controls',''); } catch(e){}
      var p = video.play();
      if(p && p.catch){ p.catch(function(){}); }
      try { video.focus(); } catch(e){}
    });
  });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo VSL",
  "settings": [
    { "type": "paragraph", "content": "The main video on the couples landing page. Landscape 16:9, click to play, never autoplays. The bullets under it tell the visitor what they are about to see." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch this first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Here is what they get — and how they react when it plays." },
    { "type": "textarea", "id": "body", "label": "Mini-text", "default": "Three real songs, three music videos, three first listens. Sound on." },
    { "type": "header", "content": "VSL video" },
    { "type": "video", "id": "vsl_video", "label": "VSL (upload MP4)", "info": "Landscape 16:9." },
    { "type": "text", "id": "vsl_video_url", "label": "…or .mp4 URL" },
    { "type": "image_picker", "id": "poster", "label": "Thumbnail (poster)" },
    { "type": "text", "id": "play_label", "label": "Play-button caption", "default": "Play with sound on" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" },
    { "type": "text", "id": "cta_note", "label": "Note next to the button", "default": "Free preview first — pay only if you love it" }
  ],
  "blocks": [
    { "type": "mark", "name": "Bullet", "limit": 6, "settings": [
      { "type": "text", "id": "time", "label": "Timestamp (optional)", "default": "0:00" },
      { "type": "text", "id": "text", "label": "Text", "default": "What the song sounds like" }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo VSL", "blocks": [
      { "type": "mark", "settings": { "time": "0:12", "text": "A full song written from one couple's story" } },
      { "type": "mark", "settings": { "time": "0:48", "text": "The music video, with the two of them on screen" } },
      { "type": "mark", "settings": { "time": "1:30", "text": "Her face the moment she hears her own name" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-vsl{background:var(--cs-night);color:var(--cs-night-ink)}
.cs-dv-in{display:flex;flex-direction:column;align-items:center;gap:clamp(20px,3vw,32px);padding:clamp(48px,7vw,96px) 22px}
.cs-dv-head{margin:0;max-width:760px}
.cs-dv-h{font-size:clamp(1.7rem,3.6vw,2.6rem);line-height:1.12;color:var(--cs-night-ink)}
.cs-dv-body{color:var(--cs-night-ink2);font-size:clamp(1rem,1.4vw,1.1rem);line-height:1.55}
.cs-dv-stage-wrap{width:100%;max-width:980px}
.cs-dv-stage{position:relative;aspect-ratio:16/9;border-radius:var(--cs-r-xl);overflow:hidden;background:#000;box-shadow:var(--cs-sh-lg);border:1px solid var(--cs-night-line)}
.cs-dv-video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;background:#000}
.cs-dv-cover{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;margin:0;cursor:pointer;display:block;background:#000;font:inherit}
.cs-duo-playing .cs-dv-cover{display:none}
.cs-dv-cover img,.cs-dv-stage-still img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-dv-scrim{position:absolute;inset:0;background:radial-gradient(circle at 50% 46%,rgba(0,0,0,.12),rgba(0,0,0,.52))}
.cs-dv-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:clamp(64px,9vw,92px);height:clamp(64px,9vw,92px);border-radius:50%;background:rgba(255,255,255,.96);color:var(--cs-coral);display:grid;place-items:center;box-shadow:0 14px 38px rgba(0,0,0,.44);transition:transform .18s ease}
.cs-dv-play svg{width:38%;height:38%;margin-left:8%}
.cs-dv-cover:hover .cs-dv-play,.cs-dv-cover:focus-visible .cs-dv-play{transform:translate(-50%,-50%) scale(1.09)}
.cs-dv-playlabel{position:absolute;left:16px;right:16px;bottom:16px;text-align:center;color:#fff;font-weight:700;font-size:clamp(.88rem,1.35vw,1.04rem);text-shadow:0 2px 12px rgba(0,0,0,.62)}
.cs-dv-empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#100d1c;color:#8d83a6;font-weight:600;font-size:.86rem;text-align:center;padding:18px}
.cs-dv-empty svg{width:44px;height:44px}
.cs-dv-marks{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;max-width:900px}
.cs-dv-marks li{display:flex;gap:9px;align-items:baseline;color:var(--cs-night-ink2);font-size:.96rem;font-weight:500}
.cs-dv-t{color:var(--cs-star);font-weight:700;font-variant-numeric:tabular-nums;font-size:.86rem}
.cs-dv-cta{display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:4px}
.cs-dv-note{font-size:.88rem;color:var(--cs-night-ink2);font-weight:600}
@media(max-width:640px){
  .cs-dv-in{padding:clamp(30px,7vw,48px) 22px}
  .cs-dv-marks{flex-direction:column;align-items:flex-start;gap:9px}
  .cs-dv-cta{width:100%}
  .cs-dv-cta .cs-btn{width:100%}
}
{% endstylesheet %}
