{%- liquid
  assign msgs = 0
  if section.settings.text != blank
    assign msgs = msgs | plus: 1
  endif
  for block in section.blocks
    if block.settings.text != blank
      assign msgs = msgs | plus: 1
    endif
  endfor
  assign cols = msgs
  if cols < 1
    assign cols = 1
  endif
  assign align = section.settings.align | default: 'center'
  assign item_vars = '--cs-duo-ann-size-m:12px;--cs-duo-ann-size-d:13px;--cs-duo-ann-ico-m:18px;--cs-duo-ann-ico-d:20px;'
-%}
{%- if msgs > 0 or request.design_mode -%}
<div class="cs cs-duo-ann" role="region" aria-label="Announcement"
     style="{% if section.settings.bg != blank %}--cs-duo-ann-bg:{{ section.settings.bg }};{% endif %}{% if section.settings.ink != blank %}--cs-duo-ann-ink:{{ section.settings.ink }};{% endif %}--cs-duo-ann-cols:{{ cols }};">
  <div class="cs-ann-in cs-wrap">
    {%- if msgs > 0 -%}
      <ul class="cs-ann-track"{% if section.settings.autoplay and msgs > 1 %} data-cs-ann-auto data-cs-ann-speed="{{ section.settings.speed }}"{% endif %}>

        {%- if section.settings.text != blank -%}
          <li class="cs-ann-slide">
            <div class="cs-ann-item cs-ann-item--{{ align }}" style="{{ item_vars }}">
              <p class="cs-ann-msg">
                {%- if section.settings.icon != blank -%}
                  <img class="cs-ann-ico" src="{{ section.settings.icon | image_url: width: 60 }}" alt="" width="20" height="20" loading="lazy">
                {%- endif -%}
                {%- if section.settings.link != blank -%}
                  <a class="cs-ann-lnk" href="{{ section.settings.link }}"><span>{{ section.settings.text }}</span></a>
                {%- else -%}
                  <span>{{ section.settings.text }}</span>
                {%- endif -%}
              </p>
            </div>
          </li>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="cs-ann-slide" {{ block.shopify_attributes }}>
              <div class="cs-ann-item cs-ann-item--{{ align }}" style="{{ item_vars }}">
                <p class="cs-ann-msg">
                  {%- if block.settings.icon != blank -%}
                    <img class="cs-ann-ico" src="{{ block.settings.icon | image_url: width: 60 }}" alt="" width="20" height="20" loading="lazy">
                  {%- endif -%}
                  {%- if block.settings.link != blank -%}
                    <a class="cs-ann-lnk" href="{{ block.settings.link }}"><span>{{ block.settings.text }}</span></a>
                  {%- else -%}
                    <span>{{ block.settings.text }}</span>
                  {%- endif -%}
                </p>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}

      </ul>
    {%- else -%}
      <p class="cs-ann-msg cs-ann-hint"><span>Write the bar's message — Theme editor &#9656; CraftStory Duo Banner &#9656; Message. While it is empty the bar never shows on the storefront.</span></p>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo Banner",
  "class": "cs-duo-ann-section",
  "settings": [
    { "type": "paragraph", "content": "The thin bar above the header. One line, small caps, a fixed 17px line box, 6px of padding on mobile and 8px from 750px up. Leave the message empty and the whole bar disappears from the storefront." },
    { "type": "header", "content": "Message" },
    { "type": "text", "id": "text", "label": "Message", "default": "Songs and animated music videos", "info": "Keep it short: the bar is one fixed 17px line, so a message past about 30 characters is trimmed with an ellipsis on a 375px phone. Empty hides the bar. Never a countdown, an expiring discount, a customer count or a rating — the store's copy rules forbid invented urgency and invented numbers." },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "image_picker", "id": "icon", "label": "Icon before the message (optional)", "info": "Shown at 18px on mobile, 20px on desktop." },
    { "type": "select", "id": "align", "label": "Message alignment", "default": "center", "options": [
      { "value": "center", "label": "Centred (matches the reference)" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ] },
    { "type": "header", "content": "Band" },
    { "type": "color", "id": "bg", "label": "Band colour", "default": "#555555", "info": "Neutral dark grey by default. #1C1533 switches it to the CraftStory night." },
    { "type": "color", "id": "ink", "label": "Text colour", "default": "#FFFFFF" },
    { "type": "header", "content": "Several messages" },
    { "type": "paragraph", "content": "Add message blocks to run more than one line. They sit side by side from 750px up and become a swipeable row on mobile." },
    { "type": "checkbox", "id": "autoplay", "label": "Rotate the messages on mobile", "default": false, "info": "Off by default, and always off for visitors who ask for reduced motion." },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 3 }
  ],
  "blocks": [
    { "type": "message", "name": "Extra message", "limit": 4, "settings": [
      { "type": "text", "id": "text", "label": "Message", "info": "Empty blocks are skipped." },
      { "type": "url", "id": "link", "label": "Link (optional)" },
      { "type": "image_picker", "id": "icon", "label": "Icon (optional)" }
    ] }
  ],
  "presets": [ { "name": "CraftStory Duo Banner", "blocks": [] } ]
}
{% endschema %}
{% stylesheet %}
.cs.cs-duo-ann{
  --cs-duo-ann-bg:#555555;
  --cs-duo-ann-ink:#FFFFFF;
  --cs-duo-ann-gap:16px;
  --cs-duo-ann-h:17px;
  background:var(--cs-duo-ann-bg);
  color:var(--cs-duo-ann-ink);
  padding:6px 0;
}
.cs-duo-ann .cs-ann-in{min-width:0}
.cs-duo-ann .cs-ann-track{
  position:relative;list-style:none;margin:0;padding:0;min-width:0;
  display:grid;grid-auto-flow:column;grid-auto-columns:100%;gap:var(--cs-duo-ann-gap);
  overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;
  -webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none;
}
.cs-duo-ann .cs-ann-track::-webkit-scrollbar{display:none}
.cs-duo-ann .cs-ann-slide{
  min-width:0;scroll-snap-align:center;
  display:flex;align-items:center;min-height:var(--cs-duo-ann-h);
}
.cs-duo-ann .cs-ann-item{min-width:0;width:100%;display:flex;align-items:center}
.cs-duo-ann .cs-ann-item--center{justify-content:center}
.cs-duo-ann .cs-ann-item--left{justify-content:flex-start}
.cs-duo-ann .cs-ann-item--right{justify-content:flex-end}
.cs-duo-ann .cs-ann-msg{
  display:flex;align-items:center;gap:8px;margin:0;min-width:0;max-width:100%;
  font-family:var(--cs-sans);font-size:var(--cs-duo-ann-size-m,12px);font-weight:600;
  letter-spacing:.08em;text-transform:uppercase;line-height:1.3;color:inherit;
}
.cs-duo-ann .cs-ann-msg > span,
.cs-duo-ann .cs-ann-lnk,
.cs-duo-ann .cs-ann-lnk > span{
  display:block;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.cs-duo-ann .cs-ann-ico{
  width:var(--cs-duo-ann-ico-m,18px);height:var(--cs-duo-ann-ico-m,18px);
  flex:0 0 auto;object-fit:contain;
}
.cs-duo-ann .cs-ann-lnk{color:inherit;text-decoration:none}
.cs-duo-ann .cs-ann-lnk:hover{text-decoration:underline}
.cs-duo-ann .cs-ann-msg.cs-ann-hint{
  text-transform:none;letter-spacing:.01em;font-weight:500;opacity:.9;
  justify-content:center;text-align:center;
}
.cs-duo-ann .cs-ann-msg.cs-ann-hint > span{display:inline;white-space:normal;overflow:visible;text-overflow:clip}
@media(min-width:750px){
  .cs.cs-duo-ann{padding:8px 0}
  .cs-duo-ann .cs-ann-msg{font-size:var(--cs-duo-ann-size-d,13px)}
  .cs-duo-ann .cs-ann-ico{width:var(--cs-duo-ann-ico-d,20px);height:var(--cs-duo-ann-ico-d,20px)}
  .cs-duo-ann .cs-ann-track{
    grid-auto-flow:row;grid-auto-columns:auto;
    grid-template-columns:repeat(var(--cs-duo-ann-cols,1),minmax(0,1fr));
    overflow:visible;scroll-snap-type:none;
  }
}
{% endstylesheet %}
{% javascript %}
(function () {
  function init(root) {
    var scope = root && root.querySelectorAll ? root : document;
    var tracks = scope.querySelectorAll('.cs-ann-track[data-cs-ann-auto]');
    for (var i = 0; i < tracks.length; i++) start(tracks[i]);
  }

  function start(track) {
    if (track.dataset.csAnnOn === '1') return;
    if (track.children.length < 2) return;
    track.dataset.csAnnOn = '1';

    var calm = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;

    var wait = (parseFloat(track.dataset.csAnnSpeed) || 3) * 1000;
    var at = 0;
    var held = false;
    var timer = window.setInterval(function () {
      if (!track.isConnected) { window.clearInterval(timer); return; }
      if (held || document.hidden) return;
      if (calm && calm.matches) return;
      if (track.scrollWidth <= track.clientWidth + 2) return;
      var from = at;
      at = (at + 1) % track.children.length;
      var slide = track.children[at];
      if (!slide) return;
      var how = at === 0 && from !== 0 ? 'auto' : 'smooth';
      if (track.scrollTo) track.scrollTo({ left: slide.offsetLeft, behavior: how });
      else track.scrollLeft = slide.offsetLeft;
    }, wait);

    function hold() { held = true; }
    function free() { held = false; }
    track.addEventListener('pointerenter', hold);
    track.addEventListener('pointerleave', free);
    track.addEventListener('touchstart', hold, { passive: true });
    track.addEventListener('touchend', free, { passive: true });
    track.addEventListener('focusin', hold);
    track.addEventListener('focusout', free);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
  else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
