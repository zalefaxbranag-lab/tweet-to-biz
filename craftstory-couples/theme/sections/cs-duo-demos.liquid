{%- liquid
  assign clips = 0
  for block in section.blocks
    if block.type == 'clip'
      if block.settings.video != blank or block.settings.video_url != blank
        assign clips = clips | plus: 1
      endif
    endif
  endfor
-%}
{%- if clips > 0 or request.design_mode -%}
<div class="cs cs-duo-demos">
  <div class="cs-wrap">
    <div class="cs-sec cs-dd-sec">
      <div class="cs-sec-head">
        {%- if section.settings.eyebrow != blank -%}<span class="cs-eyebrow">✦ {{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cs-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
      </div>

      {%- assign kinds = 'music,reaction' | split: ',' -%}
      {%- for kind in kinds -%}
        {%- assign group_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'clip' and block.settings.kind == kind -%}{%- assign group_count = group_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}

        {%- if group_count > 0 -%}
          {%- if kind == 'music' -%}
            {%- assign group_title = section.settings.music_title -%}
          {%- else -%}
            {%- assign group_title = section.settings.reaction_title -%}
          {%- endif -%}

          <div class="cs-dd-group">
            {%- if group_title != blank -%}<h3 class="cs-dd-gt">{{ group_title }}</h3>{%- endif -%}
            {%- if group_count > 1 -%}<span class="cs-dd-swipe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>Swipe to see all {{ group_count }}</span>{%- endif -%}
            <div class="cs-dd-grid">
              {%- for block in section.blocks -%}
                {%- if block.type == 'clip' and block.settings.kind == kind -%}
                  {%- assign dd_cover = block.settings.cover -%}
                  <figure class="cs-dd-card" {{ block.shopify_attributes }}>
                    {%- if block.settings.video != blank or block.settings.video_url != blank -%}
                      <div class="cs-dd-stage" data-cs-duo-play>
                        {%- if block.settings.video != blank -%}
                          {{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1200x', class: 'cs-dd-video' }}
                        {%- else -%}
                          <video class="cs-dd-video" controls playsinline preload="none"{% if dd_cover != blank %} poster="{{ dd_cover | image_url: width: 1200 }}"{% endif %}><source src="{{ block.settings.video_url | escape }}" type="video/mp4"></video>
                        {%- endif -%}
                        <button type="button" class="cs-dd-cover" data-cs-duo-trigger aria-label="{{ block.settings.label | default: 'Play' | escape }}">
                          {%- if dd_cover != blank -%}<img src="{{ dd_cover | image_url: width: 1200 }}" alt="{{ dd_cover.alt | default: block.settings.label | default: 'Clip' | escape }}" loading="lazy">{%- endif -%}
                          <span class="cs-dd-scrim"></span>
                          <span class="cs-dd-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
                          {%- if block.settings.label != blank -%}<span class="cs-dd-lab">{{ block.settings.label }}</span>{%- endif -%}
                        </button>
                      </div>
                    {%- elsif dd_cover != blank -%}
                      <div class="cs-dd-stage cs-dd-still"><img src="{{ dd_cover | image_url: width: 1200 }}" alt="{{ dd_cover.alt | default: 'Clip' | escape }}" loading="lazy"><span class="cs-dd-scrim"></span></div>
                    {%- else -%}
                      <div class="cs-dd-stage cs-dd-still cs-dd-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9l5 3-5 3z" stroke-linejoin="round"/></svg>{%- if request.design_mode -%}<span>Add this clip's MP4</span>{%- endif -%}</div>
                    {%- endif -%}
                    {%- if block.settings.caption != blank -%}<figcaption class="cs-dd-cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
                  </figure>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="cs-dd-cta"><a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
(function(){
  var stages = document.querySelectorAll('[data-cs-duo-play]');
  Array.prototype.forEach.call(stages, function(stage){
    if(stage.dataset.csDuoInit) return;
    stage.dataset.csDuoInit = '1';
    var cover = stage.querySelector('[data-cs-duo-trigger]');
    var video = stage.querySelector('video');
    if(!cover || !video) return;
    cover.addEventListener('click', function(){
      stage.classList.add('cs-duo-playing');
      try { video.setAttribute('controls',''); } catch(e){}
      var p = video.play();
      if(p && p.catch){ p.catch(function(){}); }
      try { video.focus(); } catch(e){}
    });
  });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo Demos",
  "settings": [
    { "type": "paragraph", "content": "The proof row. Add clips as blocks and tag each one as a music video or a first listen. All clips are landscape 16:9, so the same files work as ad creatives. Nothing autoplays." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real songs, real reactions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear three of them. Then watch three people hear theirs." },
    { "type": "textarea", "id": "body", "label": "Mini-text", "default": "Every song below came from one couple answering five questions." },
    { "type": "header", "content": "Group titles" },
    { "type": "text", "id": "music_title", "label": "Music-video row title", "default": "The music videos" },
    { "type": "text", "id": "reaction_title", "label": "Reaction row title", "default": "The first listen" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" }
  ],
  "blocks": [
    { "type": "clip", "name": "Clip", "limit": 12, "settings": [
      { "type": "select", "id": "kind", "label": "Row", "default": "music", "options": [
        { "value": "music", "label": "Music video" },
        { "value": "reaction", "label": "First listen" }
      ] },
      { "type": "video", "id": "video", "label": "Clip (upload MP4)", "info": "Landscape 16:9." },
      { "type": "text", "id": "video_url", "label": "…or .mp4 URL" },
      { "type": "image_picker", "id": "cover", "label": "Thumbnail (poster)" },
      { "type": "text", "id": "label", "label": "Caption on the thumbnail", "default": "Play" },
      { "type": "text", "id": "caption", "label": "Caption under the clip" }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Demos", "blocks": [
      { "type": "clip", "settings": { "kind": "music", "label": "Play", "caption": "Written from how they met" } },
      { "type": "clip", "settings": { "kind": "music", "label": "Play", "caption": "Their first dance, made for them" } },
      { "type": "clip", "settings": { "kind": "music", "label": "Play", "caption": "Ten years, one song" } },
      { "type": "clip", "settings": { "kind": "reaction", "label": "Play", "caption": "She hears her name in the second line" } },
      { "type": "clip", "settings": { "kind": "reaction", "label": "Play", "caption": "He did not know it existed" } },
      { "type": "clip", "settings": { "kind": "reaction", "label": "Play", "caption": "Played at the reception" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-demos{background:var(--cs-paper)}
.cs-dd-group{margin-bottom:clamp(30px,4vw,52px)}
.cs-dd-gt{font-size:clamp(1.1rem,1.9vw,1.32rem);margin-bottom:16px;display:flex;align-items:center;gap:.6em}
.cs-dd-gt:after{content:"";flex:1;height:1px;background:var(--cs-line)}
.cs-dd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2vw,22px)}
.cs-dd-card{margin:0;display:flex;flex-direction:column;gap:10px}
.cs-dd-stage{position:relative;aspect-ratio:16/9;border-radius:var(--cs-r-lg);overflow:hidden;background:#000;box-shadow:var(--cs-sh);border:1px solid var(--cs-line)}
.cs-dd-video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;background:#000}
.cs-dd-cover{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;margin:0;cursor:pointer;display:block;background:#000;font:inherit}
.cs-duo-playing .cs-dd-cover{display:none}
.cs-dd-cover img,.cs-dd-still img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-dd-scrim{position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(0,0,0,.08),rgba(0,0,0,.42))}
.cs-dd-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:clamp(44px,5.4vw,58px);height:clamp(44px,5.4vw,58px);border-radius:50%;background:rgba(255,255,255,.95);color:var(--cs-coral);display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,0,0,.34);transition:transform .18s ease}
.cs-dd-play svg{width:38%;height:38%;margin-left:8%}
.cs-dd-cover:hover .cs-dd-play,.cs-dd-cover:focus-visible .cs-dd-play{transform:translate(-50%,-50%) scale(1.1)}
.cs-dd-lab{position:absolute;left:10px;bottom:10px;color:#fff;font-weight:700;font-size:.82rem;text-shadow:0 2px 10px rgba(0,0,0,.6)}
.cs-dd-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:#171310;color:#cdbfa9;font-weight:600;font-size:.8rem;text-align:center;padding:14px}
.cs-dd-empty svg{width:34px;height:34px}
.cs-dd-cap{font-size:.93rem;color:var(--cs-ink2);font-weight:500;line-height:1.45}
.cs-dd-cta{display:flex;justify-content:center;margin-top:8px}
.cs-dd-swipe{display:none;align-items:center;gap:6px;font-size:.8rem;font-weight:600;
  color:var(--cs-ink3);margin:-4px 0 10px}
.cs-dd-swipe svg{width:15px;height:15px}
@media(max-width:900px){.cs-dd-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){
  /* 6 clips empiles = 2,8 ecrans de scroll mort. En swipe : ~0,9 ecran,
     et la carte suivante qui depasse sert d'invitation. */
  .cs-duo-demos .cs-sec{padding:clamp(34px,7vw,52px) 0}
  .cs-dd-grid{display:flex;grid-template-columns:none;gap:12px;overflow-x:auto;
    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
    scrollbar-width:none;padding:2px 22px 4px;margin:0 -22px}
  .cs-dd-grid::-webkit-scrollbar{display:none}
  .cs-dd-card{flex:0 0 82%;scroll-snap-align:center;gap:8px}
  .cs-dd-group{margin-bottom:26px}
  .cs-dd-gt{margin-bottom:10px;font-size:1.06rem}
  .cs-dd-gt:after{display:none}
  .cs-dd-swipe{display:flex}
  .cs-dd-cta{width:100%;margin-top:4px}
  .cs-dd-cta .cs-btn{width:100%}
}

{% endstylesheet %}
