{%- liquid
  comment
    Le tunnel couples. Sept ecrans, un seul chargement de page : tout le reste
    s'echange dans le DOM, l'etat reste en memoire.

    Ou partent les reponses, par ordre de priorite :
      1. api_url, si tu le remplis dans l'editeur -> POST JSON vers ton
         endpoint. C'est la porte pour brancher la generation plus tard :
         un champ a remplir, rien a recoder.
      2. sinon -> le formulaire de contact natif de Shopify, donc ta boite
         mail. Aucun worker, aucune app, ca marche tout de suite.

    L'ecran photo (6) est obligatoire : sans visage, il n'y a pas de preview
    a montrer. Le formulaire de contact de Shopify ne sait pas porter de
    fichier, donc les photos sont reduites dans le navigateur et envoyees en
    dataURL avec le reste du JSON — exactement ce que le worker des enfants
    recoit deja. Sans api_url elles restent dans l'onglet du visiteur, et le
    message qui arrive dans la boite mail le dit.
  endcomment

  assign rel = section.settings.rel_options | newline_to_br | split: '<br />'
  assign occ = section.settings.occ_options | newline_to_br | split: '<br />'
  assign gen = section.settings.genre_options | newline_to_br | split: '<br />'
  assign voi = section.settings.voice_options | newline_to_br | split: '<br />'
  assign lang = section.settings.lang_options | newline_to_br | split: '<br />'

-%}
{%- comment -%}
  LE VERROU DE LA PAGE UNIQUE.

  Tout ce qui est pose SOUS le tunnel dans ce gabarit (la preview, l'offre,
  les avis, les questions) reste cache tant que l'attente n'est pas finie.
  Le selecteur « ~ .shopify-section » vise les sections qui SUIVENT celle-ci,
  et elles seules : rien a regler dans les autres sections, et une page sans
  rien dessous n'est pas touchee.

  Le verrou est pose ici, dans le HTML, pas par le script : sinon le bas de la
  page s'affiche une fraction de seconde avant d'etre cache. Jamais dans
  l'editeur de theme, ou le marchand doit tout voir pour tout regler.
{%- endcomment -%}
{%- unless request.design_mode -%}
  <style>html[data-cs-duo-gate="closed"] #shopify-section-{{ section.id }} ~ .shopify-section{display:none !important}</style>
  <script>document.documentElement.setAttribute('data-cs-duo-gate', 'closed');</script>
{%- endunless -%}
<div class="cs cs-duo-flow" id="cs-duo-flow"
     data-cs-flow
     data-api="{{ section.settings.api_url | escape }}"
     {%- comment -%}
       data-next-page, PAS data-next : data-next porte deja le libelle du
       bouton Suivant. Deux attributs du meme nom sur la meme balise, et le
       bouton se met a afficher une URL.
     {%- endcomment -%}
     data-next-page="{{ section.settings.next_page | escape }}"
     data-mk-min="{{ section.settings.mk_minutes }}"
     data-mk-after="{{ section.settings.mk_after_video | default: 'Your preview is ready — it appears right after the video.' | escape }}"
     data-mk-done="{{ section.settings.mk_done | default: 'Your preview is ready' | escape }}"
     data-mk-stages="{{ section.settings.mk_stages | newline_to_br | replace: '<br />', '|' | escape }}"
     data-next="{{ section.settings.next_label | default: 'Next' | escape }}"
     data-last="{{ section.settings.last_label | default: 'Create our song' | escape }}"
     data-err-req="{{ section.settings.err_required | default: 'Please fill this in before continuing.' | escape }}"
     data-err-email="{{ section.settings.err_email | default: 'That email address does not look right.' | escape }}"
     data-err-send="{{ section.settings.err_send | default: 'We could not send that. Check your connection and try again.' | escape }}"
     data-ph-one="{{ section.settings.s6_one | default: '1 photo added — tap to change' | escape }}"
     data-ph-two="{{ section.settings.s6_two | default: '2 photos added — tap to change' | escape }}"
     data-ph-max="{{ section.settings.err_photo_max | default: 'Two photos is the maximum — we kept the first two.' | escape }}">
  <div class="cs-flow-wrap">

    <div class="cs-flow-top">
      <button type="button" class="cs-flow-back" data-cs-back hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        {{ section.settings.back_label | default: 'Back' }}
      </button>
      <div class="cs-flow-prog" aria-hidden="true"><i data-cs-bar></i></div>
    </div>

    <form class="cs-flow-form" data-cs-form novalidate>

      {%- comment -%} 1. pour qui, prenoms, occasion {%- endcomment -%}
      <section class="cs-flow-step" data-step="1">
        <h1 class="cs-flow-h">{{ section.settings.s1_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s1_sub }}</p>

        <fieldset class="cs-flow-fs">
          <legend>{{ section.settings.s1_who }}</legend>
          <div class="cs-flow-radios">
            {%- for r in rel -%}{%- assign v = r | strip -%}{%- if v != blank -%}
              <label class="cs-flow-radio"><input type="radio" name="relationship" value="{{ v | escape }}"><span>{{ v }}</span></label>
            {%- endif -%}{%- endfor -%}
          </div>
        </fieldset>

        <div class="cs-flow-two">
          <label class="cs-flow-fld"><span>{{ section.settings.s1_their }}</span>
            <input type="text" name="their_name" maxlength="24" autocomplete="off" data-req></label>
          <label class="cs-flow-fld"><span>{{ section.settings.s1_your }}</span>
            <input type="text" name="your_name" maxlength="24" autocomplete="given-name" data-req></label>
        </div>

        <fieldset class="cs-flow-fs">
          <legend>{{ section.settings.s1_occasion }}</legend>
          <div class="cs-flow-radios">
            {%- for o in occ -%}{%- assign v = o | strip -%}{%- if v != blank -%}
              <label class="cs-flow-radio"><input type="radio" name="occasion" value="{{ v | escape }}"><span>{{ v }}</span></label>
            {%- endif -%}{%- endfor -%}
          </div>
          {%- comment -%}
            Le champ libre. Il vit dans le meme fieldset que ses boutons : le
            script part de la pour retrouver le groupe, donc il suffit de le
            deplacer pour l'attacher a un autre choix.
          {%- endcomment -%}
          {%- if section.settings.occ_other != blank -%}
            <label class="cs-flow-fld cs-flow-more" data-cs-more="{{ section.settings.occ_other | escape }}" hidden>
              <span>{{ section.settings.occ_other_label }}</span>
              <input type="text" name="occasion_other" maxlength="70" autocomplete="off"
                     placeholder="{{ section.settings.occ_other_ph | escape }}">
            </label>
          {%- endif -%}
        </fieldset>
      </section>

      {%- comment -%} 2. le son {%- endcomment -%}
      <section class="cs-flow-step" data-step="2" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s2_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s2_sub }}</p>

        <fieldset class="cs-flow-fs">
          <legend>{{ section.settings.s2_genre }}</legend>
          <div class="cs-flow-radios">
            {%- for g in gen -%}{%- assign v = g | strip -%}{%- if v != blank -%}
              <label class="cs-flow-radio"><input type="radio" name="genre" value="{{ v | escape }}"><span>{{ v }}</span></label>
            {%- endif -%}{%- endfor -%}
          </div>
        </fieldset>

        <fieldset class="cs-flow-fs">
          <legend>{{ section.settings.s2_voice }}</legend>
          {%- if section.settings.s2_voice_note != blank -%}<p class="cs-flow-note">{{ section.settings.s2_voice_note }}</p>{%- endif -%}
          <div class="cs-flow-radios">
            {%- for v2 in voi -%}{%- assign v = v2 | strip -%}{%- if v != blank -%}
              <label class="cs-flow-radio"><input type="radio" name="voice" value="{{ v | escape }}"><span>{{ v }}</span></label>
            {%- endif -%}{%- endfor -%}
          </div>
        </fieldset>
      </section>

      {%- comment -%} 3, 4, 5 : les trois textes libres {%- endcomment -%}
      <section class="cs-flow-step" data-step="3" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s3_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s3_sub }}</p>
        <label class="cs-flow-fld"><span>{{ section.settings.s3_label }}</span>
          <textarea name="qualities" rows="5" maxlength="900" data-req placeholder="{{ section.settings.s3_ph | escape }}"></textarea></label>
      </section>

      <section class="cs-flow-step" data-step="4" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s4_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s4_sub }}</p>
        <label class="cs-flow-fld"><span>{{ section.settings.s4_label }}</span>
          <textarea name="story" rows="5" maxlength="900" data-req placeholder="{{ section.settings.s4_ph | escape }}"></textarea></label>
      </section>

      <section class="cs-flow-step" data-step="5" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s5_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s5_sub }}</p>
        <label class="cs-flow-fld"><span>{{ section.settings.s5_label }}</span>
          <textarea name="message" rows="5" maxlength="900" placeholder="{{ section.settings.s5_ph | escape }}"></textarea></label>
      </section>

      {%- comment -%}
        6. la photo. Un seul champ, un ou deux fichiers : une photo du couple,
        ou une de chacun. Les deux se valent comme reference — le modele prend
        plusieurs images en entree.

        Obligatoire, et c'est le script qui le tient : le champ perd son
        data-req des qu'une photo est gardee, pour qu'un retour en arriere ou
        un rechargement ne redemande pas un fichier deja fourni.
      {%- endcomment -%}
      <section class="cs-flow-step" data-step="6" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s6_heading }}</h1>
        <p class="cs-flow-sub">{{ section.settings.s6_sub }}</p>
        <label class="cs-flow-up">
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" multiple data-cs-photo data-req
                 data-req-msg="{{ section.settings.err_photo | default: 'Add at least one photo to continue.' | escape }}">
          <span class="cs-flow-up-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V4M8 8l4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg>
            <b data-cs-photo-label>{{ section.settings.s6_button }}</b>
            {%- if section.settings.s6_hint != blank -%}<i>{{ section.settings.s6_hint }}</i>{%- endif -%}
          </span>
        </label>
        <div class="cs-flow-up-grid" data-cs-photo-prev hidden></div>
        {%- if section.settings.s6_tips != blank -%}<p class="cs-flow-note">{{ section.settings.s6_tips }}</p>{%- endif -%}
        <label class="cs-flow-check"><input type="checkbox" name="consent" data-req
            data-req-msg="{{ section.settings.err_consent | default: 'Please tick the box so we can use your photo.' | escape }}">
          <span>{{ section.settings.s6_consent }}</span></label>
      </section>

      {%- comment -%} 7. contact {%- endcomment -%}
      <section class="cs-flow-step" data-step="7" hidden>
        <h1 class="cs-flow-h">{{ section.settings.s7_heading }}</h1>
        <p class="cs-flow-sub" data-cs-s7sub data-tpl="{{ section.settings.s7_sub | escape }}">{{ section.settings.s7_sub }}</p>
        <label class="cs-flow-fld"><span>{{ section.settings.s7_lang }}</span>
          <select name="language">
            {%- for l in lang -%}{%- assign v = l | strip -%}{%- if v != blank -%}<option>{{ v }}</option>{%- endif -%}{%- endfor -%}
          </select></label>
        <label class="cs-flow-fld"><span>{{ section.settings.s7_email }}</span>
          <input type="email" name="email" autocomplete="email" data-req data-email></label>
        <label class="cs-flow-fld"><span>{{ section.settings.s7_phone }}</span>
          <input type="tel" name="phone" autocomplete="tel"></label>
      </section>

      <p class="cs-flow-err" data-cs-err role="alert" hidden></p>

      <div class="cs-flow-actions">
        <button type="button" class="cs-btn cs-btn-primary cs-btn-lg cs-flow-next" data-cs-next>
          <span data-cs-next-label>{{ section.settings.next_label | default: 'Next' }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </form>

    {%- comment -%}
      L'ecran d'attente. Aujourd'hui il passe en une seconde et affiche l'ecran
      final. Le jour ou api_url repond une tache a suivre, c'est ici que la
      progression reelle s'affichera : la structure est deja la.
    {%- endcomment -%}
    <div class="cs-flow-wait" data-cs-wait hidden>
      <span class="cs-flow-spin" aria-hidden="true"></span>
      <h1 class="cs-flow-h">{{ section.settings.wait_heading }}</h1>
      <p class="cs-flow-sub">{{ section.settings.wait_sub }}</p>
    </div>

    {%- comment -%}
      L'ecran d'attente, sur la page du tunnel. Il apparait AU CLIC sur le
      dernier bouton, sans changement de page : c'est la suite immediate du
      dernier champ, pas un accuse de reception.

      Il ne bouge plus ensuite. La barre se remplit, et c'est seulement une
      fois pleine qu'un bouton apparait pour ouvrir la page d'apres.
    {%- endcomment -%}
    <div class="cs-flow-mk" data-cs-mk hidden>
      {%- if section.settings.mk_logo != blank -%}
        <img class="cs-flow-mk-logo" src="{{ section.settings.mk_logo | image_url: width: 600 }}"
             alt="{{ section.settings.mk_logo.alt | default: shop.name | escape }}"
             style="width:{{ section.settings.mk_logo_width }}px">
      {%- endif -%}

      {%- if section.settings.mk_heading != blank -%}
        <h1 class="cs-flow-mk-h">{{ section.settings.mk_heading }}</h1>
      {%- endif -%}
      {%- if section.settings.mk_sub != blank -%}
        <p class="cs-flow-mk-sub">{{ section.settings.mk_sub }}</p>
      {%- endif -%}

      {%- if section.settings.mk_video != blank or section.settings.mk_video_url != blank -%}
        <div class="cs-flow-mk-stage" style="aspect-ratio:{{ section.settings.mk_ratio }}">
          {%- if section.settings.mk_video != blank -%}
            {%- assign mksrc = section.settings.mk_video.sources | where: 'format', 'mp4' | first -%}
            {%- assign mkv = mksrc.url -%}
          {%- else -%}
            {%- assign mkv = section.settings.mk_video_url -%}
          {%- endif -%}
          {%- comment -%}
            preload="none" et pas de src : la video n'est chargee qu'au moment
            ou l'ecran s'affiche. Sinon chaque visiteur telecharge un clip
            qu'il ne verra qu'a la fin du tunnel, ou jamais.
          {%- endcomment -%}
          <video class="cs-flow-mk-v" data-cs-mk-src="{{ mkv | escape }}" playsinline preload="none"
                 {% if section.settings.mk_autoplay %}muted{% else %}controls{% endif %}
                 {% if section.settings.mk_poster != blank %}poster="{{ section.settings.mk_poster | image_url: width: 900 }}"{% endif %}></video>
          {%- if section.settings.mk_clock -%}
            <span class="cs-flow-mk-clock" data-cs-mk-clock aria-hidden="true">--:--</span>
          {%- endif -%}
          {%- if section.settings.mk_autoplay -%}
            <button type="button" class="cs-flow-mk-sound" data-cs-mk-sound>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
              <span>{{ section.settings.mk_sound | default: 'Tap for sound' }}</span>
            </button>
          {%- endif -%}
          {%- if section.settings.mk_caption != blank -%}
            <span class="cs-flow-mk-cap">{{ section.settings.mk_caption }}</span>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%}
          Aucun fichier charge : un cadre vide, a la bonne forme, plutot que
          rien du tout. Sans lui on ne voit pas ou deposer la video, et la page
          a l'air amputee.
        {%- endcomment -%}
        <div class="cs-flow-mk-stage cs-flow-mk-empty" style="aspect-ratio:{{ section.settings.mk_ratio }}">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg>
            {{ section.settings.mk_empty | default: 'Your video goes here — upload an MP4 in the sidebar.' }}
          </span>
        </div>
      {%- endif -%}

      <div class="cs-flow-mk-prog">
        <p class="cs-flow-mk-line">
          <span data-cs-mk-stage>{{ section.settings.mk_stages | newline_to_br | split: '<br />' | first | strip }}</span>
          <b data-cs-mk-pct>0%</b>
        </p>
        <span class="cs-flow-mk-bar"><i data-cs-mk-fill></i></span>
      </div>

      {%- if section.settings.mk_notice != blank or section.settings.mk_stay != blank -%}
        <div class="cs-flow-mk-note" data-cs-mk-note>
          {%- if section.settings.mk_notice != blank -%}<p>{{ section.settings.mk_notice }}</p>{%- endif -%}
          {%- if section.settings.mk_stay != blank -%}<strong>{{ section.settings.mk_stay }}</strong>{%- endif -%}
        </div>
      {%- endif -%}
      {%- comment -%}
        Prend la place de l'encart quand tout s'ouvre dessous : on ne change pas
        de page, donc il faut dire ou regarder.
      {%- endcomment -%}
      <p class="cs-flow-mk-ready" data-cs-mk-ready hidden>
        <span>{{ section.settings.mk_ready | default: '✓ Your preview is ready — scroll down' }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </p>

      {%- comment -%} Le bouton n'existe qu'a 100 %. {%- endcomment -%}
      <a class="cs-btn cs-btn-primary cs-btn-lg cs-flow-mk-go" data-cs-mk-go href="#" hidden>
        <span>{{ section.settings.mk_cta | default: 'Your music video preview' }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </a>

      {%- comment -%}
        Visible seulement dans l'editeur de theme, jamais pour un visiteur :
        d'ou un texte en dur, il n'a pas a etre reglable.
      {%- endcomment -%}
      <p class="cs-flow-editnote" data-cs-editnote hidden></p>
    </div>

  </div>
</div>
{% schema %}
{
  "name": "CraftStory Duo Flow",
  "settings": [
    { "type": "paragraph", "content": "The seven-screen order flow. One page load, then every screen swaps instantly. Answers go to your shop email through Shopify's own contact form — no app, no worker. Fill in the API URL below when the generation service exists and the flow posts there instead." },
    { "type": "header", "content": "Where the answers go" },
    { "type": "text", "id": "api_url", "label": "API URL", "info": "The preview generator's start address (…/functions/v1/couples/start). When it is set, the wait appears at once, the preview is made in the background, the answers still reach your shop email, and the page opens below when everything is ready. Leave empty to only send the answers by email." },

    { "type": "header", "content": "1 — Who it's for" },
    { "type": "text", "id": "s1_heading", "label": "Heading", "default": "Let's start with the basics" },
    { "type": "text", "id": "s1_sub", "label": "Subheading", "default": "Tell us about the two of you" },
    { "type": "text", "id": "s1_who", "label": "Relationship label", "default": "Who is this song for?" },
    { "type": "textarea", "id": "rel_options", "label": "Relationship options", "default": "Husband\nWife\nPartner\nFiancé\nFiancée\nBoyfriend\nGirlfriend\nThe two of us\nOther" },
    { "type": "text", "id": "s1_their", "label": "Their name label", "default": "Their first name" },
    { "type": "text", "id": "s1_your", "label": "Your name label", "default": "Your first name" },
    { "type": "text", "id": "s1_occasion", "label": "Occasion label", "default": "What's the occasion?" },
    { "type": "textarea", "id": "occ_options", "label": "Occasion options", "default": "Wedding\nAnniversary\nProposal\nFirst dance\nValentine's\nJust because\nOther" },
    { "type": "text", "id": "occ_other", "label": "Option that opens a free field", "default": "Other", "info": "Must match one of the options above, word for word. Picking it opens a text field so they can name an occasion that is not on the list. Leave empty to turn the field off." },
    { "type": "text", "id": "occ_other_label", "label": "Free field label", "default": "So what is the occasion?" },
    { "type": "text", "id": "occ_other_ph", "label": "Free field placeholder", "default": "The day you adopted the dog, six months apart, a reunion…" },

    { "type": "header", "content": "2 — The sound" },
    { "type": "text", "id": "s2_heading", "label": "Heading", "default": "Choose your sound" },
    { "type": "text", "id": "s2_sub", "label": "Subheading", "default": "The style they would actually put on" },
    { "type": "text", "id": "s2_genre", "label": "Genre label", "default": "Preferred genre" },
    { "type": "textarea", "id": "genre_options", "label": "Genre options", "default": "Pop\nCountry\nSoul / R&B\nAcoustic\nRock\nJazz\nRap / Hip-Hop" },
    { "type": "text", "id": "s2_voice", "label": "Voice label", "default": "Preferred voice" },
    { "type": "text", "id": "s2_voice_note", "label": "Voice note", "default": "A duet works beautifully when the song is about the two of you." },
    { "type": "textarea", "id": "voice_options", "label": "Voice options", "default": "Female voice\nMale voice\nDuet\nNo preference" },

    { "type": "header", "content": "3 — What makes them special" },
    { "type": "text", "id": "s3_heading", "label": "Heading", "default": "What makes them, them?" },
    { "type": "text", "id": "s3_sub", "label": "Subheading", "default": "The character and the qualities you love most" },
    { "type": "text", "id": "s3_label", "label": "Field label", "default": "Their beautiful qualities" },
    { "type": "text", "id": "s3_ph", "label": "Placeholder", "default": "The way they laugh, what they are like in the morning, the thing only you notice…" },

    { "type": "header", "content": "4 — Your story" },
    { "type": "text", "id": "s4_heading", "label": "Heading", "default": "Share your favourite memories" },
    { "type": "text", "id": "s4_sub", "label": "Subheading", "default": "How you met, and the moments you treasure most" },
    { "type": "text", "id": "s4_label", "label": "Field label", "default": "Your moments together" },
    { "type": "text", "id": "s4_ph", "label": "Placeholder", "default": "Where you met, the first trip, the hard year you got through, the running joke…" },

    { "type": "header", "content": "5 — A message from your heart" },
    { "type": "text", "id": "s5_heading", "label": "Heading", "default": "A message from your heart" },
    { "type": "text", "id": "s5_sub", "label": "Subheading", "default": "Anything else you want us to work into the song" },
    { "type": "text", "id": "s5_label", "label": "Field label", "default": "Special message" },
    { "type": "text", "id": "s5_ph", "label": "Placeholder", "default": "Names, dates, places, an inside joke — we'll do our best to include it." },

    { "type": "header", "content": "6 — The photo" },
    { "type": "paragraph", "content": "This screen is required: the faces in the music video are built from these photos. One or two files — a photo of the two of you together, or one of each of you. They are resized in the visitor's browser and posted to the API URL above." },
    { "type": "text", "id": "s6_heading", "label": "Heading", "default": "Now show us the two of you" },
    { "type": "text", "id": "s6_sub", "label": "Subheading", "default": "One photo of you together — or one of each of you. This is how your own faces end up in your music video." },
    { "type": "text", "id": "s6_button", "label": "Upload button", "default": "Add your photo" },
    { "type": "text", "id": "s6_hint", "label": "Small line inside the box", "default": "JPG or PNG — up to 2 photos" },
    { "type": "text", "id": "s6_one", "label": "Label once 1 photo is added", "default": "1 photo added — tap to change" },
    { "type": "text", "id": "s6_two", "label": "Label once 2 photos are added", "default": "2 photos added — tap to change" },
    { "type": "text", "id": "s6_tips", "label": "Tips", "default": "Faces clear and facing the camera, no sunglasses, no hats. A good photo is the whole difference." },
    { "type": "text", "id": "s6_consent", "label": "Consent line", "default": "We both agree to our photos being used to create our music video." },

    { "type": "header", "content": "7 — Contact" },
    { "type": "text", "id": "s7_heading", "label": "Heading", "default": "Almost there" },
    { "type": "text", "id": "s7_sub", "label": "Subheading — {name} becomes their first name", "default": "One step away from a song written for {name}." },
    { "type": "text", "id": "s7_lang", "label": "Language label", "default": "Song language" },
    { "type": "textarea", "id": "lang_options", "label": "Language options", "default": "English\nFrench\nSpanish\nGerman\nItalian\nPortuguese\nDutch" },
    { "type": "text", "id": "s7_email", "label": "Email label", "default": "Your email address" },
    { "type": "text", "id": "s7_phone", "label": "Phone label", "default": "Your phone number (optional)" },

    { "type": "header", "content": "Sending" },
    { "type": "text", "id": "wait_heading", "label": "Sending heading", "default": "Sending your story…" },
    { "type": "text", "id": "wait_sub", "label": "Sending subheading", "default": "One moment." },

    { "type": "header", "content": "While we make it" },
    { "type": "paragraph", "content": "This is what replaces the last question the moment they tap the final button. Same page, no reload. The screen then stays put while the bar fills, and only when it reaches 100% does a button appear to open the page below." },
    { "type": "image_picker", "id": "mk_logo", "label": "Logo or artwork" },
    { "type": "range", "id": "mk_logo_width", "label": "Its width", "min": 60, "max": 280, "step": 10, "default": 150, "unit": "px" },
    { "type": "text", "id": "mk_heading", "label": "Heading", "default": "Your words are becoming a music video." },
    { "type": "text", "id": "mk_sub", "label": "Second line", "default": "Watch this while we make it.", "info": "Shown in coral, under the heading." },
    { "type": "video", "id": "mk_video", "label": "Clip (upload MP4)" },
    { "type": "video_url", "id": "mk_video_url", "label": "Or a clip URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "mk_poster", "label": "Clip cover" },
    { "type": "select", "id": "mk_ratio", "label": "Clip shape", "default": "4/3",
      "options": [
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "4/3", "label": "Classic (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ] },
    { "type": "checkbox", "id": "mk_autoplay", "label": "Start the clip muted as soon as the screen appears", "default": true },
    { "type": "checkbox", "id": "mk_clock", "label": "Show the time left on the clip", "default": true },
    { "type": "text", "id": "mk_sound", "label": "Sound button", "default": "Tap for sound" },
    { "type": "text", "id": "mk_caption", "label": "Caption over the clip" },
    { "type": "text", "id": "mk_empty", "label": "Text while there is no clip", "default": "Your video goes here — upload an MP4 in the sidebar.", "info": "Shown in an empty frame, so the block is visible before you add a file." },
    { "type": "range", "id": "mk_minutes", "label": "How long the bar takes", "min": 1, "max": 10, "step": 1, "default": 3, "unit": "min", "info": "The page opens below when the bar is full, the clip has played to its end and the preview is ready. The bar waits at 99% if the preview needs a little longer." },
    { "type": "textarea", "id": "mk_stages", "label": "Stages", "default": "Reading your story…\nWriting your lyrics…\nRecording your song…\nAnimating your music video…\nAlmost there…", "info": "One per line. The label changes as the bar advances." },
    { "type": "text", "id": "mk_notice", "label": "Notice while it fills", "default": "⚡ Your free preview appears here at the end of the video." },
    { "type": "text", "id": "mk_stay", "label": "Warning under it, in capitals", "default": "DON'T LEAVE THIS PAGE!" },
    { "type": "text", "id": "mk_cta", "label": "Button once the bar is full", "default": "Your music video preview", "info": "Only used when nothing is placed below this section: then the button opens the page set below instead." },
    { "type": "text", "id": "mk_ready", "label": "Line once everything opens below", "default": "✓ Your preview is ready — scroll down" },
    { "type": "text", "id": "mk_after_video", "label": "Line while the clip finishes", "default": "Your preview is ready — it appears right after the video." },
    { "type": "text", "id": "mk_done", "label": "Bar label once everything is open", "default": "Your preview is ready" },
    { "type": "text", "id": "next_page", "label": "Page that button opens", "default": "/pages/couples-preview" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "next_label", "label": "Next", "default": "Next" },
    { "type": "text", "id": "last_label", "label": "Last step button", "default": "Create our song" },
    { "type": "text", "id": "back_label", "label": "Back", "default": "Back" },
    { "type": "text", "id": "err_required", "label": "Error — missing field", "default": "Please fill this in before continuing." },
    { "type": "text", "id": "err_email", "label": "Error — bad email", "default": "That email address does not look right." },
    { "type": "text", "id": "err_send", "label": "Error — send failed", "default": "We could not send that. Check your connection and try again." },
    { "type": "text", "id": "err_photo", "label": "Error — no photo", "default": "Add at least one photo to continue." },
    { "type": "text", "id": "err_consent", "label": "Error — consent not ticked", "default": "Please tick the box so we can use your photo." },
    { "type": "text", "id": "err_photo_max", "label": "Notice — more than two photos", "default": "Two photos is the maximum — we kept the first two." }
  ],
  "presets": [ { "name": "CraftStory Duo Flow" } ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-flow{background:var(--cs-paper);min-height:100vh;min-height:100dvh;display:flex;align-items:flex-start;justify-content:center}
/* L'attribut hidden doit gagner. Les regles d'ici posent display:flex sur des
   elements que le script masque (la barre du haut, le bouton Retour), et une
   regle d'auteur bat toujours le display:none de la feuille du navigateur :
   sans cette ligne, Retour s'affiche des le premier ecran et la barre de
   progression reste par-dessus l'ecran final. */
.cs-duo-flow [hidden]{display:none !important}
.cs-flow-wrap{width:100%;max-width:640px;padding:clamp(18px,4vw,40px) 22px clamp(40px,8vw,72px)}
.cs-flow-top{display:flex;flex-direction:column;gap:14px;margin-bottom:clamp(22px,4vw,34px)}
.cs-flow-back{align-self:flex-start;display:inline-flex;align-items:center;gap:5px;background:none;border:0;padding:4px 0;
  font:inherit;font-size:.92rem;font-weight:600;color:var(--cs-ink2);cursor:pointer}
.cs-flow-back svg{width:17px;height:17px}
.cs-flow-back:hover{color:var(--cs-ink)}
.cs-flow-prog{height:4px;border-radius:var(--cs-pill);background:var(--cs-line);overflow:hidden}
.cs-flow-prog i{display:block;height:100%;width:0;border-radius:var(--cs-pill);background:var(--cs-coral);transition:width .34s cubic-bezier(.2,.75,.3,1)}

/* L'echange d'ecran : court, sinon ca ne donne plus l'impression d'etre instantane. */
.cs-flow-step{animation:cs-flow-in .22s ease both}
@keyframes cs-flow-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.cs-flow-h{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.6rem,5.4vw,2.3rem);line-height:1.12;
  letter-spacing:-.015em;text-align:center;color:var(--cs-ink);margin:0}
.cs-flow-sub{text-align:center;color:var(--cs-ink2);font-size:1rem;line-height:1.5;margin:10px 0 clamp(22px,4vw,30px)}
.cs-flow-fs{border:0;padding:0;margin:0 0 clamp(20px,3.4vw,26px)}
.cs-flow-fs legend{padding:0;font-weight:700;font-size:.94rem;color:var(--cs-ink);margin-bottom:9px}
.cs-flow-note{font-size:.86rem;color:var(--cs-ink3);line-height:1.45;margin:-3px 0 9px}
/* Deux colonnes des que la place le permet : empilees, les neuf choix du
   premier ecran font defiler sur deux hauteurs de telephone avant meme le
   premier champ. */
.cs-flow-radios{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:8px}
.cs-flow-radio{display:flex;align-items:center;gap:9px;padding:13px 14px;min-width:0;border-radius:var(--cs-r);cursor:pointer;
  background:var(--cs-card);border:1.5px solid var(--cs-line);font-weight:600;font-size:.94rem;line-height:1.25;
  transition:border-color .15s ease,background .15s ease}
.cs-flow-radio:hover{border-color:var(--cs-ink3)}
.cs-flow-radio input{appearance:none;width:19px;height:19px;flex:0 0 19px;margin:0;border-radius:50%;
  border:2px solid var(--cs-line);background:var(--cs-card);cursor:pointer;transition:border-color .15s ease}
.cs-flow-radio:has(input:checked){background:var(--cs-coral);border-color:var(--cs-coral);color:#fff}
.cs-flow-radio:has(input:checked) input{border-color:#fff;box-shadow:inset 0 0 0 4px var(--cs-coral);background:#fff}
.cs-flow-two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:clamp(20px,3.4vw,26px)}
@media(max-width:520px){.cs-flow-two{grid-template-columns:1fr}}
.cs-flow-fld{display:block;margin-bottom:clamp(18px,3vw,24px)}
.cs-flow-fld > span{display:block;font-weight:700;font-size:.94rem;color:var(--cs-ink);margin-bottom:7px}
.cs-flow-fld input,.cs-flow-fld select,.cs-flow-fld textarea{
  width:100%;font:inherit;font-size:1rem;color:var(--cs-ink);background:var(--cs-card);
  border:1.5px solid var(--cs-line);border-radius:var(--cs-r);padding:13px 15px;
  transition:border-color .15s ease,box-shadow .15s ease}
.cs-flow-fld textarea{resize:vertical;line-height:1.5;min-height:118px}
.cs-flow-fld input:focus,.cs-flow-fld select:focus,.cs-flow-fld textarea:focus{
  outline:0;border-color:var(--cs-coral);box-shadow:0 0 0 3px rgba(236,91,60,.16)}
.cs-flow-fld ::placeholder{color:var(--cs-ink3)}
.cs-flow-more{margin:10px 0 0}
.cs-flow-editnote{max-width:34em;margin:18px auto 0;padding:11px 14px;border-radius:var(--cs-r);
  background:rgba(244,201,93,.18);border:1px solid rgba(244,201,93,.55);
  color:var(--cs-ink2);font-size:.86rem;line-height:1.45;text-align:left}
.cs-flow-up{display:block;cursor:pointer;margin-bottom:14px}
/* Pas opacity:0 sur 0x0 : le champ ne prend plus le focus et le clavier perd
   l'etape. Un pixel garde, decoupe a zero, reste focalisable. */
.cs-flow-up input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.cs-flow-up-box{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;
  padding:clamp(28px,6vw,44px);border:2px dashed var(--cs-line);border-radius:var(--cs-r-lg);
  background:var(--cs-card);color:var(--cs-ink2);transition:border-color .15s ease,box-shadow .15s ease}
.cs-flow-up:hover .cs-flow-up-box{border-color:var(--cs-coral)}
.cs-flow-up:has(input:focus-visible) .cs-flow-up-box{border-color:var(--cs-coral);
  box-shadow:0 0 0 3px rgba(236,91,60,.16)}
.cs-flow-up-box svg{width:30px;height:30px}
.cs-flow-up-box i{font-style:normal;font-size:.82rem;color:var(--cs-ink3)}
/* Une photo : elle prend toute la largeur. Deux : cote a cote, meme hauteur. */
.cs-duo-flow .cs-flow-up-grid{display:grid;grid-template-columns:1fr;gap:9px;margin:0 0 14px}
.cs-duo-flow .cs-flow-up-grid[data-n="2"]{grid-template-columns:1fr 1fr}
.cs-flow-up-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;
  border-radius:var(--cs-r-lg);border:1px solid var(--cs-line)}
.cs-flow-check{display:flex;gap:10px;align-items:flex-start;font-size:.88rem;line-height:1.45;color:var(--cs-ink2);cursor:pointer}
.cs-flow-check input{width:19px;height:19px;flex:0 0 19px;margin:1px 0 0;accent-color:var(--cs-coral);cursor:pointer}
.cs-flow-err{margin:0 0 14px;padding:11px 14px;border-radius:var(--cs-r);background:rgba(236,91,60,.1);
  border:1px solid rgba(236,91,60,.34);color:var(--cs-coral-deep);font-size:.9rem;font-weight:600}
.cs-flow-actions{margin-top:clamp(8px,2vw,14px)}
.cs-flow-next{width:100%;white-space:nowrap}
.cs-flow-next svg{width:19px;height:19px;transition:transform .18s ease}
.cs-flow-next:hover svg{transform:translateX(3px)}
.cs-flow-next[disabled]{opacity:.6;pointer-events:none}
.cs-flow-wait{text-align:center;padding:clamp(40px,10vw,80px) 0;animation:cs-flow-in .24s ease both}
.cs-flow-spin{display:inline-block;width:34px;height:34px;border-radius:50%;margin-bottom:20px;
  border:3px solid var(--cs-line);border-top-color:var(--cs-coral);animation:cs-flow-spin .8s linear infinite}
@keyframes cs-flow-spin{to{transform:rotate(360deg)}}
.cs-flow-tick{display:grid;place-items:center;width:58px;height:58px;border-radius:50%;margin:0 auto 20px;
  background:var(--cs-coral);color:#fff}
.cs-flow-tick svg{width:29px;height:29px}

/* L'ecran d'attente : la suite immediate du dernier champ. */
.cs-flow-mk{text-align:center;padding:clamp(6px,2vw,14px) 0 clamp(20px,4vw,32px);
  animation:cs-flow-in .26s ease both}
.cs-flow-mk-logo{display:block;height:auto;margin:0 auto 16px}
.cs-flow-mk-h{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.35rem,4.6vw,1.9rem);
  line-height:1.15;letter-spacing:-.015em;color:var(--cs-ink);margin:0}
/* La seconde ligne est coraille : c'est elle qui tient le regard pendant
   l'attente, pas le titre. */
.cs-flow-mk-sub{color:var(--cs-coral);font-weight:700;font-size:1rem;line-height:1.4;margin:8px 0 24px}
.cs-flow-mk-stage{position:relative;border-radius:var(--cs-r-lg);overflow:hidden;
  background:var(--cs-night);aspect-ratio:4/3;box-shadow:0 14px 34px rgba(28,21,51,.16)}
.cs-flow-mk-v{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-flow-mk-clock{position:absolute;top:10px;left:10px;padding:4px 9px;border-radius:var(--cs-pill);
  background:rgba(28,21,51,.72);color:#fff;font-size:.8rem;font-weight:700;font-variant-numeric:tabular-nums}
/* En haut a droite, jamais en bas : le bas appartient a la legende. */
.cs-flow-mk-sound{position:absolute;top:10px;right:10px;display:inline-flex;align-items:center;gap:5px;
  padding:5px 10px;border:0;border-radius:var(--cs-pill);cursor:pointer;
  background:rgba(28,21,51,.72);color:#fff;font:inherit;font-size:.76rem;font-weight:700}
.cs-flow-mk-sound:hover{background:rgba(28,21,51,.88)}
.cs-flow-mk-sound svg{width:14px;height:14px}
.cs-flow-mk-cap{position:absolute;left:10px;right:10px;bottom:10px;text-align:center;font-weight:800;
  font-size:.86rem;letter-spacing:.02em;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.6)}
.cs-flow-mk-prog{margin-top:20px;padding:14px 16px;border-radius:var(--cs-r);
  background:var(--cs-card);border:1px solid var(--cs-line);text-align:left}
.cs-flow-mk-line{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 0 8px}
.cs-flow-mk-line span{font-size:.86rem;color:var(--cs-ink2);line-height:1.35}
.cs-flow-mk-line b{flex:0 0 auto;font-size:.86rem;font-weight:800;color:var(--cs-coral);
  font-variant-numeric:tabular-nums}
.cs-flow-mk-bar{display:block;height:7px;border-radius:var(--cs-pill);background:var(--cs-line);overflow:hidden}
.cs-flow-mk-bar i{display:block;height:100%;width:0;border-radius:var(--cs-pill);
  background:linear-gradient(90deg,var(--cs-coral),var(--cs-coral-deep));transition:width .5s linear}
.cs-flow-mk-note{margin:18px 0 0;padding:14px 16px;border-radius:var(--cs-r);text-align:left;
  background:rgba(236,91,60,.09);border:1px solid rgba(236,91,60,.26);
  color:var(--cs-coral-deep);font-size:.87rem;font-weight:600;line-height:1.45}
.cs-flow-mk-note p{margin:0}
/* L'avertissement doit se lire d'un coup d'oeil : c'est lui qui evite qu'on
   quitte la page pendant que la barre tourne. */
.cs-flow-mk-note strong{display:block;margin-top:10px;font-size:1.02rem;font-weight:800;
  letter-spacing:.04em;line-height:1.25;text-transform:uppercase;color:var(--cs-coral-deep)}
.cs-flow-mk-note p + strong{padding-top:10px;border-top:1px solid rgba(236,91,60,.24)}
/* Leur photo dans le cadre, quand aucun clip n'est charge */
.cs-flow-mk-mine{background:var(--cs-night)}
.cs-flow-mk-ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;
  opacity:.72;filter:saturate(.92)}
.cs-flow-mk-mine::after{content:"";position:absolute;inset:0;
  background:radial-gradient(120% 90% at 50% 40%,transparent 30%,rgba(28,21,51,.55) 100%)}
/* Le cadre vide */
.cs-flow-mk-empty{display:grid;place-items:center;background:var(--cs-paper2);
  border:2px dashed var(--cs-line);box-shadow:none}
.cs-flow-mk-empty span{display:flex;flex-direction:column;align-items:center;gap:9px;
  padding:0 20px;text-align:center;color:var(--cs-ink3);font-size:.88rem;line-height:1.45}
.cs-flow-mk-empty svg{width:34px;height:34px}
/* Quand tout s'ouvre dessous : on ne change pas de page, donc on dit ou regarder. */
.cs-duo-flow .cs-flow-mk-ready{display:flex;align-items:center;justify-content:center;gap:9px;
  margin:20px 0 0;padding:14px 16px;border-radius:var(--cs-r-lg);background:rgba(236,91,60,.1);
  border:1px solid rgba(236,91,60,.34);color:var(--cs-coral-deep);font-size:1rem;font-weight:800;
  line-height:1.3;text-align:center;animation:cs-flow-in .3s ease both}
.cs-flow-mk-ready svg{width:20px;height:20px;flex:0 0 20px;animation:cs-flow-nudge 1.4s ease-in-out infinite}
@keyframes cs-flow-nudge{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}
.cs-flow-mk-go{width:100%;margin-top:20px;white-space:nowrap;animation:cs-flow-in .3s ease both}
.cs-flow-mk-go svg{width:19px;height:19px;transition:transform .18s ease}
.cs-flow-mk-go:hover svg{transform:translateX(3px)}
@media(prefers-reduced-motion:reduce){
  .cs-flow-step,.cs-flow-wait,.cs-flow-mk,.cs-flow-mk-go,.cs-duo-flow .cs-flow-mk-ready,
  .cs-flow-mk-ready svg{animation:none}}

/* ATTENTION, piege du theme : cs-head pose .cs p{margin:0}, de specificite
   0,1,1. Une classe seule sur un paragraphe vaut 0,1,0 et PERD, quel que soit
   l'ordre des feuilles. Toute marge de <p> doit donc s'ecrire avec la racine de
   la section devant. Sans ca les marges ci-dessus ne s'appliquent pas du tout,
   et on croit avoir regle un rythme vertical qui n'existe pas. */
.cs-duo-flow .cs-flow-sub{margin:10px 0 clamp(22px,4vw,30px)}
.cs-duo-flow .cs-flow-note{margin:-3px 0 9px}
.cs-duo-flow .cs-flow-err{margin:0 0 14px}
.cs-duo-flow .cs-flow-mk-sub{margin:8px 0 24px}
.cs-duo-flow .cs-flow-mk-line{margin:0 0 8px}
.cs-duo-flow .cs-flow-editnote{margin:18px auto 0}
{% endstylesheet %}
{% javascript %}
(function () {
  var STORE = 'csDuoFlow';
  // Les photos sont gardees a part : elles pesent, et la page d'apres n'a pas
  // besoin de les relire pour composer ses titres.
  var PHSTORE = 'csDuoPhotos';
  var MAXPH = 2;
  var PHMAX = 1280;

  // Reduite dans le navigateur, puis en dataURL. Deux raisons, dans cet ordre :
  //   - c'est exactement ce que le worker des enfants recoit deja (un dataURL
  //     dans du JSON), donc rien a ecrire de son cote ;
  //   - un telephone sort des fichiers de 4 Mo. 1280 px suffisent au modele,
  //     et l'envoi passe sur un reseau de gare.
  function shrink(file, cb) {
    var url = URL.createObjectURL(file);
    var img = new Image();
    img.onload = function () {
      var k = Math.min(1, PHMAX / Math.max(img.width, img.height));
      var c = document.createElement('canvas');
      c.width = Math.max(1, Math.round(img.width * k));
      c.height = Math.max(1, Math.round(img.height * k));
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      URL.revokeObjectURL(url);
      var out = '';
      try { out = c.toDataURL('image/jpeg', 0.82); } catch (e) {}
      cb(out);
    };
    img.onerror = function () { URL.revokeObjectURL(url); cb(''); };
    img.src = url;
  }

  function setup(root) {
    if (root.dataset.csFlowReady) return;
    root.dataset.csFlowReady = '1';

    var form = root.querySelector('[data-cs-form]');
    var steps = root.querySelectorAll('.cs-flow-step');
    var bar = root.querySelector('[data-cs-bar]');
    var back = root.querySelector('[data-cs-back]');
    var next = root.querySelector('[data-cs-next]');
    var nextLabel = root.querySelector('[data-cs-next-label]');
    var err = root.querySelector('[data-cs-err]');
    var wait = root.querySelector('[data-cs-wait]');
    var mk = root.querySelector('[data-cs-mk]');
    if (!form || !steps.length) return;

    // Les libelles viennent des attributs poses par Liquid : un bloc javascript
    // est mutualise entre toutes les sections, il ne peut pas les interpoler.
    var D = root.dataset;
    var CFG = {
      nextLabel: D.next || 'Next',
      lastLabel: D.last || 'Create our song',
      errRequired: D.errReq || 'Please fill this in before continuing.',
      errEmail: D.errEmail || 'That email address does not look right.',
      errSend: D.errSend || 'We could not send that. Check your connection and try again.'
    };
    var last = steps.length - 1;
    var i = 0;

    // Relues au chargement : un retour en arriere, un rechargement ou le
    // retour du POST natif ne doivent pas redemander un fichier deja donne.
    var shots = [];
    try {
      var kept = JSON.parse(window.sessionStorage.getItem(PHSTORE) || '[]');
      if (kept && kept.length) shots = kept.slice(0, MAXPH);
    } catch (e) {}

    function fill(el, map) {
      if (!el) return;
      var tpl = el.getAttribute('data-tpl') || el.textContent;
      var out = tpl;
      for (var k in map) out = out.split('{' + k + '}').join(map[k] || '');
      el.textContent = out;
    }

    function show(n) {
      for (var s = 0; s < steps.length; s++) steps[s].hidden = s !== n;
      // On re-declenche l'animation : sans ca, un ecran deja vu reapparait sec.
      steps[n].style.animation = 'none';
      void steps[n].offsetWidth;
      steps[n].style.animation = '';

      i = n;
      bar.style.width = ((n + 1) / steps.length * 100) + '%';
      back.hidden = n === 0;
      nextLabel.textContent = n === last ? CFG.lastLabel : CFG.nextLabel;
      err.hidden = true;

      if (n === last) {
        var name = (form.elements.their_name && form.elements.their_name.value || '').trim();
        fill(root.querySelector('[data-cs-s7sub]'), { name: name });
      }
      // Le haut de l'ecran, pas le haut du document : la barre reste visible.
      var top = root.getBoundingClientRect().top + window.pageYOffset - 12;
      if (window.pageYOffset > top) window.scrollTo({ top: top, behavior: 'smooth' });
      var first = steps[n].querySelector('input:not([type=radio]):not([type=checkbox]), textarea, select');
      if (first && window.matchMedia('(min-width:750px)').matches) first.focus();
    }

    function fail(field, msg) {
      err.textContent = msg;
      err.hidden = false;
      if (field && field.focus) field.focus();
      return false;
    }

    function valid(n) {
      var step = steps[n];
      var reqs = step.querySelectorAll('[data-req]');
      for (var r = 0; r < reqs.length; r++) {
        var f = reqs[r];
        if (f.type === 'checkbox' ? !f.checked : !f.value.trim()) {
          // Un message par champ quand il y en a un : « remplis ce champ » ne
          // veut rien dire devant une case a cocher ou un depot de photo.
          return fail(f, f.getAttribute('data-req-msg') || CFG.errRequired);
        }
        if (f.hasAttribute('data-email') && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(f.value.trim())) {
          return fail(f, CFG.errEmail);
        }
      }
      // Un groupe de radios n'a pas de champ requis : on verifie le groupe.
      var groups = {};
      var radios = step.querySelectorAll('input[type=radio]');
      for (var g = 0; g < radios.length; g++) groups[radios[g].name] = groups[radios[g].name] || radios[g];
      for (var key in groups) {
        if (!step.querySelector('input[name="' + key + '"]:checked')) {
          return fail(groups[key], CFG.errRequired);
        }
      }
      return true;
    }

    function answers() {
      var out = {};
      var f = form.elements;
      for (var n = 0; n < f.length; n++) {
        var el = f[n];
        if (!el.name || el.type === 'file') continue;
        if ((el.type === 'radio' || el.type === 'checkbox') && !el.checked) continue;
        var v = el.type === 'checkbox' ? 'Yes' : el.value.trim();
        // Un champ vide n'a rien a faire dans le message : le telephone est
        // facultatif, et la precision d'occasion ne sert que si elle est la.
        if (v === '') continue;
        out[el.name] = v;
      }
      return out;
    }

    // Sans endpoint, les reponses partent par le formulaire de contact natif de
    // Shopify : elles arrivent dans la boite mail de la boutique, sans worker
    // ni application.
    //
    // Et c'est un VRAI envoi de formulaire, pas un fetch. Deux raisons, dans
    // cet ordre :
    //   - un fetch peut repondre 200 alors que Shopify a servi une page de
    //     captcha : rien n'est parti, et on annoncerait quand meme au client
    //     que son histoire est envoyee. Ici c'est Shopify qui tranche, et il
    //     ne renvoie sur ?contact_posted=true qu'en cas de reussite reelle.
    //   - si un captcha est demande, le visiteur le voit et peut le resoudre.
    // Ca coute un rechargement au tout dernier clic. On relit le parametre au
    // chargement pour retomber directement sur l'ecran final.
    function niceKey(k) {
      return k.charAt(0).toUpperCase() + k.slice(1).replace(/_/g, ' ');
    }

    // Tout est mis de cote, pas seulement le prenom : la page d'apres compose
    // ses titres avec le genre, la relation et l'occasion. Ca reste dans
    // l'onglet du visiteur, rien ne part ailleurs, et ca meurt avec l'onglet.
    // Gardees des le depot, pas seulement a l'envoi : un rechargement au
    // milieu du tunnel ne doit pas redemander un fichier deja donne.
    // Le quota peut refuser deux photos ; ce n'est pas bloquant, elles partent
    // quand meme avec l'envoi. On n'annule rien pour ca.
    function keepShots() {
      try {
        if (shots.length) window.sessionStorage.setItem(PHSTORE, JSON.stringify(shots));
      } catch (e) {}
    }

    function stash(data) {
      try { window.sessionStorage.setItem(STORE, JSON.stringify(data)); } catch (e) {}
      keepShots();
    }

    // Le message qui arrive dans la boite mail de la boutique. Le meme dans
    // les deux chemins, a une ligne pres : ou sont passees les photos.
    function leadFields(data, viaApi) {
      var lines = [];
      for (var k in data) if (k !== 'email') lines.push(niceKey(k) + ': ' + data[k]);
      var body = 'COUPLES SONG REQUEST\n\n' + lines.join('\n');
      // Le formulaire de contact de Shopify ne sait pas porter de fichier. On
      // ne fait pas semblant : le message dit ou sont les photos.
      if (shots.length && viaApi) {
        body += '\n\nPhotos: ' + shots.length + ' sent to the preview generator. If they buy,'
          + ' the song, the six scenes and the photo links are attached to their order.';
      } else if (shots.length) {
        body += '\n\nPhotos: ' + shots.length + ' added by the visitor, but a Shopify'
          + ' contact form cannot carry files, so they stayed in their browser.'
          + ' Fill in the API URL of the flow section to receive them.';
      }
      return {
        form_type: 'contact',
        utf8: '✓',
        'contact[email]': data.email || '',
        'contact[name]': (data.your_name || '') + ' & ' + (data.their_name || ''),
        'contact[body]': body
      };
    }

    // Avec la generation branchee, le message part SANS quitter la page : un
    // rechargement ici couperait l'attente et la video. C'est le meme envoi
    // que le formulaire natif, par fetch ; et on sait s'il est passe, parce
    // que Shopify ne renvoie sur ?contact_posted=true qu'en cas de reussite.
    function sendLead(data) {
      var q = new URLSearchParams();
      var fields = leadFields(data, true);
      for (var key in fields) q.append(key, fields[key]);
      return fetch('/contact', { method: 'POST', body: q, credentials: 'same-origin' })
        .then(function (r) {
          root.setAttribute('data-lead', String(r.url || '').indexOf('contact_posted=true') > -1 ? 'sent' : 'held');
        })
        .catch(function () { root.setAttribute('data-lead', 'failed'); });
    }

    function sendNative(data) {
      stash(data);
      var fields = leadFields(data, false);

      var f = document.createElement('form');
      f.method = 'post';
      f.action = '/contact#contact_form';
      f.hidden = true;
      for (var key in fields) {
        var h = document.createElement('input');
        h.type = 'hidden';
        h.name = key;
        h.value = fields[key];
        f.appendChild(h);
      }
      document.body.appendChild(f);
      f.submit();
    }

    // Un seul POST, un seul JSON : les reponses et les photos deja reduites en
    // dataURL. Pas de multipart — le worker des enfants lit deja ce format-la.
    function sendApi(url, data) {
      var out = {};
      for (var k in data) out[k] = data[k];
      if (shots[0]) out.photo = shots[0];
      if (shots[1]) out.photo2 = shots[1];
      out.photo_count = shots.length;
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(out)
      });
    }

    // Le corps de la reponse, sans jamais faire echouer l'envoi pour ca. Un
    // 204, un corps vide ou du texte au lieu du JSON ne doivent pas afficher
    // « nous n'avons pas pu envoyer » a quelqu'un dont l'histoire est partie.
    function body(r) {
      try {
        if (!r || typeof r.json !== 'function') return Promise.resolve(null);
        return r.json().catch(function () { return null; });
      } catch (e) { return Promise.resolve(null); }
    }

    // ----------------------------------------------------------------------
    // L'ATTENTE, ET CE QUI S'OUVRE DESSOUS
    //
    // L'attente prend la place du dernier champ, sur la meme page, au clic :
    // c'est la suite immediate du formulaire, pas un accuse de reception.
    //
    // Trois conditions, et les trois doivent etre vraies pour que tout ce qui
    // est pose sous le tunnel s'ouvre — la preview, l'offre, les avis :
    //   bar      la barre a fait ses trois minutes ;
    //   video    le clip d'attente est alle au bout. Un clip que le telephone
    //            refuse de lancer (economie d'energie, lecture automatique
    //            bloquee) ne bloque jamais personne ;
    //   preview  la generation a rendu sa chanson et ses six images — ou a
    //            echoue pour de bon, et on ouvre quand meme, avec un message.
    //
    // Aucun changement de page. Sans section dessous, on retombe sur l'ancien
    // bouton qui ouvre la page d'apres.
    // ----------------------------------------------------------------------
    var MKEND = 'csDuoMakeAt';
    var JOB = 'csDuoJob';
    var TAKE = 'csDuoTake';
    var OPENED = 'csDuoOpen';
    var gate = { bar: false, video: false, preview: false, failed: false, open: false };
    var onCheck = null;

    function below() {
      var box = root.closest('.shopify-section');
      if (!box) return false;
      for (var s2 = box.nextElementSibling; s2; s2 = s2.nextElementSibling) {
        if (s2.classList && s2.classList.contains('shopify-section')) return true;
      }
      return false;
    }

    function readJob() {
      try { return JSON.parse(window.sessionStorage.getItem(JOB) || 'null'); } catch (e) { return null; }
    }
    function saveJob(j) {
      try { window.sessionStorage.setItem(JOB, JSON.stringify(j)); } catch (e) {}
    }
    function haveTake() {
      try {
        var t = JSON.parse(window.sessionStorage.getItem(TAKE) || 'null');
        return !!(t && t.beats && t.beats.length);
      } catch (e) { return false; }
    }

    // La preview est la (ou ne viendra pas). La section du dessous ecoute
    // l'evenement et monte ses six images tout de suite, avant meme d'etre
    // visible : quand la page s'ouvre, tout est deja pret a jouer.
    function previewDone(take, failed) {
      if (take) {
        try { window.sessionStorage.setItem(TAKE, JSON.stringify(take)); } catch (e) {}
      }
      if (failed) gate.failed = true;
      try {
        document.dispatchEvent(new CustomEvent('cs:duo:take', { detail: take || { failed: true } }));
      } catch (e) {}
      gate.preview = true;
      if (onCheck) onCheck();
    }

    function statusFrom(url) {
      return String(url || '').replace(/\/start\/?(\?.*)?$/, '/status');
    }

    var pollErrors = 0;
    var pollStart = 0;
    function poll() {
      var j = readJob();
      if (!j || !j.job) { previewDone(null, true); return; }
      if (!pollStart) pollStart = Date.now();
      // Au-dela de dix minutes on n'attend plus : l'API a rendu son verdict
      // bien avant.
      if (Date.now() - pollStart > 600000) { previewDone(null, true); return; }
      fetch(j.status || statusFrom(root.getAttribute('data-api')), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ job: j.job })
      }).then(function (r) { return body(r); }).then(function (out) {
        if (!out) throw new Error('empty');
        pollErrors = 0;
        if (out.job && out.job !== j.job) { j.job = out.job; saveJob(j); }
        if (out.ready && out.beats && out.beats.length) { previewDone(out, false); return; }
        if (out.failed) { previewDone(null, true); return; }
        setTimeout(poll, 5000);
      }).catch(function () {
        // Un reseau qui tousse ne tue pas la preview : on insiste, plus
        // lentement, avant d'abandonner.
        pollErrors += 1;
        if (pollErrors > 12) { previewDone(null, true); return; }
        setTimeout(poll, 8000);
      });
    }

    function startJob(url, data) {
      sendApi(url, data).then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return body(r);
      }).then(function (out) {
        if (out && out.beats && out.beats.length) { previewDone(out, false); return; }
        if (!out || !out.job) throw new Error('no job');
        saveJob({ job: out.job, status: out.status || statusFrom(url) });
        setTimeout(poll, 5000);
      }).catch(function () {
        previewDone(null, true);
      });
    }

    function finish(who) {
      form.hidden = true;
      root.querySelector('.cs-flow-top').hidden = true;
      wait.hidden = true;
      if (!mk) return;
      mk.hidden = false;

      // La video n'est chargee qu'ici : inutile de la faire telecharger a
      // quelqu'un qui abandonnera au deuxieme ecran.
      var v = mk.querySelector('.cs-flow-mk-v');
      if (v && !v.src) {
        var src = v.getAttribute('data-cs-mk-src');
        if (src) {
          v.src = src;
          if (v.muted) { var pp = v.play(); if (pp && pp.catch) pp.catch(function () {}); }
        }
      }

      // Aucun clip charge, mais leur photo est la : elle prend le cadre. C'est
      // leur attente, pas un rectangle vide, et ca leur prouve d'un coup d'oeil
      // que la photo est bien partie avec le reste.
      var slot = mk.querySelector('.cs-flow-mk-empty');
      if (slot && shots[0]) {
        slot.classList.remove('cs-flow-mk-empty');
        slot.classList.add('cs-flow-mk-mine');
        slot.textContent = '';
        var ph = document.createElement('img');
        ph.className = 'cs-flow-mk-ph';
        ph.alt = '';
        ph.src = shots[0];
        slot.appendChild(ph);
      }

      var mins = parseFloat(root.getAttribute('data-mk-min') || '3') || 3;
      var fillBar = mk.querySelector('[data-cs-mk-fill]');
      var pctEl = mk.querySelector('[data-cs-mk-pct]');
      var stageEl = mk.querySelector('[data-cs-mk-stage]');
      var clockEl = mk.querySelector('[data-cs-mk-clock]');
      var noteEl = mk.querySelector('[data-cs-mk-note]');
      var readyEl = mk.querySelector('[data-cs-mk-ready]');
      var go = mk.querySelector('[data-cs-mk-go]');
      var afterVideo = D.mkAfter || '';

      var stages = [];
      var raw = (root.getAttribute('data-mk-stages') || '').split('|');
      for (var n = 0; n < raw.length; n++) { if (raw[n].trim()) stages.push(raw[n].trim()); }

      // L'echeance est posee une seule fois et gardee : un rechargement ne la
      // fait pas repartir, et une attente finie reste finie.
      var end = 0;
      try {
        end = parseInt(window.localStorage.getItem(MKEND) || '0', 10);
        if (!end || isNaN(end)) {
          end = Date.now() + mins * 60000;
          window.localStorage.setItem(MKEND, String(end));
        }
      } catch (e) { end = Date.now() + mins * 60000; }

      // Le clip : fini, ou impossible a lire.
      var hasClip = !!(v && v.getAttribute('data-cs-mk-src'));
      if (!hasClip) gate.video = true;
      if (hasClip) {
        v.addEventListener('ended', function () {
          gate.video = true;
          // Vu en entier : il repart en boucle, sans le son, pour que l'ecran
          // ne se fige pas si la preview tarde encore un peu.
          v.muted = true;
          v.loop = true;
          var p2 = v.play();
          if (p2 && p2.catch) p2.catch(function () {});
          check();
        });
        v.addEventListener('error', function () { gate.video = true; check(); });
      }
      function videoStuck() {
        return hasClip && v.paused && !v.ended && v.currentTime < 0.5;
      }

      function ready() {
        if (!go) return;
        var base = (root.getAttribute('data-next-page') || '').trim();
        if (!base) return;
        var q = who.name ? '?name=' + encodeURIComponent(who.name) : '';
        if (q && base.indexOf('?') > -1) q = '&' + q.slice(1);
        go.setAttribute('href', base + q);
        go.hidden = false;
        if (noteEl) noteEl.hidden = true;
      }

      function open() {
        if (gate.open) return;
        gate.open = true;
        try { window.sessionStorage.setItem(OPENED, '1'); } catch (e) {}
        if (!below()) { ready(); return; }
        document.documentElement.setAttribute('data-cs-duo-gate', 'open');
        if (noteEl) noteEl.hidden = true;
        if (readyEl) readyEl.hidden = false;
        paint();
        try { document.dispatchEvent(new CustomEvent('cs:duo:open')); } catch (e) {}
      }

      function paint() {
        var left = Math.max(0, (end - Date.now()) / 1000);
        if (left <= 0) gate.bar = true;
        var p = Math.max(0, Math.min(100, (1 - left / (mins * 60)) * 100));
        // Elle ne dit pas 100 % tant que la preview n'est pas la : elle attend
        // a 99, sur la derniere etape.
        if (!gate.preview) p = Math.min(p, 99);
        if (fillBar) fillBar.style.width = p + '%';
        if (pctEl) pctEl.textContent = Math.floor(p) + '%';
        if (clockEl) {
          // Arrondir les secondes AVANT de decouper : arrondir le reste donnait
          // « 04:60 » quand il restait 4 min 59,7 s.
          var whole = Math.round(left);
          clockEl.textContent = ('0' + Math.floor(whole / 60)).slice(-2) + ':'
            + ('0' + (whole % 60)).slice(-2);
        }
        if (stageEl) {
          var label = '';
          if (gate.open && D.mkDone) {
            label = D.mkDone;
          } else if (gate.bar && gate.preview && !gate.video && !videoStuck() && afterVideo) {
            label = afterVideo;
          } else if (stages.length) {
            label = stages[Math.min(stages.length - 1, Math.floor(p / (100 / stages.length)))];
          }
          if (label && stageEl.textContent !== label) stageEl.textContent = label;
        }
      }

      function check() {
        paint();
        if (gate.bar && gate.preview && (gate.video || videoStuck())) open();
      }
      onCheck = check;

      check();
      var tick = setInterval(function () {
        check();
        if (gate.open) clearInterval(tick);
      }, 500);

      var snd = mk.querySelector('[data-cs-mk-sound]');
      if (snd && v) {
        snd.addEventListener('click', function (e) {
          e.stopPropagation();
          v.muted = false;
          var p3 = v.play();
          if (p3 && p3.catch) p3.catch(function () {});
          snd.hidden = true;
        });
        mk.querySelector('.cs-flow-mk-stage').addEventListener('click', function () {
          if (v.paused) { var p4 = v.play(); if (p4 && p4.catch) p4.catch(function () {}); } else { v.pause(); }
        });
      }
    }

    function submit() {
      var data = answers();
      var who = { name: data.their_name, email: data.email };
      // Une nouvelle demande repart de zero : nouvelle echeance, et plus rien
      // d'une demande precedente faite dans cet onglet.
      try {
        window.localStorage.removeItem(MKEND);
        window.sessionStorage.removeItem(JOB);
        window.sessionStorage.removeItem(TAKE);
        window.sessionStorage.removeItem(OPENED);
      } catch (e) {}

      // Dans l'editeur de theme, Shopify bloque les envois de formulaire. Sans
      // ce cas, tester le tunnel depuis l'editeur finit TOUJOURS sur une
      // erreur d'envoi qui n'existe pas sur la boutique en ligne. L'ecran
      // d'attente s'affiche quand meme : c'est le seul endroit ou le marchand
      // peut le voir tant que ses pages ne sont pas publiees.
      if (window.Shopify && window.Shopify.designMode) {
        stash(data);
        gate.preview = true;
        finish(who);
        var note = root.querySelector('[data-cs-editnote]');
        if (note) {
          note.textContent = 'Theme editor only: nothing was sent, Shopify '
            + 'blocks form submissions here. On the live storefront the answers '
            + 'reach your inbox and this same screen appears.';
          note.hidden = false;
        }
        return;
      }

      var url = (root.getAttribute('data-api') || '').trim();
      if (!url) {
        form.hidden = true;
        root.querySelector('.cs-flow-top').hidden = true;
        wait.hidden = false;
        sendNative(data);
        return;
      }

      // Avec la generation branchee : l'attente s'affiche TOUT DE SUITE, au
      // clic. La preview et l'e-mail partent derriere, sans quitter la page.
      stash(data);
      finish(who);
      startJob(url, data);
      sendLead(data);
    }

    next.addEventListener('click', function () {
      if (!valid(i)) return;
      if (i === last) submit(); else show(i + 1);
    });
    back.addEventListener('click', function () { if (i > 0) show(i - 1); });

    // Entree fait avancer, sauf dans une zone de texte ou elle sert a aller a la ligne.
    form.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' || e.target.tagName === 'TEXTAREA') return;
      e.preventDefault();
      next.click();
    });

    // Un choix de carte sur la landing page arrive en ?occasion=… : on le coche.
    try {
      var want = new URLSearchParams(window.location.search).get('occasion');
      if (want) {
        var opts = form.querySelectorAll('input[name=occasion]');
        for (var o = 0; o < opts.length; o++) {
          if (opts[o].value.toLowerCase() === want.toLowerCase()) { opts[o].checked = true; break; }
        }
      }
    } catch (e) {}

    // Le champ libre suit les boutons de SON fieldset : rien a declarer, il
    // suffit qu'il soit au bon endroit dans le balisage.
    var more = form.querySelector('[data-cs-more]');
    if (more) {
      var moreInput = more.querySelector('input');
      var moreFor = (more.getAttribute('data-cs-more') || '').toLowerCase();
      var moreGroup = more.closest('fieldset').querySelectorAll('input[type=radio]');
      var syncMore = function () {
        var on = false;
        for (var m = 0; m < moreGroup.length; m++) {
          if (moreGroup[m].checked && moreGroup[m].value.toLowerCase() === moreFor) on = true;
        }
        more.hidden = !on;
        if (on) {
          moreInput.setAttribute('data-req', '');
        } else {
          // On vide en refermant, sinon une precision abandonnee part quand meme.
          moreInput.removeAttribute('data-req');
          moreInput.value = '';
        }
      };
      for (var m2 = 0; m2 < moreGroup.length; m2++) moreGroup[m2].addEventListener('change', syncMore);
      syncMore();
    }

    var photoEl = form.querySelector('[data-cs-photo]');
    var prevBox = form.querySelector('[data-cs-photo-prev]');
    var labelEl = form.querySelector('[data-cs-photo-label]');
    var baseLabel = labelEl ? labelEl.textContent : '';

    function paintShots() {
      if (prevBox) {
        prevBox.innerHTML = '';
        for (var n = 0; n < shots.length; n++) {
          var im = document.createElement('img');
          im.src = shots[n];
          im.alt = '';
          prevBox.appendChild(im);
        }
        prevBox.setAttribute('data-n', String(shots.length));
        prevBox.hidden = !shots.length;
      }
      if (labelEl) {
        labelEl.textContent = shots.length > 1 ? (D.phTwo || baseLabel)
          : shots.length ? (D.phOne || baseLabel) : baseLabel;
      }
      // Le champ fichier perd son obligation des qu'une photo est gardee. Il
      // faut ce detour : apres un rechargement il est toujours vide, alors que
      // la photo, elle, est encore la. Sans ca l'ecran redemanderait un
      // fichier deja fourni.
      if (photoEl) {
        if (shots.length) photoEl.removeAttribute('data-req');
        else photoEl.setAttribute('data-req', '');
      }
    }

    if (photoEl) {
      photoEl.addEventListener('change', function () {
        var picked = photoEl.files ? Array.prototype.slice.call(photoEl.files) : [];
        if (!picked.length) return;
        var over = picked.length > MAXPH;
        picked = picked.slice(0, MAXPH);

        // On repart de la selection en cours a chaque fois : un champ fichier
        // remplace son contenu, les vignettes doivent dire la meme chose.
        var got = [];
        var left = picked.length;
        picked.forEach(function (f, n) {
          shrink(f, function (url) {
            if (url) got[n] = url;
            if (--left) return;
            var keep = [];
            for (var g = 0; g < got.length; g++) if (got[g]) keep.push(got[g]);
            shots = keep;
            keepShots();
            paintShots();
            if (over && D.phMax) { err.textContent = D.phMax; err.hidden = false; }
            else { err.hidden = true; }
          });
        });
      });
      paintShots();
    }

    // Shopify renvoie sur la page avec ?contact_posted=true quand le message
    // est reellement parti. C'est ce retour qui affiche l'ecran d'attente : le
    // rechargement du POST natif passe par la, et l'echeance gardee fait que
    // la barre reprend ou elle etait plutot que de repartir de zero.
    var posted = false;
    try {
      posted = new URLSearchParams(window.location.search).get('contact_posted') === 'true';
    } catch (e) {}
    // Un rechargement pendant l'attente, ou apres l'ouverture, ne ramene pas au
    // formulaire : on reprend exactement ou on en etait.
    var job = readJob();
    var opened = false;
    try { opened = window.sessionStorage.getItem(OPENED) === '1'; } catch (e) {}
    if (posted || job || opened || haveTake()) {
      // On ne l'efface pas : la page d'attente en a besoin pour ses titres.
      // Elle meurt avec l'onglet, ce qui suffit.
      var who = { name: '', email: '' };
      try {
        var raw = JSON.parse(window.sessionStorage.getItem(STORE) || '{}');
        who = { name: raw.their_name || '', email: raw.email || '' };
      } catch (e) {}
      if (opened) { gate.bar = true; gate.video = true; }
      if (haveTake()) {
        gate.preview = true;
      } else if (job) {
        poll();
      } else if ((root.getAttribute('data-api') || '').trim()) {
        gate.preview = true;
        gate.failed = true;
      } else {
        // Pas de generation branchee : rien a attendre d'elle.
        gate.preview = true;
      }
      finish(who);
      return;
    }

    show(0);
  }

  function init(scope) {
    var host = scope && scope.querySelectorAll ? scope : document;
    var all = host.querySelectorAll('[data-cs-flow]');
    for (var i = 0; i < all.length; i++) setup(all[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(document); });
  } else {
    init(document);
  }
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
