{%- liquid
  comment
    La page d'apres-tunnel, moitie haute.

    Deux etats sur une seule page :
      VERROUILLE  - on ne voit que l'attente : les titres, le clip, la barre,
                    l'encart. Tout le reste de la page est masque.
      OUVERT      - la barre est pleine, l'attente reste en haut et le reste
                    apparait : l'apercu, la preuve, le tarif, l'offre, les
                    avis, les questions.

    La barre tient sur bar_minutes et son echeance est gardee dans le
    navigateur du visiteur : recharger ne la fait pas repartir, et une fois
    ouverte la page reste ouverte.

    Les titres se composent avec les reponses du tunnel, mises de cote dans
    l'onglet : {name} {you} {rel} {occasion} {genre} {voice}. Sans reponse, le
    gabarit est retire plutot que de laisser un trou dans la phrase.

    Dans l'editeur de theme rien n'est jamais verrouille, sinon le marchand ne
    pourrait pas voir ni modifier le bas de sa page.
  endcomment
-%}
{%- assign locked = section.settings.lock -%}
{%- if request.design_mode -%}{%- assign locked = false -%}{%- endif -%}
<div class="cs cs-duo-pvs" data-cs-pvs
     data-lock="{% if locked %}1{% else %}0{% endif %}"
     data-bar="{{ section.settings.bar_minutes }}"
     data-timer="{% if section.settings.show_timer %}{{ section.settings.timer_minutes }}{% else %}0{% endif %}"
     data-timer-end="{{ section.settings.timer_over | escape }}"
     data-stages="{{ section.settings.stages | newline_to_br | replace: '<br />', '|' | escape }}">
  <div class="cs-wrap">

    {%- comment -%} L'attente. Toujours visible, verrouillee ou pas. {%- endcomment -%}
    <div class="cs-pvs-top">
      {%- if section.settings.logo != blank -%}
        <img class="cs-pvs-logo" src="{{ section.settings.logo | image_url: width: 600 }}"
             alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
             style="width:{{ section.settings.logo_width }}px" loading="eager">
      {%- endif -%}

      {%- if section.settings.wait_heading != blank -%}
        <h1 class="cs-pvs-h1" data-cs-tpl>{{ section.settings.wait_heading }}</h1>
      {%- endif -%}
      {%- if section.settings.wait_sub != blank -%}
        <p class="cs-pvs-sub" data-cs-tpl>{{ section.settings.wait_sub }}</p>
      {%- endif -%}

      {%- if section.settings.video != blank or section.settings.video_url != blank -%}
        <div class="cs-pvs-stage" style="aspect-ratio:{{ section.settings.video_ratio }}">
          {%- if section.settings.video != blank -%}
            {%- assign src = section.settings.video.sources | where: 'format', 'mp4' | first -%}
            {%- assign vsrc = src.url -%}
          {%- else -%}
            {%- assign vsrc = section.settings.video_url -%}
          {%- endif -%}
          {%- comment -%}
            Demarrage muet, sans commandes natives : elles se posent pile sur le
            sous-titre incruste. Le son revient par le bouton en haut a droite,
            jamais en bas, le bas appartient a la legende.
          {%- endcomment -%}
          <video class="cs-pvs-v" playsinline preload="metadata"
                 {% if section.settings.autoplay %}autoplay muted{% else %}controls{% endif %}
                 src="{{ vsrc }}"
                 {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 900 }}"{% endif %}></video>
          {%- if section.settings.show_clock -%}
            <span class="cs-pvs-clock" data-cs-clock aria-hidden="true">--:--</span>
          {%- endif -%}
          {%- if section.settings.autoplay -%}
            <button type="button" class="cs-pvs-sound" data-cs-sound>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
              <span>{{ section.settings.sound_label | default: 'Tap for sound' }}</span>
            </button>
          {%- endif -%}
          {%- if section.settings.video_caption != blank -%}
            <span class="cs-pvs-cap">{{ section.settings.video_caption }}</span>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%}
          Aucun fichier charge : un cadre vide a la bonne forme, pour qu'on voie
          ou deposer la video au lieu d'une page amputee.
        {%- endcomment -%}
        <div class="cs-pvs-stage cs-pvs-stage-empty" style="aspect-ratio:{{ section.settings.video_ratio }}">
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg>
            {{ section.settings.video_empty | default: 'Your video goes here — upload an MP4 in the sidebar.' }}
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.show_progress -%}
        <div class="cs-pvs-prog">
          <p class="cs-pvs-prog-top">
            <span data-cs-stage>{{ section.settings.stages | newline_to_br | split: '<br />' | first | strip }}</span>
            <b data-cs-pct>0%</b>
          </p>
          <span class="cs-pvs-bar"><i data-cs-fill></i></span>
        </div>
      {%- endif -%}

      {%- if section.settings.notice != blank -%}
        <p class="cs-pvs-notice" data-cs-tpl>{{ section.settings.notice }}</p>
      {%- endif -%}
      {%- if section.settings.ready_notice != blank -%}
        <p class="cs-pvs-ready" data-cs-ready data-cs-tpl hidden>{{ section.settings.ready_notice }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Tout ce qui suit est masque tant que la barre n'est pas pleine. {%- endcomment -%}
    <div class="cs-pvs-after" data-cs-after>

      {%- comment -%} L'apercu du clip {%- endcomment -%}
      <div class="cs-pvs-song">
        {%- if section.settings.song_title != blank -%}
          <h2 class="cs-pvs-title" data-cs-tpl>{{ section.settings.song_title }}</h2>
        {%- endif -%}
        {%- if section.settings.song_sub != blank -%}
          <p class="cs-pvs-songsub" data-cs-tpl>{{ section.settings.song_sub }}</p>
        {%- endif -%}

        <div class="cs-pvs-player">
          {%- if section.settings.prev_video != blank or section.settings.prev_url != blank -%}
            {%- if section.settings.prev_video != blank -%}
              {%- assign psrc = section.settings.prev_video.sources | where: 'format', 'mp4' | first -%}
              {%- assign pv = psrc.url -%}
            {%- else -%}
              {%- assign pv = section.settings.prev_url -%}
            {%- endif -%}
            <div class="cs-pvs-prev" style="aspect-ratio:{{ section.settings.prev_ratio }}">
              <video class="cs-pvs-pv" data-cs-prev playsinline preload="metadata"
                     src="{{ pv }}"
                     {% if section.settings.prev_poster != blank %}poster="{{ section.settings.prev_poster | image_url: width: 900 }}"{% endif %}></video>
              <button type="button" class="cs-pvs-cover" data-cs-tap>
                <span class="cs-pvs-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="cs-pvs-tap">{{ section.settings.play_hint | default: 'Tap to play preview' }}</span>
              </button>
            </div>
          {%- else -%}
            {%- comment -%}
              Pas encore de fichier : un cadre vide, pas un bouton qui fait
              semblant de lire quelque chose.
            {%- endcomment -%}
            <div class="cs-pvs-prev cs-pvs-prev-empty" style="aspect-ratio:{{ section.settings.prev_ratio }}">
              <span>{{ section.settings.prev_empty | default: 'Your preview appears here.' }}</span>
            </div>
          {%- endif -%}
          <p class="cs-pvs-time"><span data-cs-cur>0:00</span> / <span data-cs-dur>{{ section.settings.preview_length | default: '0:00' }}</span></p>
          {%- if section.settings.preview_note != blank -%}
            <p class="cs-pvs-note">{{ section.settings.preview_note }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} La preuve : les visages, puis la ligne {%- endcomment -%}
      {%- assign faces = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'face' and block.settings.image != blank -%}{%- assign faces = faces | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if faces > 0 or section.settings.proof_line != blank -%}
        <div class="cs-pvs-proof">
          {%- if faces > 0 -%}
            <div class="cs-pvs-faces">
              {%- for block in section.blocks -%}
                {%- if block.type == 'face' and block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="34" height="34"
                       loading="lazy" {{ block.shopify_attributes }}>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.proof_line != blank -%}
            <p data-cs-tpl>{{ section.settings.proof_line }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Le tarif reserve aux apercus {%- endcomment -%}
      {%- if section.settings.deal_title != blank -%}
        <div class="cs-pvs-deal">
          <p class="cs-pvs-deal-t" data-cs-tpl>{{ section.settings.deal_title }}</p>
          {%- if section.settings.deal_note != blank -%}<p class="cs-pvs-deal-n" data-cs-tpl>{{ section.settings.deal_note }}</p>{%- endif -%}
          {%- if section.settings.deal_chip != blank -%}<span class="cs-pvs-chip">{{ section.settings.deal_chip }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%}
        Le rebours du tarif. L'echeance est posee une seule fois par visiteur :
        un rebours qui repart a chaque rechargement n'est pas une echeance.
      {%- endcomment -%}
      {%- if section.settings.show_timer -%}
        <div class="cs-pvs-timer" data-cs-timer>
          {%- if section.settings.timer_title != blank -%}<p class="cs-pvs-timer-t" data-cs-tpl>{{ section.settings.timer_title }}</p>{%- endif -%}
          <p class="cs-pvs-timer-n" data-cs-big>--:--</p>
          {%- if section.settings.timer_note != blank -%}<p class="cs-pvs-note" data-cs-tpl>{{ section.settings.timer_note }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} La comparaison des cadeaux {%- endcomment -%}
      {%- assign rows = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' and block.settings.label != blank -%}{%- assign rows = rows | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if rows > 0 -%}
        <ul class="cs-pvs-rows">
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' and block.settings.label != blank -%}
              <li {% if block.settings.strong %}class="is-strong"{% endif %} {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}<span class="cs-pvs-row-i" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                <span class="cs-pvs-row-l" data-cs-tpl>{{ block.settings.label }}</span>
                {%- if block.settings.was != blank -%}<s class="cs-pvs-row-was">{{ block.settings.was }}</s>{%- endif -%}
                {%- if block.settings.value != blank -%}<b class="cs-pvs-row-v">{{ block.settings.value }}</b>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>
  </div>
</div>
{% schema %}
{
  "name": "CraftStory Duo Preview",
  "settings": [
    { "type": "paragraph", "content": "The page they land on straight after the flow. Two states: while the bar fills, only the waiting block shows and the whole rest of the page is hidden. When it reaches 100%, everything below unlocks and the waiting block stays at the top." },
    { "type": "paragraph", "content": "Write {name} {you} {rel} {occasion} {genre} {voice} in any text here and it is replaced by what they answered in the flow. Nothing is stored on a server — the answers live in their own browser tab. Without an answer, the placeholder is removed rather than left as a hole in the sentence." },
    { "type": "paragraph", "content": "Structure and forms only: nothing is wired to a generator or to a payment, so most fields start empty on purpose." },

    { "type": "header", "content": "The wait, and the unlock" },
    { "type": "checkbox", "id": "lock", "label": "Hide the rest of the page until the bar is full", "default": false, "info": "Off by default: the wait now happens on the flow page, and people only reach this one by tapping its button. Turn it on only if you make this page the landing point instead. Never applied inside the theme editor." },
    { "type": "range", "id": "bar_minutes", "label": "How long the bar takes", "min": 1, "max": 10, "step": 1, "default": 5, "unit": "min" },
    { "type": "paragraph", "content": "The deadline is set once per visitor and kept in their browser: reloading does not restart it, and once the page is unlocked it stays unlocked." },
    { "type": "checkbox", "id": "show_progress", "label": "Show the progress bar", "default": true },
    { "type": "textarea", "id": "stages", "label": "Stages", "default": "Reading your story…\nWriting your lyrics…\nRecording your song…\nAnimating your music video…\nAlmost there…", "info": "One per line. The label changes as the bar advances." },

    { "type": "header", "content": "Above the clip" },
    { "type": "image_picker", "id": "logo", "label": "Logo or artwork" },
    { "type": "range", "id": "logo_width", "label": "Its width", "min": 60, "max": 280, "step": 10, "default": 150, "unit": "px" },
    { "type": "text", "id": "wait_heading", "label": "Heading", "default": "Your words are becoming a music video." },
    { "type": "text", "id": "wait_sub", "label": "Second line", "default": "Watch this while we make it.", "info": "Shown in coral, under the heading." },

    { "type": "header", "content": "The clip" },
    { "type": "video", "id": "video", "label": "Clip (upload MP4)" },
    { "type": "video_url", "id": "video_url", "label": "Or a clip URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "poster", "label": "Clip cover" },
    { "type": "select", "id": "video_ratio", "label": "Clip shape", "default": "4/3",
      "options": [
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "4/3", "label": "Classic (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ] },
    { "type": "checkbox", "id": "autoplay", "label": "Start the clip on arrival, muted", "default": true },
    { "type": "checkbox", "id": "show_clock", "label": "Show the time left on the clip", "default": true },
    { "type": "text", "id": "sound_label", "label": "Sound button", "default": "Tap for sound" },
    { "type": "text", "id": "video_caption", "label": "Caption over the clip" },
    { "type": "text", "id": "video_empty", "label": "Text while there is no clip", "default": "Your video goes here — upload an MP4 in the sidebar.", "info": "Shown in an empty frame, so the block is visible before you add a file." },
    { "type": "text", "id": "notice", "label": "Notice while it fills", "default": "⚡ Your free preview appears here at the end of the video." },
    { "type": "text", "id": "ready_notice", "label": "Notice once it is full", "default": "✓ It's ready. Your preview is waiting below." },

    { "type": "header", "content": "The preview" },
    { "type": "text", "id": "song_title", "label": "Title", "default": "{name}'s Unique Music Video" },
    { "type": "text", "id": "song_sub", "label": "Subheading", "default": "{genre} melody, written for {name} ({rel})" },
    { "type": "video", "id": "prev_video", "label": "Preview clip (upload MP4)", "info": "Twenty to thirty seconds is plenty." },
    { "type": "video_url", "id": "prev_url", "label": "Or a preview URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "prev_poster", "label": "Preview cover" },
    { "type": "select", "id": "prev_ratio", "label": "Preview shape", "default": "16/9",
      "options": [
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "4/3", "label": "Classic (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ] },
    { "type": "text", "id": "play_hint", "label": "Play label", "default": "Tap to play preview" },
    { "type": "text", "id": "prev_empty", "label": "Text while there is no file", "default": "Your preview appears here." },
    { "type": "text", "id": "preview_length", "label": "Preview length", "default": "0:30" },
    { "type": "text", "id": "preview_note", "label": "Line under the preview", "default": "Play it with headphones if you have them." },

    { "type": "header", "content": "Proof" },
    { "type": "paragraph", "content": "Add a Face block per photo. Leave the line empty until the number is one you can stand behind." },
    { "type": "text", "id": "proof_line", "label": "Proof line" },

    { "type": "header", "content": "The rate" },
    { "type": "text", "id": "deal_title", "label": "Rate title" },
    { "type": "text", "id": "deal_note", "label": "Rate note" },
    { "type": "text", "id": "deal_chip", "label": "Rate chip", "info": "The small badge on the right, for example SAVE $40." },

    { "type": "header", "content": "The rate countdown" },
    { "type": "checkbox", "id": "show_timer", "label": "Show a countdown", "default": false },
    { "type": "range", "id": "timer_minutes", "label": "Minutes", "min": 1, "max": 60, "step": 1, "default": 1, "unit": "min" },
    { "type": "text", "id": "timer_title", "label": "Countdown title", "default": "Your spot is held" },
    { "type": "text", "id": "timer_note", "label": "Countdown note" },
    { "type": "text", "id": "timer_over", "label": "When it runs out", "default": "This rate has ended. You can still order at the regular rate." },

    { "type": "header", "content": "Flowers, jewellery, and your video" },
    { "type": "paragraph", "content": "Add a Row block per line. Tick Highlight on the last one." }
  ],
  "blocks": [
    {
      "type": "face",
      "name": "Face",
      "settings": [ { "type": "image_picker", "id": "image", "label": "Photo" } ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "info": "One character or emoji." },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "was", "label": "Struck-through value" },
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "checkbox", "id": "strong", "label": "Highlight this line", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "CraftStory Duo Preview", "blocks": [
      { "type": "face" }, { "type": "face" }, { "type": "face" }, { "type": "face" }, { "type": "face" },
      { "type": "row" }, { "type": "row" }, { "type": "row" }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-pvs{background:var(--cs-paper);padding:clamp(20px,4vw,40px) 0 0}
.cs-duo-pvs [hidden]{display:none !important}
.cs-duo-pvs .cs-wrap{max-width:560px}

/* Le verrou. La section qui le pose masque aussi les suivantes : c'est elle
   qui decide quand la page s'ouvre, et sa feuille de style n'est chargee que
   lorsqu'elle est presente. */
html[data-cs-lock="1"] .cs-pvs-after,
html[data-cs-lock="1"] .cs-duo-pvo,
html[data-cs-lock="1"] .cs-duo-rev,
html[data-cs-lock="1"] .cs-duo-faq,
html[data-cs-lock="1"] .cs-duo-help{display:none !important}
.cs-pvs-after{animation:cs-pvs-in .4s ease both}
@keyframes cs-pvs-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

.cs-pvs-top{text-align:center}
.cs-pvs-logo{display:block;height:auto;margin:0 auto 16px}
.cs-pvs-h1{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.35rem,4.6vw,1.9rem);line-height:1.15;
  letter-spacing:-.015em;color:var(--cs-ink);margin:0}
/* La seconde ligne est coraille : c'est elle qui tient le regard pendant
   l'attente, pas le titre. */
.cs-pvs-sub{color:var(--cs-coral);font-weight:700;font-size:1rem;line-height:1.4;margin:6px 0 16px}
.cs-pvs-stage{position:relative;border-radius:var(--cs-r-lg);overflow:hidden;background:var(--cs-night);
  aspect-ratio:4/3;box-shadow:0 14px 34px rgba(28,21,51,.16)}
.cs-pvs-v{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-pvs-clock{position:absolute;top:10px;left:10px;padding:4px 9px;border-radius:var(--cs-pill);
  background:rgba(28,21,51,.72);color:#fff;font-size:.8rem;font-weight:700;font-variant-numeric:tabular-nums}
.cs-pvs-cap{position:absolute;left:10px;right:10px;bottom:10px;text-align:center;font-weight:800;
  font-size:.86rem;letter-spacing:.02em;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.6)}
/* En haut a droite, jamais en bas : le bas appartient a la legende. */
.cs-pvs-sound{position:absolute;top:10px;right:10px;display:inline-flex;align-items:center;gap:5px;
  padding:5px 10px;border:0;border-radius:var(--cs-pill);cursor:pointer;
  background:rgba(28,21,51,.72);color:#fff;font:inherit;font-size:.76rem;font-weight:700}
.cs-pvs-sound:hover{background:rgba(28,21,51,.88)}
.cs-pvs-sound svg{width:14px;height:14px}
.cs-pvs-note{color:var(--cs-ink3);font-size:.84rem;line-height:1.45;margin:10px 0 0}

/* L'avancement */
.cs-pvs-prog{margin-top:14px;padding:12px 14px;border-radius:var(--cs-r);
  background:var(--cs-card);border:1px solid var(--cs-line);text-align:left}
.cs-pvs-prog-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 0 8px}
.cs-pvs-prog-top span{font-size:.86rem;color:var(--cs-ink2);line-height:1.35}
.cs-pvs-prog-top b{flex:0 0 auto;font-size:.86rem;font-weight:800;color:var(--cs-coral);font-variant-numeric:tabular-nums}
.cs-pvs-bar{display:block;height:7px;border-radius:var(--cs-pill);background:var(--cs-line);overflow:hidden}
.cs-pvs-bar i{display:block;height:100%;width:0;border-radius:var(--cs-pill);
  background:linear-gradient(90deg,var(--cs-coral),var(--cs-coral-deep));transition:width .5s linear}
.cs-pvs-notice,.cs-pvs-ready{display:block;margin:12px 0 0;padding:11px 14px;border-radius:var(--cs-r);
  font-size:.87rem;font-weight:600;line-height:1.45;text-align:left}
.cs-pvs-notice{background:rgba(236,91,60,.09);border:1px solid rgba(236,91,60,.26);color:var(--cs-coral-deep)}
.cs-pvs-ready{background:rgba(60,140,90,.1);border:1px solid rgba(60,140,90,.4);color:#2e6b48}

/* L'apercu */
.cs-pvs-song{margin-top:clamp(26px,5vw,40px);text-align:center}
.cs-pvs-title{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.5rem,5.2vw,2.1rem);line-height:1.14;
  letter-spacing:-.015em;color:var(--cs-ink);margin:0}
.cs-pvs-songsub{color:var(--cs-ink2);font-size:.95rem;line-height:1.45;margin:6px 0 0}
.cs-pvs-player{margin-top:18px;padding:clamp(14px,3vw,20px);border-radius:var(--cs-r-lg);
  background:var(--cs-card);border:1px solid var(--cs-line)}
.cs-pvs-prev{position:relative;border-radius:var(--cs-r);overflow:hidden;background:var(--cs-night);
  aspect-ratio:16/9}
.cs-pvs-pv{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-pvs-cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:11px;border:0;cursor:pointer;background:rgba(28,21,51,.34);transition:background .18s ease}
.cs-pvs-cover:hover{background:rgba(28,21,51,.22)}
.cs-pvs-btn{display:grid;place-items:center;width:62px;height:62px;border-radius:50%;
  background:var(--cs-coral);color:#fff;box-shadow:0 8px 20px rgba(236,91,60,.4)}
.cs-pvs-btn svg{width:26px;height:26px;margin-left:3px}
.cs-pvs-tap{font:inherit;font-size:.9rem;font-weight:700;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.5)}
.cs-pvs-stage-empty{display:grid;place-items:center;background:var(--cs-paper2);
  border:2px dashed var(--cs-line);box-shadow:none}
.cs-pvs-stage-empty span{display:flex;flex-direction:column;align-items:center;gap:9px;
  padding:0 20px;text-align:center;color:var(--cs-ink3);font-size:.88rem;line-height:1.45}
.cs-pvs-stage-empty svg{width:34px;height:34px}
.cs-pvs-prev-empty{display:grid;place-items:center;background:var(--cs-paper2);border:1px dashed var(--cs-line)}
.cs-pvs-prev-empty span{padding:0 18px;text-align:center;color:var(--cs-ink3);font-size:.88rem;line-height:1.45}
.cs-pvs-time{color:var(--cs-ink3);font-size:.84rem;font-variant-numeric:tabular-nums;margin:11px 0 0}

/* La preuve */
.cs-pvs-proof{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:clamp(22px,4vw,32px)}
.cs-pvs-faces{display:flex}
.cs-pvs-faces img{width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid var(--cs-paper)}
.cs-pvs-faces img + img{margin-left:-11px}
.cs-pvs-proof p{margin:0;text-align:center;color:var(--cs-ink2);font-size:.9rem;font-weight:600;line-height:1.4}

/* Le tarif */
.cs-pvs-deal{position:relative;margin-top:clamp(20px,4vw,28px);padding:14px 16px;border-radius:var(--cs-r);
  background:rgba(60,140,90,.1);border:1px solid rgba(60,140,90,.4);text-align:left}
.cs-pvs-deal-t{margin:0;padding-right:72px;font-weight:800;font-size:.97rem;color:#2e6b48}
.cs-pvs-deal-n{margin:4px 0 0;font-size:.85rem;line-height:1.45;color:var(--cs-ink2)}
.cs-pvs-chip{position:absolute;top:12px;right:14px;padding:3px 9px;border-radius:var(--cs-pill);
  background:#2e6b48;color:#fff;font-size:.72rem;font-weight:800;letter-spacing:.02em}

/* Le rebours */
.cs-pvs-timer{margin-top:clamp(20px,4vw,28px);padding:clamp(16px,3vw,22px);border-radius:var(--cs-r-lg);
  background:var(--cs-paper2);border:1px solid var(--cs-line);text-align:center}
.cs-pvs-timer-t{margin:0;font-weight:700;font-size:.95rem;color:var(--cs-ink)}
.cs-pvs-timer-n{margin:6px 0 0;font-family:var(--cs-serif);font-weight:600;font-size:clamp(2rem,9vw,2.8rem);
  line-height:1;letter-spacing:-.02em;color:var(--cs-coral);font-variant-numeric:tabular-nums}
.cs-pvs-timer.is-over .cs-pvs-timer-n{font-size:1rem;font-family:inherit;font-weight:700;color:var(--cs-ink2)}

/* Fleurs, bijoux, et votre clip */
.cs-pvs-rows{list-style:none;margin:clamp(20px,4vw,28px) 0 0;padding:0;border-radius:var(--cs-r-lg);
  background:var(--cs-card);border:1px solid var(--cs-line);overflow:hidden}
.cs-pvs-rows li{display:flex;align-items:center;gap:11px;padding:13px 16px}
.cs-pvs-rows li + li{border-top:1px solid var(--cs-line)}
.cs-pvs-rows li.is-strong{background:rgba(236,91,60,.07)}
.cs-pvs-row-i{flex:0 0 auto;font-size:1.05rem;line-height:1}
.cs-pvs-row-l{flex:1 1 auto;min-width:0;font-weight:600;font-size:.94rem;color:var(--cs-ink)}
.cs-pvs-rows li.is-strong .cs-pvs-row-l{font-weight:800}
.cs-pvs-row-was{color:var(--cs-ink3);font-size:.88rem}
.cs-pvs-row-v{flex:0 0 auto;font-weight:800;font-size:.94rem;color:var(--cs-ink3);font-variant-numeric:tabular-nums}
.cs-pvs-rows li.is-strong .cs-pvs-row-v{color:var(--cs-coral)}
@media(prefers-reduced-motion:reduce){.cs-pvs-after{animation:none}}

/* ATTENTION, piege du theme : cs-head pose .cs p{margin:0}, de specificite
   0,1,1. Une classe seule sur un paragraphe vaut 0,1,0 et PERD, quel que soit
   l'ordre des feuilles. Toute marge de <p> doit donc s'ecrire avec la racine de
   la section devant. Sans ca les marges ci-dessus ne s'appliquent pas du tout,
   et on croit avoir regle un rythme vertical qui n'existe pas. */
.cs-duo-pvs .cs-pvs-sub{margin:6px 0 16px}
.cs-duo-pvs .cs-pvs-note{margin:10px 0 0}
.cs-duo-pvs .cs-pvs-songsub{margin:6px 0 0}
.cs-duo-pvs .cs-pvs-prog-top{margin:0 0 8px}
.cs-duo-pvs .cs-pvs-time{margin:11px 0 0}
.cs-duo-pvs .cs-pvs-notice{margin:12px 0 0}
.cs-duo-pvs .cs-pvs-ready{margin:12px 0 0}
.cs-duo-pvs .cs-pvs-deal-t{margin:0}
.cs-duo-pvs .cs-pvs-deal-n{margin:4px 0 0}
.cs-duo-pvs .cs-pvs-timer-t{margin:0}
.cs-duo-pvs .cs-pvs-timer-n{margin:6px 0 0}
{% endstylesheet %}
{% javascript %}
(function () {
  var STORE = 'csDuoFlow';      // les reponses du tunnel, dans l'onglet
  var DEAL = 'csDuoDeadline';   // l'echeance du tarif
  var OPEN = 'csDuoOpenAt';     // l'echeance de l'ouverture

  function two(n) { return (n < 10 ? '0' : '') + n; }
  function mmss(s) { s = Math.max(0, Math.round(s)); return two(Math.floor(s / 60)) + ':' + two(s % 60); }

  // Ce que le tunnel a mis de cote, plus ?name= qui survit a un partage de lien.
  function answers() {
    var a = {};
    try { a = JSON.parse(window.sessionStorage.getItem(STORE) || '{}') || {}; } catch (e) {}
    var out = {
      name: a.their_name || '', you: a.your_name || '', rel: a.relationship || '',
      occasion: a.occasion_other || a.occasion || '', genre: a.genre || '', voice: a.voice || ''
    };
    try {
      var q = new URLSearchParams(window.location.search).get('name');
      if (q && !out.name) out.name = q.trim();
    } catch (e) {}
    return out;
  }

  function personalise(root, map) {
    var els = root.querySelectorAll('[data-cs-tpl]');
    for (var i = 0; i < els.length; i++) {
      var tpl = els[i].getAttribute('data-cs-orig') || els[i].textContent;
      els[i].setAttribute('data-cs-orig', tpl);
      var out = tpl, missing = false;
      for (var k in map) {
        if (out.indexOf('{' + k + '}') < 0) continue;
        if (map[k]) { out = out.split('{' + k + '}').join(map[k]); } else { missing = true; }
      }
      // Une reponse manquante : on retire le gabarit et ce qui l'entoure
      // plutot que de laisser « ('s song » ou une parenthese vide.
      if (missing) {
        out = out.replace(/\s*\([^()]*\{\w+\}[^()]*\)/g, '')
                 .replace(/\{\w+\}'s\s*/g, '')
                 .replace(/\{\w+\}\s*/g, '')
                 .replace(/\s*,\s*,/g, ',')
                 .replace(/\s{2,}/g, ' ')
                 .replace(/^[\s,·]+|[\s,·]+$/g, '');
      }
      els[i].textContent = out;
      if (!out) els[i].hidden = true;
    }
  }

  // L'attente et l'ouverture. L'echeance est posee une fois et gardee : ni un
  // rechargement ni un aller-retour ne la font repartir.
  function unlock(root) {
    var mins = parseFloat(root.getAttribute('data-bar') || '5') || 5;
    var locking = root.getAttribute('data-lock') === '1';
    var fill = root.querySelector('[data-cs-fill]');
    var pct = root.querySelector('[data-cs-pct]');
    var label = root.querySelector('[data-cs-stage]');
    var clock = root.querySelector('[data-cs-clock]');
    var ready = root.querySelector('[data-cs-ready]');
    var notice = root.querySelector('.cs-pvs-notice');

    var stages = [];
    var raw = (root.getAttribute('data-stages') || '').split('|');
    for (var i = 0; i < raw.length; i++) { if (raw[i].trim()) stages.push(raw[i].trim()); }

    var end = 0;
    try {
      end = parseInt(window.localStorage.getItem(OPEN) || '0', 10);
      if (!end || isNaN(end)) {
        end = Date.now() + mins * 60000;
        window.localStorage.setItem(OPEN, String(end));
      }
    } catch (e) { end = Date.now() + mins * 60000; }

    function open() {
      document.documentElement.setAttribute('data-cs-lock', '0');
      if (notice) notice.hidden = true;
      if (ready) ready.hidden = false;
    }

    function paint() {
      var left = Math.max(0, (end - Date.now()) / 1000);
      var p = Math.max(0, Math.min(100, (1 - left / (mins * 60)) * 100));
      if (fill) fill.style.width = p + '%';
      if (pct) pct.textContent = Math.round(p) + '%';
      if (clock) clock.textContent = mmss(left);
      if (label && stages.length) {
        var n = Math.min(stages.length - 1, Math.floor(p / (100 / stages.length)));
        if (label.textContent !== stages[n]) label.textContent = stages[n];
      }
      if (left > 0) return;
      clearInterval(id);
      open();
    }

    // Verrou eteint : l'attente a deja eu lieu sur la page du tunnel. Relancer
    // une barre a zero ici ferait croire a la personne qu'elle doit attendre
    // une seconde fois. On ouvre donc tout de suite et on retire la barre.
    if (!locking) {
      open();
      var panel2 = root.querySelector('.cs-pvs-prog');
      if (panel2) panel2.hidden = true;
      if (clock) clock.hidden = true;
      return;
    }

    document.documentElement.setAttribute('data-cs-lock', '1');
    paint();
    var id = setInterval(paint, 500);
  }

  function deal(root) {
    var mins = parseInt(root.getAttribute('data-timer') || '0', 10);
    if (!mins) return;
    var panel = root.querySelector('[data-cs-timer]');
    var big = root.querySelector('[data-cs-big]');
    var end = 0;
    try {
      end = parseInt(window.localStorage.getItem(DEAL) || '0', 10);
      if (!end || isNaN(end)) {
        end = Date.now() + mins * 60000;
        window.localStorage.setItem(DEAL, String(end));
      }
    } catch (e) { end = Date.now() + mins * 60000; }

    function tick() {
      var left = Math.max(0, (end - Date.now()) / 1000);
      if (big) big.textContent = mmss(left);
      if (left > 0) return;
      clearInterval(id);
      if (panel) {
        panel.classList.add('is-over');
        if (big) big.textContent = root.getAttribute('data-timer-end') || '';
      }
    }
    tick();
    var id = setInterval(tick, 1000);
  }

  function sound(root) {
    var v = root.querySelector('.cs-pvs-v');
    var btn = root.querySelector('[data-cs-sound]');
    var stage = root.querySelector('.cs-pvs-stage');
    if (!v) return;
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        v.muted = false;
        v.play();
        btn.hidden = true;
      });
    }
    // Sans commandes natives, le doigt sur l'image doit au moins mettre en pause.
    if (stage && btn) {
      stage.addEventListener('click', function () {
        if (v.paused) { v.play(); } else { v.pause(); }
      });
    }
  }

  function preview(root) {
    var v = root.querySelector('[data-cs-prev]');
    var cover = root.querySelector('[data-cs-tap]');
    var cur = root.querySelector('[data-cs-cur]');
    var dur = root.querySelector('[data-cs-dur]');
    if (!v) return;

    function clock(s) { s = Math.max(0, Math.round(s || 0)); return Math.floor(s / 60) + ':' + two(s % 60); }

    if (cover) {
      cover.addEventListener('click', function () { v.play(); });
      v.addEventListener('play', function () { cover.hidden = true; });
      v.addEventListener('pause', function () { cover.hidden = false; });
      v.addEventListener('ended', function () { cover.hidden = false; });
    }
    v.addEventListener('timeupdate', function () { if (cur) cur.textContent = clock(v.currentTime); });
    v.addEventListener('loadedmetadata', function () {
      if (dur && isFinite(v.duration)) dur.textContent = clock(v.duration);
    });
  }

  function setup(root) {
    if (root.dataset.csPvsReady) return;
    root.dataset.csPvsReady = '1';
    personalise(root, answers());
    sound(root);
    preview(root);
    unlock(root);
    deal(root);
  }

  function init(scope) {
    var host = scope && scope.querySelectorAll ? scope : document;
    var all = host.querySelectorAll('[data-cs-pvs]');
    for (var i = 0; i < all.length; i++) setup(all[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(document); });
  } else {
    init(document);
  }
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
