{%- liquid
  # Parity notes (reference: unique-song.com homepage, section id ...__collapsible_content_Gq8rdt)
  #   - one centred heading, no eyebrow, no sub-line, no CTA under the list
  #   - 7 rows, all closed on load, each row its own <details>: several can be open at once
  #   - rows separated by a top border (their "accordion--top-border"), no cards
  #   - band padding 27px on phones / 36px from 750px up (Shopify's stored-value x 0.75 rule)
  #   - the plus marker is a single 10x10 icon inset 1 unit inside the box, arms 1 unit thick,
  #     no minus twin: the open state is a transform. It inherits the text colour (fill="currentColor")
  #   - each question is a heading: div.summary__title > h2.h4.accordion__title (7 of them)
  #   - rows are animate-item--child inside animate-section animate--hidden always-display, so
  #     --index:N staggers a reveal that fires when the band is scrolled to, not on page load
  #   - they ship NO FAQPage structured data (only Organization + WebSite), so ours is opt-in

  assign dfaq_rows = 0
  assign dfaq_needs_delivery = false
  assign dfaq_needs_guarantee = false
  for block in section.blocks
    if block.type == 'qa' and block.settings.q != blank
      assign dfaq_rows = dfaq_rows | plus: 1
      if block.settings.delivery_line and section.settings.delivery == blank
        assign dfaq_needs_delivery = true
      endif
      if block.settings.guarantee_line and section.settings.guarantee == blank
        assign dfaq_needs_guarantee = true
      endif
    endif
  endfor

  assign dfaq_hclass = 'cs-h1'
  if section.settings.heading_size == 'md'
    assign dfaq_hclass = 'cs-h2'
  endif

  assign dfaq_pt = section.settings.padding_top | default: 36
  assign dfaq_pb = section.settings.padding_bottom | default: 36
-%}
{%- if dfaq_rows > 0 or section.settings.heading != blank or request.design_mode -%}
<div class="cs cs-duo-faq cs-dfaq--{{ section.settings.bg | default: 'paper2' }}" style="--cs-duo-faq-pt:{{ dfaq_pt }}px;--cs-duo-faq-pb:{{ dfaq_pb }}px;">
  <div class="cs-dfaq-band">
    <div class="cs-wrap cs-dfaq-wrap">

      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.sub != blank -%}
        <div class="cs-dfaq-head cs-dfaq-head--{{ section.settings.align | default: 'center' }}">
          {%- if section.settings.eyebrow != blank -%}
            <span class="cs-eyebrow{% if section.settings.bg == 'night' %} cs-on-night{% endif %}">&#10038; {{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ dfaq_hclass }} cs-dfaq-h">
              {%- if section.settings.heading_bold -%}<strong>{{ section.settings.heading }}</strong>{%- else -%}{{ section.settings.heading }}{%- endif -%}
            </h2>
          {%- endif -%}
          {%- if section.settings.sub != blank -%}
            <p class="cs-dfaq-sub">{{ section.settings.sub }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if dfaq_rows > 0 -%}
        <div class="cs-dfaq-list cs-dfaq-list--{{ section.settings.rows_style | default: 'border' }}" data-cs-dfaq data-cs-dfaq-single="{% if section.settings.single_open %}1{% else %}0{% endif %}">
          {%- assign dfaq_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'qa' and block.settings.q != blank -%}
              {%- assign dfaq_i = dfaq_i | plus: 1 -%}
              <div class="cs-dfaq-row" style="--cs-duo-faq-i:{{ dfaq_i }};" data-cs-dfaq-row {{ block.shopify_attributes }}>
                <details class="cs-dfaq-details" data-cs-dfaq-details{% if block.settings.open %} open{% endif %}>
                  <summary
                    class="cs-dfaq-summary"
                    id="cs-dfaq-s-{{ block.id }}-{{ section.id }}"
                    aria-controls="cs-dfaq-a-{{ block.id }}-{{ section.id }}"
                    aria-expanded="{% if block.settings.open %}true{% else %}false{% endif %}"
                    data-cs-dfaq-summary
                  >
                    <div class="cs-dfaq-title">
                      <span class="cs-dfaq-ico" aria-hidden="true">{{ block.settings.icon }}</span>
                      <h2 class="cs-dfaq-q">{{ block.settings.q }}</h2>
                    </div>
                    <svg class="cs-dfaq-plus" viewBox="0 0 10 10" aria-hidden="true" focusable="false" role="presentation">
                      <rect class="cs-dfaq-plus-h" x="1" y="4.5" width="8" height="1" rx="0.5"></rect>
                      <rect class="cs-dfaq-plus-v" x="4.5" y="1" width="1" height="8" rx="0.5"></rect>
                    </svg>
                  </summary>
                  <div class="cs-dfaq-panel" data-cs-dfaq-panel>
                    <div
                      class="cs-dfaq-a rte"
                      id="cs-dfaq-a-{{ block.id }}-{{ section.id }}"
                      role="region"
                      aria-labelledby="cs-dfaq-s-{{ block.id }}-{{ section.id }}"
                    >
                      {%- if block.settings.a != blank -%}{{ block.settings.a }}{%- endif -%}
                      {%- if block.settings.delivery_line and section.settings.delivery != blank -%}
                        <p>{{ section.settings.delivery }}</p>
                      {%- endif -%}
                      {%- if block.settings.guarantee_line and section.settings.guarantee != blank -%}
                        <p>{{ section.settings.guarantee }}</p>
                      {%- endif -%}
                      {%- if block.settings.a == blank and request.design_mode -%}
                        <p class="cs-dfaq-hint">This row has no answer yet. Theme editor &#9656; this question &#9656; Answer.</p>
                      {%- endif -%}
                    </div>
                  </div>
                </details>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="cs-dfaq-cta">
          <a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}"{% if section.settings.cta_popup %} data-cs-open{% endif %}>{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}

      {%- if request.design_mode -%}
        {%- if dfaq_rows == 0 -%}
          <p class="cs-dfaq-hint">No questions yet. Theme editor &#9656; CraftStory Duo FAQ &#9656; Add block &#9656; Question. The reference page shows 7 rows.</p>
        {%- endif -%}
        {%- if dfaq_needs_guarantee -%}
          <p class="cs-dfaq-hint">A row is set to show the guarantee sentence, but "Guarantee sentence" is empty, so nothing is added. Theme editor &#9656; CraftStory Duo FAQ &#9656; Guarantee sentence &mdash; write the promise you will actually honour, or untick the row's "Add the guarantee sentence".</p>
        {%- endif -%}
        {%- if dfaq_needs_delivery -%}
          <p class="cs-dfaq-hint">A row is set to show the delivery-time sentence, but "Delivery-time sentence" is empty, so nothing is added. Theme editor &#9656; CraftStory Duo FAQ &#9656; Delivery-time sentence &mdash; write the turnaround you actually keep, or untick the row's "Add the delivery-time sentence".</p>
        {%- endif -%}
      {%- endif -%}

    </div>
  </div>
</div>
{%- endif -%}

{%- if section.settings.rich_snippet and dfaq_rows > 0 -%}
  {%- capture dfaq_ld -%}
    {%- assign dfaq_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'qa' and block.settings.q != blank and block.settings.a != blank -%}
        {%- capture dfaq_answer -%}{{ block.settings.a }}{% if block.settings.delivery_line and section.settings.delivery != blank %} <p>{{ section.settings.delivery }}</p>{% endif %}{% if block.settings.guarantee_line and section.settings.guarantee != blank %} <p>{{ section.settings.guarantee }}</p>{% endif %}{%- endcapture -%}
        {%- comment -%} paragraph and line breaks become spaces, so the plain text reads like the visible answer {%- endcomment -%}
        {%- assign dfaq_answer = dfaq_answer | replace: '</p>', '</p> ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | strip_html | strip_newlines | replace: '  ', ' ' | replace: '  ', ' ' | replace: '  ', ' ' | strip -%}
        {%- unless dfaq_first -%},{%- endunless -%}
        {"@type":"Question","name":{{ block.settings.q | strip_html | strip_newlines | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ dfaq_answer | json }}}}
        {%- assign dfaq_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign dfaq_ld = dfaq_ld | strip_newlines | strip -%}
  {%- if dfaq_ld != blank -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ dfaq_ld }}]}</script>
  {%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo FAQ",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Structural clone of the reference FAQ: one centred heading, 7 rows separated by a top border, every row closed on load, several rows can be open at once, and a single plus marker that becomes a minus. Each question is a heading and the rows reveal themselves, staggered, when the band is scrolled to, the way the reference's animate-item rows do. The reference shows no eyebrow, no sub-line and no button here, so those three are empty by default." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "checkbox", "id": "heading_bold", "label": "Bold heading", "default": true, "info": "The reference wraps its heading in <strong>." },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "lg", "options": [
      { "value": "lg", "label": "Large (matches the reference)" },
      { "value": "md", "label": "Medium" }
    ] },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [
      { "value": "center", "label": "Centred (matches the reference)" },
      { "value": "left", "label": "Left" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "info": "Empty by default: the reference has no eyebrow above this heading." },
    { "type": "text", "id": "sub", "label": "Line under the heading (optional)", "info": "Empty by default: the reference has none." },
    { "type": "header", "content": "Rows" },
    { "type": "checkbox", "id": "single_open", "label": "Only one row open at a time", "default": false, "info": "Off matches the reference: each row is independent, so a visitor can leave several open." },
    { "type": "select", "id": "rows_style", "label": "Row style", "default": "border", "options": [
      { "value": "border", "label": "Top border between rows (matches the reference)" },
      { "value": "cards", "label": "Separate cards" }
    ] },
    { "type": "header", "content": "Delivery time" },
    { "type": "paragraph", "content": "The reference answers a delivery time and a rush fee in two of their rows. Ours ship without either, because the turnaround is yours to decide. Write one sentence here and it is added to the end of every row that has \"Add the delivery-time sentence\" ticked, so the same wording can never drift between rows." },
    { "type": "text", "id": "delivery", "label": "Delivery-time sentence", "info": "Empty by default on purpose. Example shape: The finished song and video are ready within X hours. Nothing is added while this is empty." },
    { "type": "header", "content": "Guarantee" },
    { "type": "paragraph", "content": "The same mechanism for anything you promise after the sale, such as a refund. Write it once here and it is added to the end of every row that has \"Add the guarantee sentence\" ticked. Empty by default, so no refund or guarantee wording ships until you write the one you will honour." },
    { "type": "text", "id": "guarantee", "label": "Guarantee sentence", "info": "Empty by default on purpose. Nothing is added while this is empty." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label (optional)", "info": "Empty by default: the reference shows no button under its FAQ. Fill it only if you want one here." },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "A text field, not a link picker, so an internal path such as /pages/couples works." },
    { "type": "checkbox", "id": "cta_popup", "label": "Button opens the preview pop-up", "default": true, "info": "Adds data-cs-open, the attribute the funnel listens for." },
    { "type": "header", "content": "Band" },
    { "type": "select", "id": "bg", "label": "Background", "default": "paper2", "options": [
      { "value": "paper2", "label": "Sand (matches the reference's secondary band)" },
      { "value": "paper", "label": "Paper" },
      { "value": "card", "label": "White" },
      { "value": "night", "label": "Night" }
    ] },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36, "info": "Phones use 75% of this value, the same rule the reference follows: 36 renders as 27px below 750px and 36px above it." },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 },
    { "type": "header", "content": "Search engines" },
    { "type": "checkbox", "id": "rich_snippet", "label": "Add FAQPage structured data", "default": false, "info": "Off by default because the reference page carries none (its only structured data is Organization and WebSite). Turn it on only while every question and answer on this page is true and visible, since the markup has to match what a visitor reads." }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "limit": 14, "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "A question your buyer actually asks" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>The answer, in plain words.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false, "info": "Off matches the reference: all of their rows load closed." },
      { "type": "checkbox", "id": "delivery_line", "label": "Add the delivery-time sentence", "default": false, "info": "Appends the section's \"Delivery-time sentence\" to this answer. Nothing is added while that setting is empty." },
      { "type": "checkbox", "id": "guarantee_line", "label": "Add the guarantee sentence", "default": false, "info": "Appends the section's \"Guarantee sentence\" to this answer. Nothing is added while that setting is empty." },
      { "type": "text", "id": "icon", "label": "Icon before the question (optional)", "info": "Empty by default: the reference renders an empty icon slot on every row. One character or emoji if you ever want one." }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo FAQ", "blocks": [
      { "type": "qa", "settings": { "q": "What makes this song and video ours?", "a": "<p>Both are built from your own answers about the two of you: your names, how you met, the lines you say to each other. Nothing is picked off a shelf, so nobody else has this song and nobody else has this video.</p>" } },
      { "type": "qa", "settings": { "q": "How long does it take?", "a": "<p>You hear a free preview before you pay anything, so you know what you are getting on the same visit.</p>", "delivery_line": true } },
      { "type": "qa", "settings": { "q": "What if we need it sooner?", "a": "<p>Tell us the date you need it for before you order.</p>" } },
      { "type": "qa", "settings": { "q": "What occasions does this work for?", "a": "<p>The moments where a card is not enough: a wedding and its first dance, an anniversary, an engagement, Valentine's Day, or a gift the two families give together.</p>" } },
      { "type": "qa", "settings": { "q": "How is it made?", "a": "<p>You answer a handful of plain questions about the two of you. Your answers become the lyrics, the lyrics become a finished song, and the song becomes an animated music video with a couple on screen built to look like you.</p>" } },
      { "type": "qa", "settings": { "q": "How do we get it?", "a": "<p>We email you a private link. Open it on any phone, tablet or computer to listen and watch, then share it however you like. Nothing to install.</p>" } },
      { "type": "qa", "settings": { "q": "Can we play it at the wedding?", "a": "<p>Yes. It is yours &mdash; the first dance, the reception, an anniversary dinner, or the car on the way home. Play it as often as you want.</p>" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-faq{--cs-duo-faq-max:820px;--cs-duo-faq-pt:36px;--cs-duo-faq-pb:36px}
.cs-dfaq--paper2{background:var(--cs-paper2)}
.cs-dfaq--paper{background:var(--cs-paper)}
.cs-dfaq--card{background:var(--cs-card)}
.cs-dfaq--night{background:var(--cs-night);color:var(--cs-night-ink)}
.cs-dfaq-band{padding-top:calc(var(--cs-duo-faq-pt) * .75);padding-bottom:calc(var(--cs-duo-faq-pb) * .75)}
@media screen and (min-width:750px){.cs-dfaq-band{padding-top:var(--cs-duo-faq-pt);padding-bottom:var(--cs-duo-faq-pb)}}
.cs-duo-faq .cs-dfaq-wrap{max-width:var(--cs-duo-faq-max)}
.cs-dfaq-head{margin:0 auto clamp(16px,2.2vw,24px)}
.cs-dfaq-head--center{text-align:center}
.cs-dfaq-head--left{text-align:left}
.cs-dfaq-h{margin:0}
.cs-dfaq-h strong{font-weight:700}
.cs-dfaq--night .cs-dfaq-h{color:var(--cs-night-ink)}
.cs-dfaq-head .cs-eyebrow{margin-bottom:10px}
.cs-dfaq-sub{margin-top:10px;color:var(--cs-ink2);font-size:1.05rem;line-height:1.55}
.cs-dfaq--night .cs-dfaq-sub{color:var(--cs-night-ink2)}
.cs-dfaq-list--border .cs-dfaq-row{border-top:1px solid var(--cs-line)}
.cs-dfaq--night .cs-dfaq-list--border .cs-dfaq-row{border-color:var(--cs-night-line)}
.cs-dfaq-list--cards{display:flex;flex-direction:column;gap:10px}
.cs-dfaq--night .cs-dfaq-list--cards .cs-dfaq-row{background:var(--cs-night-line);border-color:var(--cs-night-line)}
.cs-dfaq-list--cards .cs-dfaq-row{border:1px solid var(--cs-line);border-radius:var(--cs-r);background:var(--cs-card);box-shadow:var(--cs-sh-sm);overflow:hidden;padding:0 clamp(14px,2vw,20px)}
.cs-dfaq-details{display:block}
.cs-dfaq-summary{display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;list-style:none;padding:17px 2px;min-height:56px;-webkit-tap-highlight-color:transparent}
.cs-dfaq-summary::-webkit-details-marker{display:none}
.cs-dfaq-summary::marker{content:""}
.cs-dfaq-summary:focus-visible{outline:2px solid var(--cs-gold);outline-offset:2px;border-radius:6px}
.cs-dfaq-title{display:flex;align-items:center;gap:10px;min-width:0}
.cs-dfaq-ico{font-size:1.15rem;line-height:1;flex:0 0 auto}
.cs-dfaq-ico:empty{display:none}
.cs-duo-faq .cs-dfaq-q{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.02rem,1.7vw,1.22rem);line-height:1.26;letter-spacing:-.01em;overflow-wrap:anywhere;margin:0}
.cs-dfaq--night .cs-dfaq-q{color:var(--cs-night-ink)}
.cs-dfaq-plus{width:15px;height:15px;flex:0 0 15px;fill:currentColor}
.cs-dfaq-plus rect{transform-box:fill-box;transform-origin:center;transition:transform .2s ease}
.cs-dfaq-details[open] .cs-dfaq-plus-v{transform:scaleY(0)}
.cs-dfaq-js .cs-dfaq-details[open] .cs-dfaq-plus-v{transform:none}
.cs-dfaq-js .cs-dfaq-row.is-open .cs-dfaq-plus-v{transform:scaleY(0)}
.cs-dfaq-panel{overflow:hidden}
.cs-dfaq-js .cs-dfaq-panel{max-height:0;opacity:0;transition:max-height .3s ease,opacity .24s ease}
.cs-dfaq-js .cs-dfaq-row.is-open .cs-dfaq-panel{opacity:1}
.cs-dfaq-a{padding:0 2px 20px;color:var(--cs-ink2);font-size:1rem;line-height:1.62}
.cs-dfaq--night .cs-dfaq-a{color:var(--cs-night-ink2)}
.cs-dfaq-a p{margin:0 0 .7em}
.cs-dfaq-a p:last-child{margin-bottom:0}
.cs-dfaq-a a{color:inherit;text-decoration:underline;text-underline-offset:2px}
.cs-dfaq-a ul,.cs-dfaq-a ol{margin:0 0 .7em;padding-left:1.2em}
.cs-dfaq-cta{display:flex;justify-content:center;margin-top:clamp(20px,3vw,30px)}
.cs-dfaq-hint{margin-top:14px;font-size:.86rem;line-height:1.5;color:var(--cs-ink2);background:var(--cs-gold-soft);border:1px dashed var(--cs-gold);border-radius:var(--cs-r);padding:10px 12px}
@media (prefers-reduced-motion:no-preference){
  /* the reveal only exists once JS has added .cs-dfaq-reveal, so rows are never stuck hidden */
  .cs-dfaq-reveal .cs-dfaq-row{opacity:0}
  .cs-dfaq-reveal .cs-dfaq-row.cs-dfaq-shown{animation:cs-dfaq-in .5s ease both;animation-delay:calc(var(--cs-duo-faq-i,0) * .05s)}
}
@keyframes cs-dfaq-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
@media (max-width:560px){
  .cs-dfaq-cta{width:100%}
  .cs-dfaq-cta .cs-btn{width:100%}
  .cs-dfaq-summary{padding:15px 0;gap:12px}
  .cs-dfaq-a{padding:0 0 18px}
}

/* Question au corail du hero, reponse a l'encre pleine : les deux niveaux se
   distinguent au premier coup d'oeil au lieu de se fondre dans le papier. */
.cs.cs-duo-faq .cs-dfaq-q{color:var(--cs-coral)}
.cs.cs-duo-faq .cs-dfaq-a,.cs.cs-duo-faq .cs-dfaq-a *{color:var(--cs-ink)}
{% endstylesheet %}
{% javascript %}
(function () {
  var REDUCE = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function parts(row) {
    return {
      d: row.querySelector('[data-cs-dfaq-details]'),
      s: row.querySelector('[data-cs-dfaq-summary]'),
      w: row.querySelector('[data-cs-dfaq-panel]')
    };
  }

  function rowsOf(list) {
    return [].slice.call(list.querySelectorAll('[data-cs-dfaq-row]'));
  }

  function once(el, fn) {
    var done = false;
    function finish() {
      if (done) return;
      done = true;
      el.removeEventListener('transitionend', handler);
      fn();
    }
    function handler(ev) {
      if (ev.target !== el || ev.propertyName !== 'max-height') return;
      finish();
    }
    el.addEventListener('transitionend', handler);
    setTimeout(finish, 420);
  }

  function open(row, p) {
    p.d.open = true;
    row.classList.add('is-open');
    p.s.setAttribute('aria-expanded', 'true');
    if (REDUCE) { p.w.style.maxHeight = 'none'; return; }
    p.w.style.maxHeight = '0px';
    void p.w.offsetHeight;
    p.w.style.maxHeight = p.w.scrollHeight + 'px';
    once(p.w, function () {
      // let the panel grow with its content (images, resize) once it is fully open
      if (row.classList.contains('is-open')) p.w.style.maxHeight = 'none';
    });
  }

  function close(row, p) {
    row.classList.remove('is-open');
    p.s.setAttribute('aria-expanded', 'false');
    if (REDUCE) { p.w.style.maxHeight = '0px'; p.d.open = false; return; }
    p.w.style.maxHeight = p.w.scrollHeight + 'px';
    void p.w.offsetHeight;
    p.w.style.maxHeight = '0px';
    once(p.w, function () {
      // the row may have been reopened mid-animation
      if (!row.classList.contains('is-open')) p.d.open = false;
    });
  }

  function closeOthers(list, keep) {
    rowsOf(list).forEach(function (row) {
      if (row === keep) return;
      var p = parts(row);
      if (p.d && p.s && p.w && p.d.open) close(row, p);
    });
  }

  // the reference keeps its rows hidden until the band is scrolled to, then stagger them by --index
  function reveal(list, rows) {
    if (REDUCE || !('IntersectionObserver' in window) || !rows.length) return;
    var shown = false;
    var io = null;
    var safety = null;
    function show() {
      if (shown) return;
      shown = true;
      if (io) io.disconnect();
      if (safety) clearTimeout(safety);
      for (var i = 0; i < rows.length; i++) rows[i].classList.add('cs-dfaq-shown');
    }
    list.classList.add('cs-dfaq-reveal');
    io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { show(); return; }
      }
    }, { rootMargin: '0px 0px -60px 0px' });
    io.observe(list);
    // never leave the answers invisible if the observer never fires
    safety = setTimeout(show, 2500);
  }

  function setup(list) {
    if (!list || list.dataset.csDfaqOn === '1') return;
    list.dataset.csDfaqOn = '1';
    list.classList.add('cs-dfaq-js');
    var single = list.getAttribute('data-cs-dfaq-single') === '1';

    rowsOf(list).forEach(function (row) {
      var p = parts(row);
      if (!p.d || !p.s || !p.w) return;

      if (p.d.open) {
        row.classList.add('is-open');
        p.w.style.maxHeight = 'none';
        p.s.setAttribute('aria-expanded', 'true');
      } else {
        p.s.setAttribute('aria-expanded', 'false');
      }

      p.s.addEventListener('click', function (e) {
        // we drive the open state ourselves so the panel can animate both ways
        e.preventDefault();
        if (p.d.open && row.classList.contains('is-open')) {
          close(row, p);
        } else {
          if (single) closeOthers(list, row);
          open(row, p);
        }
      });
    });

    reveal(list, rowsOf(list));
  }

  function init(root) {
    var scope = root && root.querySelectorAll ? root : document;
    var list = scope.querySelectorAll('[data-cs-dfaq]');
    for (var i = 0; i < list.length; i++) setup(list[i]);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
  else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
