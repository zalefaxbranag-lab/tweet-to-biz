<div class="cs cs-duo-faq">
  <div class="cs-wrap">
    <div class="cs-sec">
      <div class="cs-sec-head">
        {%- if section.settings.eyebrow != blank -%}<span class="cs-eyebrow">✦ {{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cs-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>

      <div class="cs-df-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'qa' and block.settings.q != blank -%}
            <details class="cs-df-item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary class="cs-df-q"><span>{{ block.settings.q }}</span><span class="cs-df-mark" aria-hidden="true"></span></summary>
              {%- if block.settings.a != blank -%}<div class="cs-df-a">{{ block.settings.a }}</div>{%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <div class="cs-df-cta"><a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "CraftStory Duo FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you start" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The questions everyone asks" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "limit": 12, "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "A question" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>An answer.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo FAQ", "blocks": [
      { "type": "qa", "settings": { "q": "Do I have to be good with words?", "a": "<p>No. You are not writing anything. You answer five plain questions about the two of you, in your own words, and we turn those answers into lyrics.</p>", "open": true } },
      { "type": "qa", "settings": { "q": "Do the two of us really appear in the music video?", "a": "<p>Yes — that is the part nobody else does. The couple on screen is built to look like you, so the video tells your story instead of a stock one.</p>" } },
      { "type": "qa", "settings": { "q": "Can I choose the style?", "a": "<p>You pick the genre and the mood. Country, soul, pop, acoustic, rap — whatever they would actually put on.</p>" } },
      { "type": "qa", "settings": { "q": "What if I do not like it?", "a": "<p>You hear a free preview before you pay anything. If it is not right, you owe nothing, and if you have already ordered and you are not happy with it, you get a full refund.</p>" } },
      { "type": "qa", "settings": { "q": "What exactly do I receive?", "a": "<p>A full-length song and a music video, both about the two of you, yours to keep and to share.</p>" } },
      { "type": "qa", "settings": { "q": "Is it a good wedding gift?", "a": "<p>It is made for the moments where a card is not enough: a first dance, a wedding morning, an anniversary, or the gift the guests give together.</p>" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-faq{background:var(--cs-paper2)}
.cs-df-list{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.cs-df-item{background:var(--cs-card);border:1px solid var(--cs-line);border-radius:var(--cs-r);box-shadow:var(--cs-sh-sm);overflow:hidden}
.cs-df-q{cursor:pointer;list-style:none;display:flex;gap:14px;align-items:center;justify-content:space-between;padding:16px clamp(16px,2vw,22px);font-family:var(--cs-serif);font-weight:600;font-size:clamp(1rem,1.5vw,1.12rem);line-height:1.25;min-height:56px}
.cs-df-q::-webkit-details-marker{display:none}
.cs-df-mark{position:relative;width:16px;height:16px;flex:0 0 16px}
.cs-df-mark:before,.cs-df-mark:after{content:"";position:absolute;background:var(--cs-gold);border-radius:2px;transition:transform .2s ease}
.cs-df-mark:before{top:7px;left:0;width:16px;height:2px}
.cs-df-mark:after{left:7px;top:0;width:2px;height:16px}
.cs-df-item[open] .cs-df-mark:after{transform:scaleY(0)}
.cs-df-a{padding:0 clamp(16px,2vw,22px) 18px;color:var(--cs-ink2);font-size:1rem;line-height:1.6}
.cs-df-a p{margin:0 0 .7em}
.cs-df-a p:last-child{margin-bottom:0}
.cs-df-cta{display:flex;justify-content:center;margin-top:clamp(24px,4vw,38px)}
@media(max-width:560px){.cs-df-cta{width:100%}.cs-df-cta .cs-btn{width:100%}}
{% endstylesheet %}
