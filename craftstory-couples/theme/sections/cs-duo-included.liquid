{%- comment -%}
  CraftStory Duo Included — the "What's Included" HEADER ONLY.

  Section boundary, measured against the reference page:
    __rich_text_9jFJzw   -> this file. Renders exactly a centred h2 (with the <strong>
                            the reference wraps its heading in) and one h3 sub-line that
                            carries a deliberate line break. No list, no cards, no slider.
                            Padding 30/9 on a phone, 40/12 from 750px.
    __vinyl_music_player -> cs-duo-player.liquid. Sits BETWEEN the sub-line and the cards.
    __icon_bar_8DDc3p    -> cs-duo-trust.liquid, which already clones the three-card row
                            (27/24 -> 36/32 padding, 3 columns with a 4px gutter, two-up
                            snap carousel with dots AND arrows under the track on a phone,
                            24px edge bleed). The row lives there and nowhere else.

  An earlier pass welded the header and the card row into this one section. That both
  duplicated cs-duo-trust and made the reference order unreachable, because nothing can be
  inserted between two things inside a single section. The row, its carousel and its
  javascript block have been removed here rather than reimplemented.

  On the couples template this section belongs immediately before cs-duo-player.
{%- endcomment -%}

{%- liquid
  assign has_head = false
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.eyebrow != blank
    assign has_head = true
  endif
-%}
{%- if has_head or section.settings.cta_label != blank or request.design_mode -%}
<div class="cs cs-duo-included">
  <div class="cs-wrap">
    <div class="cs-di-sec">

      {%- if has_head -%}
        <div class="cs-di-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="cs-eyebrow cs-di-eyebrow">&#10022; {{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="cs-h1 cs-di-title"><strong>{{ section.settings.heading }}</strong></h2>
          {%- endif -%}
          {%- comment -%} An h3, the way the reference sets this sub-line inside .rich-text__text {%- endcomment -%}
          {%- if section.settings.subheading != blank -%}
            <h3 class="cs-di-sub">{{ section.settings.subheading | escape | newline_to_br }}</h3>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="cs-di-hint">Nothing to show yet. Theme editor &#9656; CraftStory Duo Included &#9656; fill Heading and Sub-line. This section is the heading above the player: the three "what you get" cards are a separate section (CraftStory Duo Trust), which is how the reference page is built.</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="cs-di-ctas">
          <a class="cs-btn cs-btn-primary cs-btn-lg cs-di-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
          {%- if section.settings.cta_note != blank -%}
            <span class="cs-di-note">{{ section.settings.cta_note }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo Included",
  "settings": [
    { "type": "paragraph", "content": "The heading above the player: a centred title and one sub-line saying how delivery works. Same shape as the reference, which puts only these two lines in this slot. The three \"what you get\" cards are their own section (CraftStory Duo Trust) and the player sits between the two. Keep CraftStory Setup as the first section of the template." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Empty on purpose: the reference section has no eyebrow above this heading. Leave it empty to keep that rhythm." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What’s Included in Your Song & Video" },
    { "type": "textarea", "id": "subheading", "label": "Sub-line", "default": "When your song and video are ready, we email you\none private link to listen, watch and share.", "info": "Press Enter where the line should break: the reference breaks this sentence in two on purpose. Says how delivery works, not how fast — do not add a turnaround time here until it is one we keep." },
    { "type": "header", "content": "Button (optional)" },
    { "type": "paragraph", "content": "The reference section renders no button, and this page already has the CraftStory Duo Bar fixed at the bottom. Leave the label empty unless you want a second call to action inside this section." },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" },
    { "type": "text", "id": "cta_note", "label": "Line under the button" }
  ],
  "presets": [
    { "name": "CraftStory Duo Included" }
  ]
}
{% endschema %}
{% stylesheet %}
/* their rhythm, measured: this heading block is 30px top / 9px bottom on a phone
   (40 / 12 from 750px). The gap down to the cards is the next section's own top padding,
   so nothing is added under the sub-line here. */
.cs-duo-included{background:var(--cs-paper)}
.cs-di-sec{padding:30px 0 9px}
.cs-di-head{max-width:720px;margin:0 auto;text-align:center;
  display:flex;flex-direction:column;align-items:center;gap:12px}
.cs-di-eyebrow{align-self:center}
.cs-di-title{text-wrap:balance}
.cs-di-title strong{font-weight:700}
/* their sub-line is an h3, so it stays in the heading font and clearly above body size.
   Two classes, to outrank the `.cs h3` base rule on line-height and letter-spacing. */
.cs .cs-di-sub{font-family:var(--cs-serif);font-weight:600;letter-spacing:-.01em;
  font-size:clamp(1.05rem,3.1vw,1.34rem);line-height:1.34;color:var(--cs-ink);
  max-width:24em;margin:0;text-wrap:balance}

.cs-di-ctas{display:flex;flex-direction:column;align-items:center;gap:9px;margin-top:22px}
.cs-di-cta{width:100%;max-width:420px}
.cs-di-note{font-size:.84rem;font-weight:600;color:var(--cs-ink2);line-height:1.4;text-align:center}
/* design mode only: never rendered for a visitor */
.cs-di-hint{max-width:40em;margin:14px auto 0;text-align:center;font-size:.78rem;font-weight:600;
  line-height:1.45;color:var(--cs-ink2);background:var(--cs-paper2);
  border:1px dashed var(--cs-line);border-radius:var(--cs-r);padding:10px 14px}

@media(min-width:750px){
  .cs-di-sec{padding:40px 0 12px}
}
{% endstylesheet %}
