{%- liquid
  assign cols_d = section.settings.cols_desktop | default: 3
  assign cols_m = section.settings.cols_mobile | default: 2
  assign gap_d = section.settings.gap_desktop | default: 4
  assign gap_m = section.settings.gap_mobile | default: 15

  # an item counts as filled once it says something: an icon alone is not content
  assign filled = 0
  for block in section.blocks
    if block.type == 'item'
      if block.settings.title != blank or block.settings.body != blank
        assign filled = filled | plus: 1
      endif
    endif
  endfor

  # mobile dots: one page per scroll position, the way their slider pages 2-up
  assign pages = filled | minus: cols_m | plus: 1
  if pages < 1
    assign pages = 1
  endif

  assign has_head = false
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.eyebrow != blank
    assign has_head = true
  endif

  assign uid = section.id | replace: '_', '' | downcase
-%}
{%- if filled > 0 or has_head or request.design_mode -%}
<div class="cs cs-duo-included">
  <div class="cs-wrap">
    <div class="cs-di-sec">

      {%- if has_head -%}
        <div class="cs-di-head">
          {%- if section.settings.eyebrow != blank -%}
            <span class="cs-eyebrow cs-di-eyebrow">&#10022; {{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="cs-h1 cs-di-title"><strong>{{ section.settings.heading }}</strong></h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="cs-di-sub">{{ section.settings.subheading | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if filled > 0 -%}
        <div class="cs-di-slider"
             id="cs-di-{{ uid }}"
             role="region"
             aria-roledescription="carousel"
             aria-label="{{ section.settings.carousel_label | default: 'What is included' | escape }}"
             data-cs-di
             data-slides="{{ filled }}"
             style="--cs-di-cols-d:{{ cols_d }};--cs-di-cols-m:{{ cols_m }};--cs-di-gap-d:{{ gap_d }}px;--cs-di-gap-m:{{ gap_m }}px">

          <ul class="cs-di-track cs-di-ico-{{ section.settings.icon_color }}" data-cs-di-track tabindex="0">
            {%- assign idx = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'item' -%}
                {%- if block.settings.title != blank or block.settings.body != blank -%}
                  {%- assign idx = idx | plus: 1 -%}
                  <li class="cs-di-slide" id="cs-di-{{ uid }}-{{ idx }}" {{ block.shopify_attributes }}>
                    <div class="cs-di-card">
                      <span class="cs-di-ico" aria-hidden="true">
                        {%- case block.settings.icon -%}
                          {%- when 'music' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm3.4 4.6v6.9a2.6 2.6 0 11-1.6-2.4V9l-3.6.9v5.1a2.6 2.6 0 11-1.6-2.4V8.5l6.8-1.9z"/></svg>
                          {%- when 'video' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-2 5.9l6.2 4.1L10 16.1V7.9z"/></svg>
                          {%- when 'heart' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 15.3l-3.9-3.7a2.7 2.7 0 113.9-3.7 2.7 2.7 0 113.9 3.7L12 17.3z"/></svg>
                          {%- when 'mail' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zM6.6 8.4h10.8v.5L12 12.6 6.6 8.9v-.5zm0 2.6L12 14.6l5.4-3.6v4.6H6.6V11z"/></svg>
                          {%- when 'gift' -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zM7 10.4h4.2v1.1H7v-1.1zm5.8 0H17v1.1h-4.2v-1.1zM7.6 12.6h3.6v4.2H7.6v-4.2zm5.2 0h3.6v4.2h-3.6v-4.2zM12 6.6c1 0 1.9.8 1.9 1.8h-3.8c0-1 .9-1.8 1.9-1.8z"/></svg>
                          {%- else -%}
                            <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-1.1 14.6l-4-4 1.5-1.5 2.5 2.5 5.3-5.3 1.5 1.5-6.8 6.8z"/></svg>
                        {%- endcase -%}
                      </span>
                      {%- if block.settings.title != blank -%}
                        <h3 class="cs-di-t">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.body != blank -%}
                        <p class="cs-di-b">{{ block.settings.body }}</p>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>

          <div class="cs-di-nav"{% if pages <= 1 %} hidden{% endif %} data-cs-di-nav>
            <ul class="cs-di-dots" role="tablist" aria-label="{{ section.settings.dots_label | default: 'Select a slide to show' | escape }}" data-cs-di-dots>
              {%- for i in (1..pages) -%}
                <li role="presentation">
                  <button class="cs-di-dot{% if forloop.first %} is-active{% endif %}" type="button" role="tab"
                          aria-controls="cs-di-{{ uid }}-{{ i }}" aria-label="Go to slide {{ i }}"
                          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}></button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- elsif request.design_mode -%}
        <p class="cs-di-hint">No items yet. Theme editor &#9656; CraftStory Duo Included &#9656; Add block &#9656; Included item, then fill the title and the line under it. Three or four items match the reference row.</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="cs-di-ctas">
          <a class="cs-btn cs-btn-primary cs-btn-lg cs-di-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
          {%- if section.settings.cta_note != blank -%}
            <span class="cs-di-note">{{ section.settings.cta_note }}</span>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="cs-di-hint">Button under the row: empty on purpose, because the reference section has none and the page already carries one bottom bar (CraftStory Duo Bar). Fill "Button label" only if you want a second call to action here.</p>
      {%- endif -%}

    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo Included",
  "settings": [
    { "type": "paragraph", "content": "What the customer receives. Same shape as the reference: a centred heading, one sub-line under it, then a row of items with an icon, a title and one line of detail. Three items sit side by side from 750px up; on a phone the row becomes a swipeable 2-up carousel with dots. Keep CraftStory Setup as the first section of the template." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Empty on purpose: the reference section has no eyebrow above this heading. Leave it empty to keep that rhythm." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Included in Your Song & Video" },
    { "type": "textarea", "id": "subheading", "label": "Sub-line", "default": "When your song and video are ready, we email you\none private link to listen, watch and share.", "info": "Press Enter where the line should break: the reference breaks this sentence in two on purpose. Says how delivery works, not how fast — do not add a turnaround time here until it is one we keep." },
    { "type": "header", "content": "Row layout" },
    { "type": "range", "id": "cols_desktop", "label": "Items per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3, "info": "3 matches the reference." },
    { "type": "range", "id": "cols_mobile", "label": "Items per view (mobile)", "min": 1, "max": 2, "step": 1, "default": 2, "info": "2 matches the reference: two narrow items, swipe for the rest." },
    { "type": "range", "id": "gap_desktop", "label": "Gap (desktop)", "min": 0, "max": 40, "step": 2, "default": 4, "unit": "px" },
    { "type": "range", "id": "gap_mobile", "label": "Gap (mobile)", "min": 8, "max": 32, "step": 1, "default": 15, "unit": "px" },
    { "type": "select", "id": "icon_color", "label": "Icon colour", "options": [
      { "value": "gold", "label": "Gold" },
      { "value": "coral", "label": "Coral" },
      { "value": "ink", "label": "Ink" }
    ], "default": "gold", "info": "Gold keeps coral for the one call to action on the page." },
    { "type": "header", "content": "Button (optional)" },
    { "type": "paragraph", "content": "The reference section renders no button, and this page already has the CraftStory Duo Bar fixed at the bottom. Leave the label empty unless you want a second call to action inside this section." },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" },
    { "type": "text", "id": "cta_note", "label": "Line under the button" },
    { "type": "header", "content": "Labels for screen readers" },
    { "type": "text", "id": "carousel_label", "label": "Carousel label", "default": "What is included" },
    { "type": "text", "id": "dots_label", "label": "Dots label", "default": "Select a slide to show" }
  ],
  "blocks": [
    { "type": "item", "name": "Included item", "limit": 8, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "check", "label": "Check" },
        { "value": "music", "label": "Music note" },
        { "value": "video", "label": "Play / video" },
        { "value": "heart", "label": "Heart" },
        { "value": "mail", "label": "Email" },
        { "value": "gift", "label": "Gift" }
      ], "default": "check", "info": "The reference uses the same check on every item. Mixing icons is allowed but breaks that rhythm." },
      { "type": "text", "id": "title", "label": "Title", "default": "Studio-Quality Song" },
      { "type": "textarea", "id": "body", "label": "One line of detail", "default": "A finished, produced track about the two of you." }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Included", "blocks": [
      { "type": "item", "settings": { "icon": "check", "title": "Studio-Quality Song", "body": "A finished, produced track about the two of you, made to be played out loud." } },
      { "type": "item", "settings": { "icon": "check", "title": "Lyrics Written From Your Story", "body": "Every line comes from your answers: their name, your places, the moments only you two know." } },
      { "type": "item", "settings": { "icon": "check", "title": "An Animated Music Video", "body": "Your song set to an animated video, with the two of you on screen scene by scene." } },
      { "type": "item", "settings": { "icon": "check", "title": "Yours To Keep And Share", "body": "One private link by email: listen, watch, download and send it to whoever you want." } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-included{background:var(--cs-paper)}
/* their rhythm, measured: heading block 30px top / 9px bottom on a phone (40 / 12 from 750px),
   icon row 27px top / 24px bottom (36 / 32 from 750px). Merged into one section below. */
.cs-di-sec{padding:30px 0 24px}
.cs-di-head{max-width:720px;margin:0 auto 36px;text-align:center;
  display:flex;flex-direction:column;align-items:center;gap:12px}
.cs-di-eyebrow{align-self:center}
.cs-di-title{text-wrap:balance}
.cs-di-title strong{font-weight:700}
/* their sub-line is an h3, so it stays in the heading font and clearly above body size */
.cs-di-sub{font-family:var(--cs-serif);font-weight:600;letter-spacing:-.01em;
  font-size:clamp(1.05rem,3.1vw,1.34rem);line-height:1.34;color:var(--cs-ink);
  max-width:24em;text-wrap:balance}

.cs-di-slider{--cs-di-c:var(--cs-di-cols-m,2);--cs-di-g:var(--cs-di-gap-m,15px);position:relative}
.cs-di-track{
  list-style:none;margin:0;padding:2px 0 4px;
  display:flex;align-items:stretch;gap:var(--cs-di-g);
  overflow-x:auto;overscroll-behavior-x:contain;
  scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
  scrollbar-width:none
}
.cs-di-track::-webkit-scrollbar{display:none}
.cs-di-track:focus-visible{outline:2px solid var(--cs-coral);outline-offset:3px;border-radius:var(--cs-r)}
.cs-di-slide{
  flex:0 0 calc((100% - (var(--cs-di-c) - 1) * var(--cs-di-g)) / var(--cs-di-c));
  min-width:0;scroll-snap-align:start
}
/* the card carries no chrome: they paint it the same colour as the section, so the items
   read as three bare columns of text rather than as boxes */
.cs-di-card{display:flex;flex-direction:column;align-items:center;text-align:center;
  gap:9px;padding:16px 10px;height:100%}
.cs-di-ico{display:block;width:clamp(34px,7vw,40px);height:clamp(34px,7vw,40px);flex:0 0 auto;
  color:var(--cs-gold)}
.cs-di-ico svg{width:100%;height:100%;display:block}
.cs-di-ico-coral .cs-di-ico{color:var(--cs-coral)}
.cs-di-ico-ink .cs-di-ico{color:var(--cs-ink)}
.cs-di-t{font-family:var(--cs-serif);font-weight:700;letter-spacing:-.01em;
  font-size:clamp(.98rem,2.8vw,1.14rem);line-height:1.2;color:var(--cs-ink);text-wrap:balance}
.cs-di-b{font-size:clamp(.84rem,2.4vw,.95rem);line-height:1.5;color:var(--cs-ink2)}

.cs-di-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:14px}
.cs-di-nav[hidden]{display:none}
.cs-di-dots{display:flex;align-items:center;justify-content:center;gap:8px;list-style:none;margin:0;padding:0}
.cs-di-dot{width:9px;height:9px;padding:0;border:0;border-radius:var(--cs-pill);cursor:pointer;
  background:var(--cs-ink3);opacity:.34;transition:opacity .18s,background .18s,width .18s}
.cs-di-dot:hover{opacity:.6}
.cs-di-dot.is-active{background:var(--cs-coral);opacity:1;width:24px}
.cs-di-dot:focus-visible{outline:2px solid var(--cs-coral);outline-offset:3px}

.cs-di-ctas{display:flex;flex-direction:column;align-items:center;gap:9px;margin-top:22px}
.cs-di-cta{width:100%;max-width:420px}
.cs-di-note{font-size:.84rem;font-weight:600;color:var(--cs-ink2);line-height:1.4;text-align:center}
/* design mode only: never rendered for a visitor */
.cs-di-hint{max-width:40em;margin:14px auto 0;text-align:center;font-size:.78rem;font-weight:600;
  line-height:1.45;color:var(--cs-ink2);background:var(--cs-paper2);
  border:1px dashed var(--cs-line);border-radius:var(--cs-r);padding:10px 14px}

/* 750px is their breakpoint: the slider is destroyed and the items become a plain row */
@media(min-width:750px){
  .cs-di-sec{padding:40px 0 32px}
  .cs-di-head{margin-bottom:48px}
  .cs-di-slider{--cs-di-c:var(--cs-di-cols-d,3);--cs-di-g:var(--cs-di-gap-d,4px)}
  .cs-di-track{flex-wrap:wrap;justify-content:center;overflow:visible;
    scroll-snap-type:none;padding:0;row-gap:24px}
  .cs-di-slide{scroll-snap-align:none}
  .cs-di-nav{display:none}
  .cs-di-card{padding:0 16px}
}
{% endstylesheet %}
{% javascript %}
(function () {
  var SMOOTH = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

  function setup(slider) {
    if (!slider || slider.dataset.csDiOn === '1') return;
    slider.dataset.csDiOn = '1';

    var track = slider.querySelector('[data-cs-di-track]');
    var nav = slider.querySelector('[data-cs-di-nav]');
    var dotList = slider.querySelector('[data-cs-di-dots]');
    if (!track || !dotList) return;

    var slides = [].slice.call(track.children);
    if (!slides.length) return;

    var pages = 1;

    function step() {
      if (slides.length < 2) return slides[0].getBoundingClientRect().width;
      return slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left;
    }

    // Slides are sized so N fit exactly per view, so N falls out of the geometry.
    function measure() {
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      var s = step();
      var perView = s > 0 ? Math.max(1, Math.round((track.clientWidth + gap) / s)) : 1;
      pages = Math.max(1, slides.length - perView + 1);
      // no overflow (desktop row, or fewer items than fit) means no navigation
      if (track.scrollWidth <= track.clientWidth + 2) pages = 1;
      return pages;
    }

    function buildDots() {
      if (nav) {
        if (pages <= 1) nav.setAttribute('hidden', '');
        else nav.removeAttribute('hidden');
      }
      if (dotList.children.length === pages) return;
      var label = dotList.getAttribute('data-go-label') || 'Go to slide ';
      dotList.innerHTML = '';
      for (var i = 0; i < pages; i++) {
        var li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'cs-di-dot' + (i === 0 ? ' is-active' : '');
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-label', label + (i + 1));
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        if (i !== 0) b.setAttribute('tabindex', '-1');
        if (slides[i] && slides[i].id) b.setAttribute('aria-controls', slides[i].id);
        li.appendChild(b);
        dotList.appendChild(li);
      }
    }

    function paint() {
      var s = step();
      var at = s > 0 ? Math.round(track.scrollLeft / s) : 0;
      if (at > pages - 1) at = pages - 1;
      if (at < 0) at = 0;
      var dots = dotList.querySelectorAll('.cs-di-dot');
      for (var i = 0; i < dots.length; i++) {
        var on = i === at;
        dots[i].classList.toggle('is-active', on);
        dots[i].setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) dots[i].removeAttribute('tabindex');
        else dots[i].setAttribute('tabindex', '-1');
      }
    }

    function go(i) {
      var s = step();
      if (s <= 0) return;
      var left = Math.round(i * s);
      if (track.scrollTo) track.scrollTo({ left: left, behavior: SMOOTH ? 'smooth' : 'auto' });
      else track.scrollLeft = left;
    }

    dotList.addEventListener('click', function (e) {
      var b = e.target && e.target.closest ? e.target.closest('.cs-di-dot') : null;
      if (!b) return;
      var dots = [].slice.call(dotList.querySelectorAll('.cs-di-dot'));
      var i = dots.indexOf(b);
      if (i > -1) go(i);
    });

    var raf = 0;
    track.addEventListener('scroll', function () {
      if (raf) return;
      raf = window.requestAnimationFrame(function () { raf = 0; paint(); });
    }, { passive: true });

    var t = 0;
    window.addEventListener('resize', function () {
      if (t) clearTimeout(t);
      t = setTimeout(function () { measure(); buildDots(); paint(); }, 150);
    });

    measure();
    buildDots();
    paint();
  }

  function init(root) {
    var scope = root && root.querySelectorAll ? root : document;
    var list = scope.querySelectorAll('[data-cs-di]');
    for (var i = 0; i < list.length; i++) setup(list[i]);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(document); });
  else init(document);
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
