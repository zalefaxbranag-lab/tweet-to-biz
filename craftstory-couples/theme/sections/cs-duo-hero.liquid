<section class="cs cs-duo-hero" aria-label="Custom song and animated video for couples" data-cs-dh-root>
  <div class="cs-dh-inner">

    {%- if section.settings.badge != blank -%}
      <p class="cs-dh-badge">
        {%- if section.settings.badge_stars -%}<span class="cs-dh-badge-stars" aria-hidden="true">★★★★★</span>{%- endif -%}
        {{ section.settings.badge }}
      </p>
    {%- elsif section.settings.eyebrow != blank -%}
      <span class="cs-eyebrow cs-dh-eyebrow">✦ {{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- assign dh_cover = section.settings.cover -%}
    {%- assign dh_has_clip = false -%}
    {%- if section.settings.video != blank or section.settings.video_url != blank -%}
      {%- assign dh_has_clip = true -%}
    {%- endif -%}
    {%- comment -%} no clip and no poster: nothing is rendered for a visitor, the placeholder is editor-only {%- endcomment -%}
    {%- if dh_has_clip or dh_cover != blank or request.design_mode -%}
      <div class="cs-dh-videowrap">
        {%- if dh_has_clip -%}
          <div class="cs-dh-stage{% if section.settings.autoplay %} cs-dh-auto{% endif %}" id="csDhStage-{{ section.id }}" data-cs-dh-stage{% if section.settings.autoplay %} data-cs-dh-auto{% endif %}>
            {%- if section.settings.video != blank -%}
              {%- if section.settings.autoplay -%}
                {{ section.settings.video | video_tag: controls: false, autoplay: true, muted: true, loop: true, playsinline: true, preload: 'auto', image_size: '1600x', class: 'cs-dh-video' }}
              {%- else -%}
                {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1600x', class: 'cs-dh-video' }}
              {%- endif -%}
            {%- else -%}
              <video class="cs-dh-video" id="csDhVideo-{{ section.id }}"{% if section.settings.autoplay %} autoplay muted loop playsinline preload="auto" disableremoteplayback controlslist="noremoteplayback" x-webkit-airplay="deny"{% else %} controls playsinline preload="metadata"{% endif %}{% if dh_cover != blank %} poster="{{ dh_cover | image_url: width: 1600 }}"{% endif %}><source src="{{ section.settings.video_url | escape }}" type="video/mp4"></video>
            {%- endif -%}

            {%- if section.settings.autoplay -%}
              <button type="button" class="cs-dh-unmute" id="csDhUnmute-{{ section.id }}" data-cs-dh-unmute aria-label="Unmute video">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                <span>{{ section.settings.unmute_label | default: 'Tap to unmute' }}</span>
              </button>

              {%- comment -%} custom controls bar: play/pause, seek, re-mute — the reference's three children {%- endcomment -%}
              <div class="cs-dh-controls" id="csDhControls-{{ section.id }}" data-cs-dh-controls>
                <button type="button" class="cs-dh-vidbtn" id="csDhPlayBtn-{{ section.id }}" data-cs-dh-playbtn aria-label="Pause video">
                  <svg id="csDhPauseIcon-{{ section.id }}" data-cs-dh-pauseicon viewBox="0 0 24 24" aria-hidden="true" style="display:block"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                  <svg id="csDhPlayIcon-{{ section.id }}" data-cs-dh-playicon viewBox="0 0 24 24" aria-hidden="true" style="display:none"><polygon points="5,3 19,12 5,21"/></svg>
                </button>
                <div class="cs-dh-progress" id="csDhProgress-{{ section.id }}" data-cs-dh-progress>
                  <div class="cs-dh-progress-fill" id="csDhProgressFill-{{ section.id }}" data-cs-dh-progressfill></div>
                </div>
                <button type="button" class="cs-dh-vidbtn" id="csDhMuteBtn-{{ section.id }}" data-cs-dh-mutebtn aria-label="Unmute video">
                  <svg id="csDhMutedIcon-{{ section.id }}" data-cs-dh-mutedicon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:block"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                  <svg id="csDhUnmutedIcon-{{ section.id }}" data-cs-dh-unmutedicon viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16 8.6a4.5 4.5 0 0 1 0 6.8m2.7-9.6a8 8 0 0 1 0 12.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
                </button>
              </div>
            {%- else -%}
              <button type="button" class="cs-dh-cover" data-cs-dh-trigger aria-label="{{ section.settings.play_label | default: 'Play' | escape }}">
                {%- if dh_cover != blank -%}<img src="{{ dh_cover | image_url: width: 1600 }}" alt="{{ dh_cover.alt | default: 'Preview' | escape }}" loading="eager">{%- endif -%}
                <span class="cs-dh-scrim"></span>
                <span class="cs-dh-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
              </button>
            {%- endif -%}
          </div>
        {%- elsif dh_cover != blank -%}
          <div class="cs-dh-stage cs-dh-still"><img src="{{ dh_cover | image_url: width: 1600 }}" alt="{{ dh_cover.alt | default: 'Preview' | escape }}" width="{{ dh_cover.width }}" height="{{ dh_cover.height }}" loading="eager"></div>
        {%- else -%}
          <div class="cs-dh-stage cs-dh-still cs-dh-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9l5 3-5 3z" stroke-linejoin="round"/></svg>
            <span>Add the hero clip — Theme editor ▸ CraftStory Duo Hero ▸ Hero video</span>
          </div>
        {%- endif -%}
        {%- if section.settings.clip_caption != blank -%}
          <span class="cs-dh-clipcap">{{ section.settings.clip_caption }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="cs-dh-title">
        {%- if section.settings.quote_style -%}<span class="cs-dh-q" aria-hidden="true">“</span>{%- endif -%}
        {{ section.settings.heading }}
        {%- if section.settings.highlight != blank -%} <em>{{ section.settings.highlight }}</em>{%- endif -%}
        {%- if section.settings.quote_style -%}<span class="cs-dh-q" aria-hidden="true">”</span>{%- endif -%}
      </h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}<p class="cs-dh-sub">{{ section.settings.body }}</p>{%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="cs-dh-ctas">
        <a class="cs-dh-cta" href="{{ section.settings.cta_link | default: '#' }}">
          {%- if section.settings.cta_icon != blank -%}<span class="cs-dh-cta-ico" aria-hidden="true">{{ section.settings.cta_icon }}</span>{%- endif -%}
          <span>{{ section.settings.cta_label }}</span>
        </a>
        {%- if section.settings.cta_note != blank -%}
          <span class="cs-dh-ctasub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-1 14.6l-4-4 1.4-1.4 2.6 2.6 5.6-5.6L18 9.6l-7 7z"/></svg>
            {{ section.settings.cta_note }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign faces = 0
      for block in section.blocks
        if block.type == 'face' and block.settings.image != blank
          assign faces = faces | plus: 1
        endif
      endfor

      # star row: blank setting means no rating is claimed, so the row is not rendered
      assign star_count = section.settings.proof_stars | times: 1 | floor
      if star_count > 5
        assign star_count = 5
      endif

      # join line: plain word, then the bold part that carries the number, then an optional plain tail
      assign proof_line = false
      if section.settings.proof_strong != blank or section.settings.proof_text != blank
        assign proof_line = true
      endif

      assign proof_any = false
      if faces > 0 or star_count > 0 or proof_line
        assign proof_any = true
      endif
    -%}
    {%- if proof_any -%}
      <div class="cs-dh-proof">
        {%- if faces > 0 -%}
          <div class="cs-dh-faces">
            {%- for block in section.blocks -%}
              {%- if block.type == 'face' and block.settings.image != blank -%}
                <img class="cs-dh-face" src="{{ block.settings.image | image_url: width: 120 }}" alt="" loading="lazy" {{ block.shopify_attributes }}>
              {%- endif -%}
            {%- endfor -%}
            {%- if section.settings.faces_count != blank -%}
              <span class="cs-dh-facecount">{{ section.settings.faces_count }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if star_count > 0 or proof_line -%}
          <div class="cs-dh-prooftxt">
            {%- if star_count > 0 -%}
              <span class="cs-dh-proofstars" role="img" aria-label="{{ star_count }} out of 5 stars">{% for i in (1..star_count) %}★{% endfor %}</span>
            {%- endif -%}
            {%- if proof_line -%}
              <span class="cs-dh-prooflabel">
                {%- if section.settings.proof_prefix != blank -%}{{ section.settings.proof_prefix }} {% endif -%}
                {%- if section.settings.proof_strong != blank -%}<strong>{{ section.settings.proof_strong }}</strong>{%- endif -%}
                {%- if section.settings.proof_text != blank -%}{% if section.settings.proof_strong != blank %} {% endif %}{{ section.settings.proof_text }}{%- endif -%}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="cs-dh-proofhint">Social proof row (faces, star row, join line) is hidden because it is empty. Theme editor &#9656; CraftStory Duo Hero &#9656; Social proof: add Customer face blocks, set Star row, and fill the Join line. Leave them empty until the reviews and the count are real.</p>
    {%- endif -%}

    {%- if section.settings.trust_line != blank -%}
      {%- assign trust_bits = section.settings.trust_line | split: '|' -%}
      <p class="cs-dh-trust">
        {%- for bit in trust_bits -%}
          {%- unless forloop.first -%}<span class="cs-dh-sep" aria-hidden="true"></span>{%- endunless -%}
          <span>{{ bit | strip }}</span>
        {%- endfor -%}
      </p>
    {%- endif -%}

  </div>
</section>
{% schema %}
{
  "name": "CraftStory Duo Hero",
  "settings": [
    { "type": "paragraph", "content": "One centred column, the way a landing-page hero is built: star line, clip, headline, sub-headline, one full-width button, guarantee, social proof, trust line. Keep CraftStory Setup as the first section of the template." },
    { "type": "header", "content": "Star line" },
    { "type": "text", "id": "badge", "label": "Star line", "info": "Replaces the eyebrow. Leave it empty until the claim is true — no invented customer counts, song counts or ratings." },
    { "type": "checkbox", "id": "badge_stars", "label": "Show five stars in the star line", "default": false, "info": "Off until there are real reviews behind it. Filling the star line does not by itself earn a five-star row." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (fallback)", "default": "" },
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Turn your love story into a song and an animated music video", "info": "A promise, in our own voice. The day a real customer sentence exists, paste it here, put the last words in the field below and switch the quote marks on." },
    { "type": "text", "id": "highlight", "label": "Last word, emphasised", "default": "", "info": "Rendered in italic coral at the end of the headline." },
    { "type": "checkbox", "id": "quote_style", "label": "Wrap the headline in quote marks", "default": false, "info": "Turn this on only when the headline is a sentence a real customer actually said. Off by default, because the quote marks claim someone said it." },
    { "type": "textarea", "id": "body", "label": "Sub-headline", "default": "Tell us about the two of you and add a photo — we'll turn your story into a song and an animated music video." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_icon", "label": "Icon before the label", "default": "♫" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Our Music Video" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" },
    { "type": "text", "id": "cta_note", "label": "Line under the button", "default": "100% money-back guarantee · Delivered by email" },
    { "type": "header", "content": "Social proof" },
    { "type": "paragraph", "content": "Three rows, in the reference order: the face row, then the gold star row directly under it, then the join line. Every part starts empty and hides itself while it is empty, so the cluster only appears once the numbers are real. Add a face only when it is a real customer who agreed to it." },
    { "type": "text", "id": "faces_count", "label": "Count bubble", "info": "For example 50+. Sits at the end of the face row. Leave empty until the number is real." },
    { "type": "text", "id": "proof_stars", "label": "Star row (1-5)", "info": "Type 5 to show the five-gold-star row directly under the faces. Leave empty until you have real reviews behind it — empty means the row is not rendered at all." },
    { "type": "text", "id": "proof_prefix", "label": "Join line — plain first word", "default": "Join", "info": "Plain text before the bold part, the way the reference starts the line with Join. On its own it renders nothing." },
    { "type": "text", "id": "proof_strong", "label": "Join line — bold part", "info": "The number and the phrase after it, all in bold, so the count is what the eye lands on. Fill it the day the count is real, in this shape: <count> couples who turned their story into a song. No number here until it is one we can stand behind." },
    { "type": "text", "id": "proof_text", "label": "Join line — plain tail (optional)", "info": "Anything that should stay unbolded after the bold part." },
    { "type": "header", "content": "Trust line" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Different stories. Different songs. One video: the two of you.", "info": "Three parts separated by a vertical bar, split the way the reference splits it: speed, then shipping, then the occasions. Each part gets a dot between, and at phone width the occasions drop onto a second line on their own. Do not put a turnaround promise here until it is one we keep." },
    { "type": "header", "content": "Hero video" },
    { "type": "checkbox", "id": "autoplay", "label": "Play silently on load, with a Tap-to-unmute button", "default": true, "info": "How the competitor's hero works. The clip loops muted, and one tap turns the sound on." },
    { "type": "text", "id": "unmute_label", "label": "Unmute button label", "default": "Tap to unmute" },
    { "type": "video", "id": "video", "label": "Hero clip (upload MP4)", "info": "Landscape. The clip keeps its own proportions and is never cropped, so upload it at the shape you want shown." },
    { "type": "text", "id": "video_url", "label": "…or .mp4 URL" },
    { "type": "image_picker", "id": "cover", "label": "Thumbnail (poster)" },
    { "type": "text", "id": "play_label", "label": "Play-button label (for screen readers)", "default": "Play" },
    { "type": "text", "id": "clip_caption", "label": "Caption over the clip", "default": "Watch the 40-second trailer", "info": "White bold line at the bottom left of the clip, the way the kids page labels its trailer. Leave empty to hide it." }
  ],
  "blocks": [
    { "type": "face", "name": "Customer face", "limit": 8, "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "A real customer who agreed to appear here." }
    ] }
  ],
  "presets": [ { "name": "CraftStory Duo Hero" } ]
}
{% endschema %}
{% stylesheet %}
/* full-viewport, vertically centred panel; content-height under 600px */
.cs-duo-hero{position:relative;box-sizing:border-box;width:100%;min-height:100vh;min-height:100svh;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
  padding:10px 10px 10px;
  background:
  radial-gradient(120% 80% at 50% 0%,rgba(236,91,60,.09),transparent 62%),
  var(--cs-paper);
  --cs-duo-green:#3E9C6A}
.cs-dh-inner{position:relative;z-index:1;max-width:720px;width:100%;margin:0 auto;
  display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}
/* Visual order, matching the CraftStory kids page: headline, sub-headline,
   clip, button, social proof, tagline. The markup keeps its logical order
   (clip before headline); only the display order changes. Every child carries
   an explicit value: without it a child with no `order` stays at 0 and jumps. */
.cs-dh-title{order:1}
.cs-dh-sub{order:2}
.cs-dh-videowrap{order:3}
.cs-dh-ctas{order:4}
.cs-dh-proof{order:5}
.cs-dh-trust{order:6}
.cs-dh-badge,.cs-dh-eyebrow{order:0}
.cs-dh-proofhint{order:7}

.cs-dh-badge{display:inline-flex;align-items:center;gap:.55em;white-space:nowrap;max-width:100%;
  font-size:clamp(.7rem,2.2vw,.82rem);font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  color:var(--cs-coral);background:var(--cs-card);border:1px solid var(--cs-line);
  border-radius:var(--cs-pill);padding:8px 20px;box-shadow:var(--cs-sh-sm)}
.cs-dh-badge-stars{color:var(--cs-star);letter-spacing:.09em;font-size:.86em;line-height:1;flex-shrink:0}
.cs-dh-eyebrow{align-self:center}
/* the clip is sized by its own intrinsic ratio: no aspect-ratio box, no crop */
.cs-dh-videowrap{position:relative;width:100%;max-width:480px}
/* Clip caption, matching the kids page: white bold, bottom left, over a
   gradient so it stays legible whatever the image underneath. */
.cs-dh-clipcap{position:absolute;left:0;right:0;bottom:0;z-index:3;pointer-events:none;
  padding:34px 18px 14px;text-align:left;color:#fff;font-weight:800;
  font-size:clamp(.88rem,2.9vw,1rem);line-height:1.25;letter-spacing:-.01em;
  text-shadow:0 1px 8px rgba(0,0,0,.45);border-radius:0 0 var(--cs-r-xl) var(--cs-r-xl);
  background:linear-gradient(to top,rgba(0,0,0,.55),transparent)}
.cs-dh-stage{position:relative;border-radius:var(--cs-r-xl);overflow:hidden;
  box-shadow:var(--cs-sh-lg);border:1px solid var(--cs-line)}
.cs-dh-auto{cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;
  -webkit-touch-callout:none;user-select:none;-webkit-user-select:none}
.cs-dh-stage video{display:block;width:100%;height:auto;outline:none;-webkit-tap-highlight-color:transparent}
.cs-dh-cover{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;margin:0;
  cursor:pointer;display:block;background:#000;font:inherit;z-index:2}
.cs-dh-playing .cs-dh-cover{display:none}
.cs-dh-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-dh-still img{display:block;width:100%;height:auto}
.cs-dh-scrim{position:absolute;inset:0;background:radial-gradient(circle at 50% 46%,rgba(0,0,0,.1),rgba(0,0,0,.46))}
.cs-dh-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:clamp(58px,8vw,78px);height:clamp(58px,8vw,78px);border-radius:50%;
  background:rgba(255,255,255,.95);color:var(--cs-coral);display:grid;place-items:center;
  box-shadow:0 12px 34px rgba(0,0,0,.34);transition:transform .18s ease}
.cs-dh-play svg{width:38%;height:38%;margin-left:8%}
.cs-dh-cover:hover .cs-dh-play{transform:translate(-50%,-50%) scale(1.09)}
/* centred pill, with the pulsing ring; it comes back if the viewer re-mutes */
.cs-dh-unmute{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:3;
  display:inline-flex;align-items:center;gap:9px;border:0;cursor:pointer;font:inherit;
  font-weight:700;font-size:clamp(.88rem,2.4vw,1rem);color:var(--cs-card);
  background:rgba(28,21,51,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  padding:13px 26px;border-radius:var(--cs-pill);min-height:46px;
  box-shadow:0 4px 20px rgba(0,0,0,.25);
  -webkit-tap-highlight-color:transparent;
  transition:transform .18s ease,background .18s ease}
.cs-dh-unmute svg{width:20px;height:20px;flex:0 0 20px}
.cs-dh-unmute:hover{background:rgba(28,21,51,.9);transform:translate(-50%,-50%) scale(1.05)}
.cs-dh-unmute:before{content:"";position:absolute;inset:-4px;border-radius:inherit;
  border:2px solid rgba(255,255,255,.3);animation:cs-dh-ring 2s ease-out infinite}
@keyframes cs-dh-ring{0%{transform:scale(1);opacity:1}100%{transform:scale(1.15);opacity:0}}
.cs-dh-unmute.cs-dh-hidden{display:none}
/* custom controls bar: hidden until hover, or for the first 3s after load on touch */
.cs-dh-controls{position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;gap:2px;
  padding:8px 12px;background:linear-gradient(to top,rgba(0,0,0,.55) 0%,transparent 100%);
  z-index:2;opacity:0;transition:opacity .3s ease}
.cs-dh-stage:hover .cs-dh-controls,.cs-dh-controls.cs-dh-visible{opacity:1}
.cs-dh-vidbtn{display:flex;align-items:center;justify-content:center;flex-shrink:0;
  width:36px;height:36px;padding:0;border:0;border-radius:50%;cursor:pointer;
  background:rgba(255,255,255,.15);color:var(--cs-card);font:inherit;
  -webkit-tap-highlight-color:transparent;transition:background .2s ease}
.cs-dh-vidbtn:hover{background:rgba(255,255,255,.3)}
.cs-dh-vidbtn svg{width:18px;height:18px;fill:currentColor}
.cs-dh-progress{flex:1;height:4px;background:rgba(255,255,255,.25);border-radius:2px;
  overflow:hidden;cursor:pointer;margin:0 6px}
.cs-dh-progress-fill{height:100%;width:0%;background:var(--cs-card);border-radius:2px;
  transition:width .15s linear}
/* design-mode only: a visitor never sees an empty stage */
.cs-dh-empty{aspect-ratio:16/9;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;background:var(--cs-night);color:var(--cs-night-ink2);
  font-weight:600;font-size:.86rem;text-align:center;padding:18px}
.cs-dh-empty svg{width:42px;height:42px}
.cs-dh-title{font-family:var(--cs-serif);font-weight:600;letter-spacing:-.01em;
  font-size:clamp(1.85rem,6.4vw,3.1rem);line-height:1.18;max-width:640px;text-wrap:balance}
.cs-dh-title em{font-style:italic;color:var(--cs-coral)}
.cs-dh-q{font-family:var(--cs-serif);color:var(--cs-coral);opacity:.3}
.cs-dh-sub{font-size:clamp(1rem,2.4vw,1.18rem);line-height:1.6;color:var(--cs-ink2);max-width:500px}
.cs-dh-ctas{display:flex;flex-direction:column;align-items:center;gap:12px;width:100%;max-width:420px}
.cs-dh-cta{display:inline-flex;align-items:center;justify-content:center;gap:.55em;width:100%;
  position:relative;overflow:hidden;font-family:var(--cs-sans);font-weight:700;
  font-size:clamp(1rem,2.4vw,1.07rem);text-decoration:none;color:var(--cs-card);background:var(--cs-coral);
  border-radius:var(--cs-pill);padding:18px 28px;line-height:1;min-height:56px;
  box-shadow:0 12px 30px -10px rgba(236,91,60,.7);transition:transform .18s ease,background .18s ease,box-shadow .18s ease}
.cs-dh-cta:before{content:"";position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(255,255,255,.16) 0%,transparent 50%);pointer-events:none}
.cs-dh-cta:hover{background:var(--cs-coral-deep);transform:translateY(-2px);
  box-shadow:0 18px 38px -12px rgba(236,91,60,.8)}
.cs-dh-cta:focus-visible{outline:3px solid rgba(236,91,60,.45);outline-offset:2px}
.cs-dh-cta:active{transform:translateY(0)}
.cs-dh-cta-ico{font-size:1.2em;line-height:1}
.cs-dh-ctasub{display:inline-flex;align-items:center;gap:7px;font-size:.84rem;font-weight:600;
  color:var(--cs-ink2);line-height:1.35;text-align:left}
.cs-dh-ctasub svg{width:16px;height:16px;flex:0 0 16px;color:var(--cs-duo-green)}
.cs-dh-proof{display:flex;flex-direction:column;align-items:center;gap:14px}
.cs-dh-faces{display:flex;align-items:center}
.cs-dh-face{width:38px;height:38px;border-radius:50%;border:2.5px solid var(--cs-card);
  object-fit:cover;margin-left:-10px;box-shadow:0 2px 8px rgba(36,27,58,.14)}
.cs-dh-face:first-child{margin-left:0}
.cs-dh-facecount{width:38px;height:38px;border-radius:50%;border:2.5px solid var(--cs-card);
  margin-left:-10px;background:var(--cs-ink2);color:var(--cs-card);display:grid;place-items:center;
  font-size:.62rem;font-weight:800;letter-spacing:.01em;box-shadow:0 2px 8px rgba(36,27,58,.14)}
.cs-dh-prooftxt{display:flex;flex-direction:column;align-items:center;gap:4px}
.cs-dh-proofstars{color:var(--cs-star);font-size:1rem;letter-spacing:.14em;line-height:1}
.cs-dh-prooflabel{font-size:.9rem;font-weight:500;color:var(--cs-ink2);line-height:1.4}
.cs-dh-prooflabel strong{color:var(--cs-ink);font-weight:700}
/* design-mode only: never rendered for a visitor */
.cs-dh-proofhint{max-width:34em;font-size:.78rem;font-weight:600;line-height:1.45;color:var(--cs-ink2);
  background:var(--cs-paper2);border:1px dashed var(--cs-line);border-radius:var(--cs-r);padding:10px 14px}
/* trust line: two short parts and a trailing dot on line 1, the occasions wrap to line 2 on their own */
.cs-dh-trust{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;
  gap:6px;font-size:.75rem;color:var(--cs-ink2);line-height:1.45;opacity:.8}
.cs-dh-trust>span{min-width:0}
.cs-dh-sep{width:3px;height:3px;border-radius:50%;background:var(--cs-ink2);opacity:.4;flex:0 0 3px}
/* staggered entrance across the seven children of .cs-dh-inner */
@keyframes cs-dh-fade-down{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.cs-dh-badge,.cs-dh-eyebrow{animation:cs-dh-fade-down .8s ease-out both}
.cs-dh-videowrap{animation:cs-dh-fade-down .8s ease-out .12s both}
.cs-dh-title{animation:cs-dh-fade-down .8s ease-out .15s both}
.cs-dh-sub{animation:cs-dh-fade-down .8s ease-out .25s both}
.cs-dh-ctas{animation:cs-dh-fade-down .8s ease-out .35s both}
.cs-dh-proof{animation:cs-dh-fade-down .8s ease-out .45s both}
.cs-dh-trust{animation:cs-dh-fade-down .8s ease-out .55s both}
@media(prefers-reduced-motion:reduce){
  .cs-dh-badge,.cs-dh-eyebrow,.cs-dh-videowrap,.cs-dh-title,.cs-dh-sub,
  .cs-dh-ctas,.cs-dh-proof,.cs-dh-trust{animation:none}
  .cs-dh-unmute:before{animation:none}
  .cs-dh-progress-fill{transition:none}
}
@media(max-width:600px){
  .cs-duo-hero{min-height:auto;padding:10px 16px 48px}
  .cs-dh-inner{gap:20px}
  .cs-dh-videowrap{max-width:100%}
  /* never clip text: the badge wraps instead of overflowing */
  .cs-dh-badge{white-space:normal;text-align:center;line-height:1.35;padding:7px 14px}
  .cs-dh-title{max-width:none}
  .cs-dh-face,.cs-dh-facecount{width:32px;height:32px;margin-left:-8px}
  .cs-dh-face:first-child{margin-left:0}
  .cs-dh-facecount{font-size:.56rem}
}
@media(max-width:370px){
  .cs-dh-badge{font-size:11px;padding:6px 14px}
}
{% endstylesheet %}
{% javascript %}
/* Hero clip controller. Every node is resolved inside its own section root, so
   two hero instances on one page never touch each other's video. */
(function () {
  function init(root) {
    if (!root || root.dataset.csDhInit) { return; }
    root.dataset.csDhInit = '1';

    var stage = root.querySelector('[data-cs-dh-stage]');
    if (!stage) { return; }
    var vid = stage.querySelector('video');
    if (!vid) { return; }

    var cover = stage.querySelector('[data-cs-dh-trigger]');
    var banner = stage.querySelector('[data-cs-dh-unmute]');
    var controls = stage.querySelector('[data-cs-dh-controls]');
    var playBtn = stage.querySelector('[data-cs-dh-playbtn]');
    var playIcon = stage.querySelector('[data-cs-dh-playicon]');
    var pauseIcon = stage.querySelector('[data-cs-dh-pauseicon]');
    var muteBtn = stage.querySelector('[data-cs-dh-mutebtn]');
    var mutedIcon = stage.querySelector('[data-cs-dh-mutedicon]');
    var unmutedIcon = stage.querySelector('[data-cs-dh-unmutedicon]');
    var progress = stage.querySelector('[data-cs-dh-progress]');
    var progressFill = stage.querySelector('[data-cs-dh-progressfill]');
    var auto = stage.hasAttribute('data-cs-dh-auto');

    function inside(node, target) {
      return !!node && (node === target || node.contains(target));
    }

    /* one retry: a play() rejected by the autoplay policy usually succeeds on the
       second attempt once the tap has been registered as a user gesture */
    function play() {
      var p = vid.play();
      if (p && p.catch) {
        p.catch(function () {
          setTimeout(function () {
            var again = vid.play();
            if (again && again.catch) { again.catch(function () {}); }
          }, 60);
        });
      }
    }

    function syncPlay() {
      if (playIcon) { playIcon.style.display = vid.paused ? 'block' : 'none'; }
      if (pauseIcon) { pauseIcon.style.display = vid.paused ? 'none' : 'block'; }
      if (playBtn) { playBtn.setAttribute('aria-label', vid.paused ? 'Play video' : 'Pause video'); }
    }

    function syncMute() {
      if (mutedIcon) { mutedIcon.style.display = vid.muted ? 'block' : 'none'; }
      if (unmutedIcon) { unmutedIcon.style.display = vid.muted ? 'none' : 'block'; }
      if (muteBtn) { muteBtn.setAttribute('aria-label', vid.muted ? 'Unmute video' : 'Mute video'); }
      /* the pill comes back the moment the viewer mutes again */
      if (banner) { banner.classList.toggle('cs-dh-hidden', !vid.muted); }
    }

    function unmuteTap(e) {
      e.preventDefault();
      e.stopPropagation();
      vid.muted = false;
      syncMute();
      play();
    }

    if (banner) {
      banner.addEventListener('pointerdown', unmuteTap);
      banner.addEventListener('click', unmuteTap);
    }

    /* poster overlay, only rendered when silent autoplay is switched off */
    if (cover) {
      cover.addEventListener('click', function () {
        stage.classList.add('cs-dh-playing');
        try { vid.setAttribute('controls', ''); } catch (err) {}
        play();
        try { vid.focus(); } catch (err) {}
      });
    }

    if (!auto) {
      syncPlay();
      return;
    }

    try {
      vid.setAttribute('disableremoteplayback', '');
      vid.setAttribute('controlslist', 'noremoteplayback');
      vid.setAttribute('x-webkit-airplay', 'deny');
    } catch (err) {}

    function togglePlay() {
      if (vid.paused) {
        play();
      } else {
        vid.volume = 0; /* drop the audio buffer instantly */
        vid.pause();
        vid.volume = 1; /* restore it for the next play */
      }
    }

    /* pointerdown, not click: the clip responds on press rather than on release */
    var lastPointer = 0;
    stage.addEventListener('pointerdown', function (e) {
      var t = e.target;
      lastPointer = Date.now();

      if (inside(banner, t)) { e.preventDefault(); return; }

      if (inside(muteBtn, t)) {
        vid.muted = !vid.muted;
        syncMute();
        e.preventDefault();
        return;
      }

      if (inside(progress, t)) {
        var rect = progress.getBoundingClientRect();
        if (vid.duration && rect.width) {
          var ratio = (e.clientX - rect.left) / rect.width;
          if (ratio < 0) { ratio = 0; }
          if (ratio > 1) { ratio = 1; }
          vid.currentTime = ratio * vid.duration;
        }
        e.preventDefault();
        return;
      }

      /* play button, video surface or anywhere else on the stage: toggle */
      togglePlay();
      e.preventDefault();
    });

    /* the bar above is driven by pointerdown, which leaves the two buttons inert
       for a keyboard user; a click that no pointerdown preceded is that user */
    function keyboardOnly(fn) {
      return function (e) {
        if (Date.now() - lastPointer < 500) { return; }
        fn();
        e.preventDefault();
      };
    }
    if (playBtn) { playBtn.addEventListener('click', keyboardOnly(togglePlay)); }
    if (muteBtn) {
      muteBtn.addEventListener('click', keyboardOnly(function () {
        vid.muted = !vid.muted;
        syncMute();
      }));
    }

    vid.addEventListener('play', syncPlay);
    vid.addEventListener('pause', syncPlay);
    vid.addEventListener('timeupdate', function () {
      if (progressFill && vid.duration) {
        progressFill.style.width = (vid.currentTime / vid.duration) * 100 + '%';
      }
    });

    /* show the bar for three seconds on load, so a touch viewer who never
       hovers still learns the controls are there */
    if (controls) {
      controls.classList.add('cs-dh-visible');
      setTimeout(function () { controls.classList.remove('cs-dh-visible'); }, 3000);
    }

    syncPlay();
    syncMute();
  }

  function initAll(scope) {
    var roots = (scope || document).querySelectorAll('[data-cs-dh-root]');
    Array.prototype.forEach.call(roots, init);
    if (scope && scope.hasAttribute && scope.hasAttribute('data-cs-dh-root')) { init(scope); }
  }

  initAll();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  }
  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target || document);
  });
})();
{% endjavascript %}
