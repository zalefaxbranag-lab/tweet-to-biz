<div class="cs cs-duo-hero">
  <div class="cs-wrap cs-dh-in">
    <div class="cs-dh-copy">
      {%- if section.settings.claim != blank -%}
        <p class="cs-dh-claim"><span class="cs-dh-stars" aria-hidden="true">★★★★★</span> {{ section.settings.claim }}</p>
      {%- elsif section.settings.eyebrow != blank -%}
        <span class="cs-eyebrow">✦ {{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="cs-h1 cs-dh-h{% if section.settings.quote_style %} cs-dh-quote{% endif %}">{{ section.settings.heading }}</h1>
        {%- if section.settings.quote_style and section.settings.quote_by != blank -%}
          <span class="cs-dh-qby">{{ section.settings.quote_by }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.body != blank -%}<p class="cs-lead cs-dh-body">{{ section.settings.body }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="cs-dh-list cs-dh-bullets">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' and block.settings.text != blank -%}
              <li {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="cs-dh-cta">
        {%- if section.settings.cta_label != blank -%}
          <a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_note != blank -%}<span class="cs-dh-note">{{ section.settings.cta_note }}</span>{%- endif -%}
      </div>

      {%- if section.settings.trust_line != blank -%}<p class="cs-dh-trust">{{ section.settings.trust_line }}</p>{%- endif -%}
    </div>

    <div class="cs-dh-media">
      {%- assign dh_cover = section.settings.cover -%}
      {%- if section.settings.video != blank or section.settings.video_url != blank -%}
        <div class="cs-dh-stage{% if section.settings.autoplay %} cs-dh-auto{% endif %}" data-cs-duo-play{% if section.settings.autoplay %} data-cs-duo-auto{% endif %}>
          {%- if section.settings.video != blank -%}
            {%- if section.settings.autoplay -%}
              {{ section.settings.video | video_tag: controls: false, autoplay: true, muted: true, loop: true, playsinline: true, image_size: '1600x', class: 'cs-dh-video' }}
            {%- else -%}
              {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1600x', class: 'cs-dh-video' }}
            {%- endif -%}
          {%- else -%}
            <video class="cs-dh-video"{% if section.settings.autoplay %} autoplay muted loop playsinline{% else %} controls playsinline preload="none"{% endif %}{% if dh_cover != blank %} poster="{{ dh_cover | image_url: width: 1600 }}"{% endif %}><source src="{{ section.settings.video_url | escape }}" type="video/mp4"></video>
          {%- endif -%}
          {%- if section.settings.autoplay -%}
            <button type="button" class="cs-dh-unmute" data-cs-duo-unmute>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M11 5L6.5 9H3v6h3.5L11 19V5z" stroke-linejoin="round"/><path d="M16 9.5l4 5M20 9.5l-4 5" stroke-linecap="round"/></svg>
              <span>{{ section.settings.unmute_label | default: 'Tap to unmute' }}</span>
            </button>
          {%- endif -%}
          <button type="button" class="cs-dh-cover" data-cs-duo-trigger aria-label="{{ section.settings.play_label | default: 'Play' | escape }}">
            {%- if dh_cover != blank -%}<img src="{{ dh_cover | image_url: width: 1600 }}" alt="{{ dh_cover.alt | default: 'Preview' | escape }}" loading="eager">{%- endif -%}
            <span class="cs-dh-scrim"></span>
            <span class="cs-dh-play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
            {%- if section.settings.play_label != blank -%}<span class="cs-dh-playlabel">{{ section.settings.play_label }}</span>{%- endif -%}
          </button>
        </div>
      {%- elsif dh_cover != blank -%}
        <div class="cs-dh-stage cs-dh-stage-still"><img src="{{ dh_cover | image_url: width: 1600 }}" alt="{{ dh_cover.alt | default: 'Preview' | escape }}" loading="eager"></div>
      {%- else -%}
        <div class="cs-dh-stage cs-dh-stage-still cs-dh-empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M10 9l5 3-5 3z" stroke-linejoin="round"/></svg>
          {%- if request.design_mode -%}<span>Add the hero clip — Theme editor ▸ CraftStory Duo Hero ▸ Hero video</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
function csDuoInitAll(){
  var stages = document.querySelectorAll('[data-cs-duo-play]');
  Array.prototype.forEach.call(stages, function(stage){
    if(stage.dataset.csDuoInit) return;
    stage.dataset.csDuoInit = '1';
    var cover = stage.querySelector('[data-cs-duo-trigger]');
    var video = stage.querySelector('video');
    if(!cover || !video) return;
    cover.addEventListener('click', function(){
      stage.classList.add('cs-duo-playing');
      try { video.setAttribute('controls',''); } catch(e){}
      var p = video.play();
      if(p && p.catch){ p.catch(function(){}); }
      try { video.focus(); } catch(e){}
    });
  });
}
csDuoInitAll();
if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', csDuoInitAll); }

(function(){
  var btn = document.querySelector('[data-cs-duo-unmute]');
  if(!btn) return;
  var stage = btn.closest('[data-cs-duo-auto]');
  var video = stage && stage.querySelector('video');
  if(!video) return;
  btn.addEventListener('click', function(){
    video.muted = false;
    try { video.setAttribute('controls',''); } catch(e){}
    var p = video.play();
    if(p && p.catch){ p.catch(function(){}); }
    stage.classList.add('cs-duo-unmuted');
  });
})();
</script>
{% schema %}
{
  "name": "CraftStory Duo Hero",
  "settings": [
    { "type": "paragraph", "content": "Top of the couples landing page. Keep CraftStory Setup as the first section of the template. The button points to a URL you paste below — set it to the couples order form once that page exists." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For couples" },
    { "type": "text", "id": "claim", "label": "Star line above the headline", "info": "Shown with five stars, and it replaces the eyebrow. Leave it empty until the claim is true — no invented customer counts." },
    { "type": "text", "id": "heading", "label": "Headline", "default": "I pressed play and we both stopped talking." },
    { "type": "checkbox", "id": "quote_style", "label": "Show the headline as a customer quote", "default": true, "info": "The competitor's strongest device: the headline is a real customer's sentence, in quotes. Use only words a customer actually said." },
    { "type": "text", "id": "quote_by", "label": "Who said it" },
    { "type": "textarea", "id": "body", "label": "Sub-headline", "default": "A custom song about the two of you — and a music video to go with it. Answer five questions, we do the rest." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" },
    { "type": "text", "id": "cta_note", "label": "Note next to the button", "default": "Takes about 2 minutes" },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "No payment up front · Full refund if you don't love it" },
    { "type": "header", "content": "Hero video" },
    { "type": "checkbox", "id": "autoplay", "label": "Play silently on load, with a Tap-to-unmute button", "default": true, "info": "How the competitor's hero works. The clip loops muted, and one tap turns the sound on." },
    { "type": "text", "id": "unmute_label", "label": "Unmute button label", "default": "Tap to unmute" },
    { "type": "video", "id": "video", "label": "Hero clip (upload MP4)", "info": "Landscape 16:9. Use one of the reaction clips." },
    { "type": "text", "id": "video_url", "label": "…or .mp4 URL" },
    { "type": "image_picker", "id": "cover", "label": "Thumbnail (poster)" },
    { "type": "text", "id": "play_label", "label": "Play-button caption", "default": "Watch her hear it for the first time" }
  ],
  "blocks": [
    { "type": "point", "name": "Bullet", "limit": 5, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Their name in the lyrics" } ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Hero", "blocks": [
      { "type": "point", "settings": { "text": "Their name and your story in the lyrics" } },
      { "type": "point", "settings": { "text": "A music video with the two of you in it" } },
      { "type": "point", "settings": { "text": "Any genre — you pick the style" } },
      { "type": "point", "settings": { "text": "Hear your free preview before you pay anything" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-hero{background:var(--cs-paper)}
.cs-dh-in{display:grid;grid-template-columns:1.02fr 1fr;gap:clamp(28px,4vw,58px);align-items:center;padding:clamp(40px,6vw,86px) 22px}
.cs-dh-copy{display:flex;flex-direction:column;gap:clamp(14px,2vw,20px);align-items:flex-start}
.cs-dh-h{max-width:15em}
.cs-dh-body{max-width:34em}
.cs-dh-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.cs-dh-list li{display:flex;gap:10px;align-items:flex-start;font-size:1.01rem;color:var(--cs-ink2);font-weight:500}
.cs-dh-list svg{width:18px;height:18px;flex:0 0 18px;margin-top:4px;color:var(--cs-coral)}
.cs-dh-cta{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:4px}
.cs-dh-note{font-size:.9rem;color:var(--cs-ink3);font-weight:600}
.cs-dh-trust{font-size:.86rem;color:var(--cs-ink3);font-weight:600}
.cs-dh-media{width:100%}
.cs-dh-stage{position:relative;aspect-ratio:16/9;border-radius:var(--cs-r-xl);overflow:hidden;background:#000;box-shadow:var(--cs-sh-lg);border:1px solid var(--cs-line)}
.cs-dh-video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;display:block;background:#000}
.cs-dh-cover{position:absolute;inset:0;width:100%;height:100%;border:0;padding:0;margin:0;cursor:pointer;display:block;background:#000;font:inherit}
.cs-duo-playing .cs-dh-cover{display:none}
.cs-dh-cover img,.cs-dh-stage-still img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cs-dh-scrim{position:absolute;inset:0;background:radial-gradient(circle at 50% 46%,rgba(0,0,0,.1),rgba(0,0,0,.48))}
.cs-dh-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:clamp(58px,8vw,80px);height:clamp(58px,8vw,80px);border-radius:50%;background:rgba(255,255,255,.95);color:var(--cs-coral);display:grid;place-items:center;box-shadow:0 12px 34px rgba(0,0,0,.34);transition:transform .18s ease}
.cs-dh-play svg{width:38%;height:38%;margin-left:8%}
.cs-dh-cover:hover .cs-dh-play,.cs-dh-cover:focus-visible .cs-dh-play{transform:translate(-50%,-50%) scale(1.09)}
.cs-dh-playlabel{position:absolute;left:14px;right:14px;bottom:14px;text-align:center;color:#fff;font-weight:700;font-size:clamp(.85rem,1.3vw,1rem);text-shadow:0 2px 12px rgba(0,0,0,.6)}
.cs-dh-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#171310;color:#cdbfa9;font-weight:600;font-size:.86rem;text-align:center;padding:18px}
.cs-dh-empty svg{width:42px;height:42px}
.cs-dh-claim{display:flex;align-items:center;gap:.5em;font-size:.86rem;font-weight:700;
  color:var(--cs-ink2);letter-spacing:.01em;line-height:1.3}
.cs-dh-stars{color:var(--cs-star);letter-spacing:.06em;font-size:.95rem;line-height:1}
.cs-dh-quote{quotes:"\201C" "\201D"}
.cs-dh-quote:before{content:open-quote}
.cs-dh-quote:after{content:close-quote}
.cs-dh-qby{font-size:.85rem;font-weight:700;color:var(--cs-ink3);margin-top:-4px}
/* l habillage du lecteur s effile quand la video joue en muet */
.cs-dh-auto .cs-dh-cover{display:none}
.cs-dh-unmute{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:2;
  display:inline-flex;align-items:center;gap:8px;border:0;cursor:pointer;font:inherit;
  font-weight:700;font-size:.88rem;color:var(--cs-ink);background:rgba(255,255,255,.94);
  padding:11px 18px;border-radius:var(--cs-pill);box-shadow:0 10px 26px rgba(0,0,0,.3);
  min-height:44px;transition:transform .18s ease}
.cs-dh-unmute svg{width:17px;height:17px;flex:0 0 17px;color:var(--cs-coral)}
.cs-dh-unmute:hover{transform:translateX(-50%) translateY(-2px)}
.cs-duo-unmuted .cs-dh-unmute{display:none}
@media(max-width:900px){
  .cs-dh-claim{font-size:.8rem}
  .cs-dh-in{grid-template-columns:1fr;gap:18px;padding:14px 22px 26px}
  .cs-dh-media{order:-1}
  .cs-dh-copy{align-items:flex-start;gap:10px}
  /* le CTA doit tenir au-dessus du pli : les puces passent sous le bouton */
  .cs-dh-copy{display:flex;flex-direction:column}
  /* tout element de .cs-dh-copy doit porter un order : sans lui il vaut 0 et
     remonte au-dessus des autres (la ligne d'attribution passait avant le titre). */
  .cs-dh-copy .cs-eyebrow,.cs-dh-claim{order:1}
  .cs-dh-h{order:2;font-size:clamp(1.62rem,6.6vw,2.1rem);line-height:1.1;max-width:none}
  .cs-dh-qby{order:3}
  .cs-dh-body{order:4;font-size:1rem;line-height:1.45}
  .cs-dh-cta{order:5;width:100%;margin-top:2px}
  .cs-dh-cta .cs-btn{width:100%}
  .cs-dh-trust{order:6}
  .cs-dh-bullets{order:7;margin-top:6px;padding-top:14px;border-top:1px solid var(--cs-line)}
  .cs-dh-note{width:100%;text-align:center}
}
{% endstylesheet %}
