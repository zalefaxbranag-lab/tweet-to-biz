<div class="cs cs-duo-offer">
  <div class="cs-wrap">
    <div class="cs-sec">
      <div class="cs-do-card">
        <div class="cs-do-left">
          {%- if section.settings.eyebrow != blank -%}<span class="cs-eyebrow">✦ {{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="cs-h2 cs-do-h">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.body != blank -%}<p class="cs-do-body">{{ section.settings.body }}</p>{%- endif -%}

          <ul class="cs-do-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'item' and block.settings.text != blank -%}
                <li {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="cs-do-right">
          {%- if section.settings.show_price and section.settings.price != blank -%}
            <p class="cs-do-price">
              {%- if section.settings.price_was != blank -%}<span class="cs-was">{{ section.settings.price_was }}</span>{%- endif -%}
              <span class="cs-price">{{ section.settings.price }}</span>
            </p>
          {%- endif -%}

          {%- if section.settings.free_line != blank -%}<p class="cs-do-free">{{ section.settings.free_line }}</p>{%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <a class="cs-btn cs-btn-primary cs-btn-lg cs-do-btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta_note != blank -%}<span class="cs-do-note">{{ section.settings.cta_note }}</span>{%- endif -%}

          {%- if section.settings.guarantee != blank -%}
            <div class="cs-do-guar">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.5 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.guarantee }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "CraftStory Duo Offer",
  "settings": [
    { "type": "paragraph", "content": "What the customer gets, and the final call to action. The price is hidden by default: CraftStory reveals a price only after the free preview. Turn it on only if you decide this page should show one." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What you get" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One song. One music video. Both about them." },
    { "type": "textarea", "id": "body", "label": "Mini-text", "default": "This is the one gift they cannot get for themselves, and the one they cannot guess." },
    { "type": "header", "content": "Right-hand panel" },
    { "type": "text", "id": "free_line", "label": "Free-preview line", "default": "Your preview is free" },
    { "type": "checkbox", "id": "show_price", "label": "Show a price on this page", "default": false },
    { "type": "text", "id": "price_was", "label": "Anchor price (struck through)" },
    { "type": "text", "id": "price", "label": "Price" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" },
    { "type": "text", "id": "cta_note", "label": "Note under the button", "default": "You decide after you have heard it" },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "Full refund if you are not happy with it" }
  ],
  "blocks": [
    { "type": "item", "name": "Included item", "limit": 8, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "A full-length song" } ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Offer", "blocks": [
      { "type": "item", "settings": { "text": "A full-length song with their name and your story in the lyrics" } },
      { "type": "item", "settings": { "text": "A music video where the couple on screen is the two of you" } },
      { "type": "item", "settings": { "text": "The genre you choose, not a template" } },
      { "type": "item", "settings": { "text": "Yours to keep, share and replay" } },
      { "type": "item", "settings": { "text": "A free preview before you pay anything" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-offer{background:var(--cs-paper)}
.cs-do-card{display:grid;grid-template-columns:1.25fr .85fr;gap:clamp(22px,3.4vw,46px);background:var(--cs-card);border:1px solid var(--cs-line);border-radius:var(--cs-r-xl);padding:clamp(24px,3.6vw,48px);box-shadow:var(--cs-sh)}
.cs-do-left{display:flex;flex-direction:column;gap:14px;align-items:flex-start}
.cs-do-h{max-width:18em}
.cs-do-body{color:var(--cs-ink2);font-size:1.04rem;line-height:1.55;max-width:32em}
.cs-do-list{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column;gap:11px}
.cs-do-list li{display:flex;gap:11px;align-items:flex-start;font-size:1rem;color:var(--cs-ink);font-weight:500;line-height:1.45}
.cs-do-list svg{width:19px;height:19px;flex:0 0 19px;margin-top:3px;color:var(--cs-coral)}
.cs-do-right{display:flex;flex-direction:column;gap:12px;align-items:center;justify-content:center;text-align:center;background:var(--cs-paper2);border:1px solid var(--cs-line);border-radius:var(--cs-r-lg);padding:clamp(20px,2.8vw,32px)}
.cs-do-price{font-size:clamp(1.9rem,3.6vw,2.6rem);line-height:1}
.cs-do-free{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1.25rem,2.2vw,1.55rem);line-height:1.15}
.cs-do-btn{width:100%}
.cs-do-note{font-size:.88rem;color:var(--cs-ink3);font-weight:600}
.cs-do-guar{display:flex;gap:9px;align-items:flex-start;text-align:left;font-size:.88rem;color:var(--cs-ink2);font-weight:600;border-top:1px solid var(--cs-line);padding-top:12px;margin-top:2px;width:100%}
.cs-do-guar svg{width:19px;height:19px;flex:0 0 19px;color:var(--cs-gold)}
@media(max-width:860px){
  .cs-do-card{grid-template-columns:1fr;gap:22px;padding:clamp(20px,5vw,28px)}
}
{% endstylesheet %}
