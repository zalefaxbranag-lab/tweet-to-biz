<div class="cs cs-duo-bar{% unless section.settings.show_desktop %} cs-dbar-mobile-only{% endunless %}" data-cs-dbar hidden>
  <div class="cs-dbar-in">
    <div class="cs-dbar-txt">
      {%- if section.settings.title != blank -%}<span class="cs-dbar-t">{{ section.settings.title }}</span>{%- endif -%}
      {%- if section.settings.note != blank -%}<span class="cs-dbar-n">{{ section.settings.note }}</span>{%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a class="cs-btn cs-btn-primary cs-dbar-btn" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>
<script>
(function(){
  var bar = document.querySelector('[data-cs-dbar]');
  if(!bar || bar.dataset.csDbarInit) return;
  bar.dataset.csDbarInit = '1';

  function show(on){
    if(on){ bar.removeAttribute('hidden'); bar.classList.add('cs-dbar-on'); }
    else { bar.classList.remove('cs-dbar-on'); }
  }

  // Les vrais CTA de la page, la barre exclue.
  var ctas = [].filter.call(document.querySelectorAll('.cs-btn-primary'), function(el){
    return !bar.contains(el);
  });

  // Sans IntersectionObserver, on affiche simplement la barre.
  if(!('IntersectionObserver' in window) || !ctas.length){ show(true); return; }

  var visible = 0;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ if(!e.target.dataset.csSeen){ e.target.dataset.csSeen='1'; visible++; } }
      else { if(e.target.dataset.csSeen){ delete e.target.dataset.csSeen; visible--; } }
    });
    if(visible < 0) visible = 0;
    show(visible === 0);
  }, { rootMargin: '-8px 0px -8px 0px', threshold: 0 });

  ctas.forEach(function(el){ io.observe(el); });
})();
</script>
{% schema %}
{
  "name": "CraftStory Duo Bar",
  "settings": [
    { "type": "paragraph", "content": "A call-to-action bar pinned to the bottom of the screen. It appears only while no other button is on screen, so it never doubles up with the buttons inside the page. Keep it last in the template." },
    { "type": "text", "id": "title", "label": "Line 1", "default": "Your preview is free" },
    { "type": "text", "id": "note", "label": "Line 2", "default": "No payment up front" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" },
    { "type": "checkbox", "id": "show_desktop", "label": "Show on desktop too", "default": false, "info": "Off by default: on a wide screen a button is almost always already on screen." }
  ],
  "presets": [ { "name": "CraftStory Duo Bar" } ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-bar{position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--cs-card);
  border-top:1px solid var(--cs-line);box-shadow:0 -10px 30px -18px rgba(36,27,58,.5);
  padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));
  transform:translateY(105%);transition:transform .22s ease}
.cs-duo-bar.cs-dbar-on{transform:translateY(0)}
.cs-dbar-in{display:flex;align-items:center;gap:14px;max-width:760px;margin:0 auto}
.cs-dbar-txt{display:flex;flex-direction:column;min-width:0;flex:1}
.cs-dbar-t{font-family:var(--cs-serif);font-weight:600;font-size:1rem;line-height:1.15;
  color:var(--cs-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cs-dbar-n{font-size:.79rem;font-weight:600;color:var(--cs-ink3);line-height:1.3;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cs-dbar-btn{flex:0 0 auto;padding:13px 24px;font-size:.98rem;min-height:46px}
@media(min-width:901px){
  .cs-dbar-mobile-only{display:none}
}
@media(max-width:380px){
  .cs-dbar-in{gap:10px}
  .cs-dbar-btn{padding:13px 18px}
  .cs-dbar-n{display:none}
}
{% endstylesheet %}
