{%- comment -%}
  CraftStory Duo — How It Works (image banner)
  Structural clone of the competitor's "image_banner" section: one full-bleed photo,
  a dark scrim over it, and a left-aligned block (heading + numbered step lines + one
  coral button) sitting vertically centred on top of the photo. Two separate images,
  as they do it: a wide one for desktop and a square one for mobile. On mobile the
  banner stacks (photo, then the text panel underneath) like their banner--stacked.
  Different component from cs-duo-steps (the card grid) — no shared class names.
{%- endcomment -%}

{%- assign dhw_img_d = section.settings.image | default: section.settings.image_mobile -%}
{%- assign dhw_img_m = section.settings.image_mobile | default: section.settings.image -%}
{%- assign dhw_has_img = false -%}
{%- if dhw_img_d != blank or dhw_img_m != blank -%}{%- assign dhw_has_img = true -%}{%- endif -%}

{%- assign dhw_steps = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'step' -%}{%- assign dhw_steps = dhw_steps | plus: 1 -%}{%- endif -%}
{%- endfor -%}

{%- if dhw_has_img or dhw_steps > 0 or section.settings.heading != blank or request.design_mode -%}
<div class="cs cs-duo-how">
  <div
    class="cs-dhw cs-dhw--{{ section.settings.height }} cs-dhw--m-{{ section.settings.mobile_layout }} cs-dhw--panel-{{ section.settings.mobile_panel }}{% unless dhw_has_img %} cs-dhw--noimg{% endunless %}"
    style="--cs-dhw-scrim:{{ section.settings.overlay_opacity | divided_by: 100.0 }}">

    {%- if dhw_has_img -%}
      <div class="cs-dhw-media cs-dhw-media--d">
        {%- if dhw_img_d != blank -%}
          <img
            src="{{ dhw_img_d | image_url: width: 3840 }}"
            srcset="{{ dhw_img_d | image_url: width: 375 }} 375w, {{ dhw_img_d | image_url: width: 550 }} 550w, {{ dhw_img_d | image_url: width: 750 }} 750w, {{ dhw_img_d | image_url: width: 1100 }} 1100w, {{ dhw_img_d | image_url: width: 1500 }} 1500w, {{ dhw_img_d | image_url: width: 1780 }} 1780w, {{ dhw_img_d | image_url: width: 2000 }} 2000w, {{ dhw_img_d | image_url: width: 3000 }} 3000w, {{ dhw_img_d | image_url: width: 3840 }} 3840w"
            sizes="100vw"
            width="{{ dhw_img_d.width }}"
            height="{{ dhw_img_d.height }}"
            alt="{{ dhw_img_d.alt | escape }}"
            loading="eager"
            fetchpriority="high">
        {%- endif -%}
      </div>
      <div class="cs-dhw-media cs-dhw-media--m">
        {%- if dhw_img_m != blank -%}
          <img
            src="{{ dhw_img_m | image_url: width: 3840 }}"
            srcset="{{ dhw_img_m | image_url: width: 375 }} 375w, {{ dhw_img_m | image_url: width: 550 }} 550w, {{ dhw_img_m | image_url: width: 750 }} 750w, {{ dhw_img_m | image_url: width: 1100 }} 1100w, {{ dhw_img_m | image_url: width: 1500 }} 1500w, {{ dhw_img_m | image_url: width: 1780 }} 1780w, {{ dhw_img_m | image_url: width: 2000 }} 2000w, {{ dhw_img_m | image_url: width: 3000 }} 3000w, {{ dhw_img_m | image_url: width: 3840 }} 3840w"
            sizes="(min-width: 750px) 50vw, 100vw"
            width="{{ dhw_img_m.width }}"
            height="{{ dhw_img_m.height }}"
            alt="{{ dhw_img_m.alt | escape }}"
            loading="eager"
            fetchpriority="high">
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="cs-dhw-media cs-dhw-empty" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M4 18l5.5-5 4 3.5L17 13l3 3.2" stroke-linejoin="round"/></svg>
        {%- if request.design_mode -%}
          <span>Add the banner photo — Theme editor ▸ CraftStory Duo How It Works ▸ Photo (desktop)</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cs-dhw-content">
      <div class="cs-wrap cs-dhw-wrap">
        <div class="cs-dhw-box">

          {%- if section.settings.eyebrow != blank -%}
            <span class="cs-eyebrow cs-on-night cs-dhw-eyebrow">✦ {{ section.settings.eyebrow }}</span>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="cs-h1 cs-dhw-h">
              <span>{{ section.settings.heading }}{%- if section.settings.highlight != blank -%} <em class="cs-dhw-hl">{{ section.settings.highlight }}</em>{%- endif -%}</span>
            </h2>
          {%- endif -%}

          {%- if dhw_steps > 0 -%}
            <ol class="cs-dhw-lines">
              {%- assign dhw_n = 0 -%}
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'step' -%}
                    {%- assign dhw_n = dhw_n | plus: 1 -%}
                    <li class="cs-dhw-line" {{ block.shopify_attributes }}>
                      {%- if block.settings.label != blank -%}
                        <span class="cs-dhw-n">{{ block.settings.label }}&nbsp;</span>
                      {%- elsif section.settings.show_numbers -%}
                        <span class="cs-dhw-n">{{ section.settings.number_word | default: 'Step' }} {{ dhw_n }}:&nbsp;</span>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <span class="cs-dhw-t">{{ block.settings.text }}</span>
                      {%- endif -%}
                    </li>
                {%- endcase -%}
              {%- endfor -%}
            </ol>
          {%- elsif request.design_mode -%}
            <p class="cs-dhw-hint">Add one Step block per line — three is what this layout is built for.</p>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <div class="cs-dhw-btns">
              <a class="cs-btn cs-btn-primary cs-dhw-cta" href="{{ section.settings.cta_link | default: '#' | escape }}">{{ section.settings.cta_label }}</a>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>

  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo How It",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A full-bleed photo with the heading, the numbered step lines and the button laid over it, left-aligned and vertically centred. Two photos: a wide one for desktop, a square one for mobile. Keep CraftStory Setup as the first section of the template." },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo (desktop)", "info": "Wide, around 16:9. A couple, shot so the left third stays calm enough to read white text over it." },
    { "type": "image_picker", "id": "image_mobile", "label": "Photo (mobile)", "info": "Square, 1:1. Falls back to the desktop photo when empty." },
    { "type": "range", "id": "overlay_opacity", "label": "Dark overlay over the photo", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 60, "info": "The scrim that keeps the white text readable. 60% is what the layout is tuned for." },
    { "type": "select", "id": "height", "label": "Banner height", "default": "med", "options": [
      { "value": "sm", "label": "Small" },
      { "value": "med", "label": "Medium" },
      { "value": "lg", "label": "Large" }
    ] },
    { "type": "select", "id": "mobile_layout", "label": "On mobile", "default": "stack", "options": [
      { "value": "stack", "label": "Photo on top, text in a panel underneath" },
      { "value": "over", "label": "Text over the photo" }
    ] },
    { "type": "select", "id": "mobile_panel", "label": "Mobile panel colour", "default": "night", "options": [
      { "value": "night", "label": "Night" },
      { "value": "coral", "label": "Coral" },
      { "value": "paper", "label": "Paper" }
    ], "info": "Only used when the photo is on top and the text sits in a panel underneath." },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "info": "Hidden while empty. The reference banner has none." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works (Simple as 1-2-3)" },
    { "type": "text", "id": "highlight", "label": "Emphasised words after the heading", "info": "Optional. Rendered in the highlight colour at the end of the heading." },
    { "type": "header", "content": "Steps" },
    { "type": "checkbox", "id": "show_numbers", "label": "Number the lines automatically", "default": true },
    { "type": "text", "id": "number_word", "label": "Word before the number", "default": "Step", "info": "Rendered as \"Step 1:\", \"Step 2:\" and so on. A block's own label overrides it." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start My Custom Song", "info": "Kept on one line, as in the reference. About 30 characters is the most that fits on a 375px phone." },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" }
  ],
  "blocks": [
    { "type": "step", "name": "Step line", "limit": 6, "settings": [
      { "type": "text", "id": "text", "label": "Line", "info": "The words after the number, for example: Fill out the form" },
      { "type": "text", "id": "label", "label": "Label instead of the automatic number", "info": "Optional. Leave it empty to get \"Step 1:\", \"Step 2:\" and so on." }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo How It", "blocks": [
      { "type": "step", "settings": { "text": "Fill out the form" } },
      { "type": "step", "settings": { "text": "We create your song and your animated music video" } },
      { "type": "step", "settings": { "text": "Receive it by email —\u00a0ready to share" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-how{--cs-duo-how-on:#fff;--cs-duo-how-hl:#fff;background:var(--cs-night)}
.cs-duo-how .cs-dhw{position:relative;display:flex;overflow:hidden;isolation:isolate}
.cs-duo-how .cs-dhw--sm{min-height:clamp(280px,40vw,420px)}
.cs-duo-how .cs-dhw--med{min-height:clamp(340px,46vw,560px)}
.cs-duo-how .cs-dhw--lg{min-height:clamp(390px,56vw,720px)}
.cs-duo-how .cs-dhw::after{content:"";position:absolute;inset:0;background:var(--cs-night);opacity:var(--cs-dhw-scrim,.6);pointer-events:none;z-index:1}
.cs-duo-how .cs-dhw-media{position:absolute;inset:0;z-index:0}
.cs-duo-how .cs-dhw-media img{width:100%;height:100%;object-fit:cover;object-position:center}
.cs-duo-how .cs-dhw-media--m{display:none}
.cs-duo-how .cs-dhw-empty{display:grid;place-items:center;gap:12px;padding:26px;text-align:center;background:linear-gradient(140deg,var(--cs-night) 0%,var(--cs-night-line) 100%);color:var(--cs-night-ink2)}
.cs-duo-how .cs-dhw-empty svg{width:46px;height:46px}
.cs-duo-how .cs-dhw-empty span{font-size:.86rem;font-weight:600;max-width:34ch;line-height:1.4}
.cs-duo-how .cs-dhw-content{position:relative;z-index:2;display:flex;align-items:center;width:100%;padding:clamp(40px,6vw,76px) 0}
.cs-duo-how .cs-dhw-wrap{width:100%}
.cs-duo-how .cs-dhw-box{max-width:620px;display:flex;flex-direction:column;align-items:flex-start;gap:clamp(14px,2vw,20px);text-align:left;color:var(--cs-duo-how-on)}
.cs-duo-how .cs-dhw-h{color:var(--cs-duo-how-on);text-shadow:0 2px 18px rgba(28,21,51,.35)}
.cs-duo-how .cs-dhw-hl{font-style:italic;color:var(--cs-duo-how-hl)}
.cs-duo-how .cs-dhw-lines{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:clamp(8px,1.4vw,12px)}
.cs-duo-how .cs-dhw-line{font-size:clamp(1.02rem,1.9vw,1.2rem);line-height:1.45;color:var(--cs-duo-how-on);text-shadow:0 1px 12px rgba(28,21,51,.4)}
.cs-duo-how .cs-dhw-n{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
.cs-duo-how .cs-dhw-eyebrow{text-shadow:none}
.cs-duo-how .cs-dhw-hint{font-size:.86rem;font-weight:600;color:var(--cs-night-ink2)}
.cs-duo-how .cs-dhw-btns{margin-top:clamp(4px,1vw,10px)}
.cs-duo-how .cs-dhw-cta{white-space:nowrap}
@media(max-width:749px){
  .cs-duo-how .cs-dhw-media--d{display:none}
  .cs-duo-how .cs-dhw-media--m{display:block}
  .cs-duo-how .cs-dhw{padding-bottom:20px}
  .cs-duo-how .cs-dhw--m-stack{flex-direction:column;min-height:0;overflow:visible}
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-media{position:relative;inset:auto;aspect-ratio:1/1;width:100%}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--noimg .cs-dhw-media{aspect-ratio:auto;min-height:190px}
  .cs-duo-how .cs-dhw--m-stack::after{display:none}
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-content{padding:26px 0 30px}
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-wrap{padding:0}
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-box{max-width:none;width:100%;padding:0 22px}
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-h,
  .cs-duo-how .cs-dhw--m-stack .cs-dhw-line{text-shadow:none}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-night .cs-dhw-content{background:var(--cs-night)}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-coral{--cs-duo-how-hl:var(--cs-star)}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-coral .cs-dhw-content{background:var(--cs-coral)}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-coral .cs-dhw-cta{background:var(--cs-night);box-shadow:none}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-paper{--cs-duo-how-on:var(--cs-ink);--cs-duo-how-hl:var(--cs-coral)}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-paper .cs-dhw-content{background:var(--cs-paper)}
  .cs-duo-how .cs-dhw--m-stack.cs-dhw--panel-paper .cs-dhw-eyebrow{color:var(--cs-gold)}
  .cs-duo-how .cs-dhw--m-over .cs-dhw-content{padding:clamp(30px,9vw,46px) 0}
  .cs-duo-how .cs-dhw--m-over .cs-dhw-box{max-width:none}
}

/* Une fleche blanche apres le libelle : le bouton dit ou cliquer. */
.cs-dhw-cta::after{content:"\2192";font-weight:800;line-height:1;transition:transform .18s ease}
.cs-dhw-cta:hover::after{transform:translateX(3px)}
{% endstylesheet %}
