{%- comment -%}
  CraftStory Duo Trust — three-benefit icon bar.
  Structural clone of the reference icon bar: no heading, one centred icon card per item
  (filled check mark, bold serif title, one line of detail), three columns on desktop with a
  4px gutter, and a two-up snap carousel with dots AND prev/next arrows underneath at phone
  width (the reference's splide__dots-and-arrows, mobile-arrows-under).
  Nothing here states a customer count, a review count or a turnaround: the delivery promise
  lives in the third block's title so the owner writes his own.
  Title and Detail have NO default on purpose: a stored block that only carries the legacy
  `text` line must keep rendering that line (Shopify fills an absent setting from the schema
  default, so any non-blank default would overwrite every live page). The reference-shaped
  copy lives in `presets`, which is what a newly inserted section uses.
{%- endcomment -%}

{%- assign ib_count = section.blocks.size -%}
{%- assign ib_cols = section.settings.columns_desktop | times: 1 -%}
{%- if ib_count > 0 -%}
  {%- comment -%} Never leave an empty column, and never leave a single orphan on a second row. {%- endcomment -%}
  {%- if ib_count < ib_cols -%}{%- assign ib_cols = ib_count -%}{%- endif -%}
  {%- assign ib_last_row = ib_count | modulo: ib_cols -%}
  {%- if ib_last_row == 1 and ib_count <= 4 -%}{%- assign ib_cols = ib_count -%}{%- endif -%}
{%- endif -%}

{%- if ib_count > 0 or request.design_mode -%}
<div class="cs cs-duo-trust cs-ib cs-ib-ico-{{ section.settings.icon_color }} cs-ib-style-{{ section.settings.card_style }}{% if section.settings.mobile_carousel and ib_count > 1 %} cs-ib-slider{% endif %}"
  style="--cs-duo-ib-cols:{{ ib_cols }};--cs-duo-ib-gap:{{ section.settings.gap_desktop }}px"
  data-mobile-columns="2"
  data-cs-ib>
  <div class="cs-wrap cs-ib-wrap">

    {%- if section.settings.heading != blank -%}
      <h2 class="cs-h2 cs-ib-head">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if ib_count > 0 -%}
      <div class="cs-ib-track" data-cs-ib-track>
        {%- for block in section.blocks -%}
          {%- assign ib_title = block.settings.title | default: block.settings.text -%}
          <div class="cs-ib-slide" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="cs-ib-card">
              <div class="cs-ib-ico cs-ib-ico--{{ section.settings.icon_size }}" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'stars' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.6l2.6 5.8 6.3.7-4.7 4.2 1.3 6.2L12 16.4l-5.5 3.1 1.3-6.2L3.1 9.1l6.3-.7z"/></svg>
                  {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2" stroke-linecap="round"/></svg>
                  {%- when 'mail' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6" stroke-linecap="round"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3l7 3v6c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6l7-3z" stroke-linejoin="round"/><path d="M9 12l2.2 2.2L15.5 10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'note' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 18V6.5l9-2V16" stroke-linejoin="round"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="15.5" cy="16" r="2.5"/></svg>
                  {%- when 'video' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2.6" y="6" width="13" height="12" rx="2.4"/><path d="M15.6 11l5-3v8l-5-3z" stroke-linejoin="round"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 20.2S4.8 16 4.8 10.8A3.9 3.9 0 0 1 12 8.5a3.9 3.9 0 0 1 7.2 2.3c0 5.2-7.2 9.4-7.2 9.4z" stroke-linejoin="round"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2Zm-2.45 15.6L4.65 12.7l1.41-1.41 3.49 3.49 8.39-8.39 1.41 1.41L9.55 17.6Z"/></svg>
                {%- endcase -%}
              </div>
              {%- if ib_title != blank or block.settings.body != blank -%}
                <div class="cs-ib-info">
                  {%- if ib_title != blank -%}<h3 class="cs-ib-t">{{ ib_title }}</h3>{%- endif -%}
                  {%- if block.settings.body != blank -%}<div class="cs-ib-b"><p>{{ block.settings.body }}</p></div>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.mobile_carousel -%}
        {%- assign ib_pages = ib_count | plus: 1 | divided_by: 2 -%}
        {%- if ib_pages > 1 -%}
          {%- comment -%} The reference closes the carousel with dots AND arrows in one wrapper. {%- endcomment -%}
          <div class="cs-ib-nav">
            <ul class="cs-ib-dots" role="tablist" aria-label="Select a slide to show" data-cs-ib-dots>
              {%- for i in (1..ib_pages) -%}
                <li>
                  <button type="button" class="cs-ib-dot{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show benefits {{ forloop.index }} of {{ ib_pages }}" data-cs-ib-page="{{ forloop.index0 }}"></button>
                </li>
              {%- endfor -%}
            </ul>
            <div class="cs-ib-arrows">
              <button type="button" class="cs-ib-arrow cs-ib-arrow--prev" aria-label="Previous slide" data-cs-ib-prev disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14.5 5.5L8 12l6.5 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button type="button" class="cs-ib-arrow cs-ib-arrow--next" aria-label="Next slide" data-cs-ib-next>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9.5 5.5L16 12l-6.5 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <p class="cs-ib-empty">Add three Benefit blocks — Theme editor ▸ CraftStory Duo Trust ▸ Add block.</p>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "CraftStory Duo Trust",
  "settings": [
    { "type": "paragraph", "content": "The three-benefit icon bar: a check mark, a bold title and one line of detail, three across on desktop and two-up with dots on a phone. Keep every line true — no customer counts, no review counts, no star ratings, and state our own turnaround rather than copying anyone else's." },
    { "type": "text", "id": "heading", "label": "Heading (optional)", "info": "The reference bar has no heading. Leave this empty and nothing is rendered." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "range", "id": "gap_desktop", "label": "Gap between cards on desktop", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipeable two-up carousel on mobile", "default": true, "info": "How the reference behaves at phone width: two cards visible, 15px apart, swipe for the rest, dots underneath. Untick for a plain two-column grid." },
    { "type": "header", "content": "Cards" },
    { "type": "select", "id": "card_style", "label": "Card background", "default": "flat", "options": [
      { "value": "flat", "label": "Flat — same paper as the section (reference)" },
      { "value": "card", "label": "White card with a hairline border" }
    ] },
    { "type": "select", "id": "icon_size", "label": "Icon size", "default": "medium", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "select", "id": "icon_color", "label": "Icon colour", "default": "coral", "options": [
      { "value": "coral", "label": "Coral (reference accent)" },
      { "value": "gold", "label": "Gold" },
      { "value": "ink", "label": "Ink" }
    ], "info": "The reference paints the check marks in its warm accent. Switch to gold if you want coral kept for the button alone." }
  ],
  "blocks": [
    { "type": "item", "name": "Benefit", "limit": 6, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
        { "value": "check", "label": "Check mark (reference)" },
        { "value": "note", "label": "Music note" },
        { "value": "video", "label": "Video" },
        { "value": "heart", "label": "Heart" },
        { "value": "clock", "label": "Clock" },
        { "value": "mail", "label": "Email" },
        { "value": "shield", "label": "Shield" },
        { "value": "stars", "label": "Star" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "info": "Two to five words, Title Case. For the delivery benefit, write the turnaround we actually keep. Left empty on purpose: a non-blank default would overwrite every block that a page already stores." },
      { "type": "textarea", "id": "body", "label": "Detail", "info": "One sentence, no full stop needed. Keep it short — at phone width two cards share the screen. Empty by default for the same reason as Title." },
      { "type": "text", "id": "text", "label": "Short line (legacy)", "info": "The one-line version used by the older thin band. Only read when Title is empty, so old pages keep rendering. Fill Title instead." }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Trust", "blocks": [
      { "type": "item", "settings": {
        "icon": "check",
        "title": "Studio-Quality Song and Video",
        "body": "A professionally produced song and an animated music video you will be proud to play for family and friends"
      } },
      { "type": "item", "settings": {
        "icon": "check",
        "title": "Written From YOUR Story",
        "body": "Every word and every scene comes from the details you share: your names, how you met, the moments only the two of you remember"
      } },
      { "type": "item", "settings": {
        "icon": "check",
        "title": "Delivered Straight to Your Inbox",
        "body": "Ready for the anniversary, the wedding or the moment you already have planned"
      } }
    ] }
  ]
}
{% endschema %}

{% stylesheet %}
.cs-duo-trust{
  background:var(--cs-paper);
  padding-top:27px;padding-bottom:24px;
  --cs-duo-ib-check:var(--cs-coral-deep);
  --cs-duo-ib-card-bg:transparent;
  --cs-duo-ib-card-line:transparent;
  --cs-duo-ib-card-pad:14px 8px;
  --cs-duo-ib-ico:34px;
  --cs-duo-ib-slide-gap:15px;
  --cs-duo-ib-slide-edge:24px;
}
.cs-ib-ico-gold{--cs-duo-ib-check:var(--cs-gold)}
.cs-ib-ico-ink{--cs-duo-ib-check:var(--cs-ink)}
.cs-ib-style-card{--cs-duo-ib-card-bg:var(--cs-card);--cs-duo-ib-card-line:var(--cs-line);--cs-duo-ib-card-pad:18px 14px}

.cs-ib-wrap{display:flex;flex-direction:column;align-items:center;gap:13px}
.cs .cs-ib-head{text-align:center;margin:0 0 2px}
.cs-ib-empty{font-size:.9rem;color:var(--cs-ink3);text-align:center}

/* Plain two-up grid — mobile default when the carousel is off */
.cs-ib-track{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--cs-duo-ib-slide-gap);width:100%}

/* Two-up snap carousel, bleeding to the screen edges with a 24px inset */
.cs-ib-slider .cs-ib-track{
  grid-template-columns:none;grid-auto-flow:column;
  grid-auto-columns:calc((100% - var(--cs-duo-ib-slide-gap)) / 2);
  overflow-x:auto;overflow-y:hidden;
  scroll-snap-type:x mandatory;scroll-behavior:smooth;
  padding:0 var(--cs-duo-ib-slide-edge);
  scroll-padding-inline-start:var(--cs-duo-ib-slide-edge);
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;-ms-overflow-style:none;
}
.cs-ib-slider .cs-ib-track::-webkit-scrollbar{width:0;height:0;display:none}
.cs-ib-slide{min-width:0;scroll-snap-align:start}
/* A single benefit fills the row instead of sitting in half of a two-column grid */
.cs-ib-slide:only-child{grid-column:1 / -1}

.cs-ib-card{
  height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;
  text-align:center;gap:9px;padding:var(--cs-duo-ib-card-pad);
  background:var(--cs-duo-ib-card-bg);border:1px solid var(--cs-duo-ib-card-line);border-radius:var(--cs-r);
}
/* The size modifier sits on the icon wrapper, as it does in the reference */
.cs-ib-ico{flex:0 0 auto;width:var(--cs-duo-ib-ico);height:var(--cs-duo-ib-ico);
  color:var(--cs-duo-ib-check);line-height:0}
.cs-ib-ico--small{--cs-duo-ib-ico:26px}
.cs-ib-ico--medium{--cs-duo-ib-ico:34px}
.cs-ib-ico--large{--cs-duo-ib-ico:42px}
.cs-ib-ico svg{width:100%;height:100%;display:block}
.cs-ib-info{display:flex;flex-direction:column;gap:6px}
/* Two classes deep on purpose: `.cs h3` in cs-head is (0,1,1) and would otherwise win. */
.cs .cs-ib-t{font-family:var(--cs-serif);font-weight:700;font-size:clamp(.96rem,3.1vw,1.16rem);
  line-height:1.16;letter-spacing:-.01em;color:var(--cs-ink)}
.cs-ib-b p{font-size:clamp(.78rem,2.4vw,.94rem);line-height:1.45;color:var(--cs-ink2)}

/* Dots and arrows, both under the slider (the reference's splide__dots-and-arrows) */
.cs-ib-nav{display:flex;flex-direction:column;align-items:center;gap:5px}
.cs-ib-dots{display:flex;align-items:center;justify-content:center;gap:2px;
  margin:0;padding:0;list-style:none}
.cs-ib-dots li{display:flex}
.cs-ib-dot{position:relative;width:22px;height:22px;padding:0;border:0;background:none;cursor:pointer;
  -webkit-appearance:none;appearance:none}
.cs-ib-dot::before{content:"";position:absolute;inset:7px;border-radius:var(--cs-pill);
  background:var(--cs-ink3);opacity:.35;transition:opacity .2s,background .2s,transform .2s}
.cs-ib-dot.is-active::before{background:var(--cs-duo-ib-check);opacity:1;transform:scale(1.15)}
.cs-ib-arrows{display:flex;align-items:center;justify-content:center;gap:12px}
.cs-ib-arrow{display:inline-flex;align-items:center;justify-content:center;
  width:34px;height:34px;padding:0;border:0;border-radius:var(--cs-pill);
  background:transparent;color:var(--cs-ink2);cursor:pointer;
  -webkit-appearance:none;appearance:none;transition:color .18s,opacity .18s}
.cs-ib-arrow svg{width:18px;height:18px;display:block}
.cs-ib-arrow:hover{color:var(--cs-ink)}
.cs-ib-arrow[disabled]{opacity:.32;cursor:default}

/* Reveal on scroll. The pre-animation state is only applied once the script is running,
   so the cards stay visible when JavaScript does not. */
.cs-ib-anim .cs-ib-card{opacity:0;transform:translateY(14px)}
.cs-ib-anim.cs-ib-in .cs-ib-card{opacity:1;transform:none;
  transition:opacity .5s ease,transform .5s ease;transition-delay:calc(var(--i, 0) * 80ms)}

@media screen and (min-width:750px){
  .cs-duo-trust{padding-top:36px;padding-bottom:32px;--cs-duo-ib-card-pad:16px 12px}
  .cs-ib-style-card{--cs-duo-ib-card-pad:22px 18px}
  .cs-ib-ico--medium{--cs-duo-ib-ico:38px}
  .cs-ib-ico--large{--cs-duo-ib-ico:48px}
  .cs-ib-wrap{gap:16px}
  .cs-ib-track,.cs-ib-slider .cs-ib-track{
    grid-auto-flow:row;grid-auto-columns:auto;
    grid-template-columns:repeat(var(--cs-duo-ib-cols, 3),minmax(0,1fr));
    gap:var(--cs-duo-ib-gap, 4px);
    overflow:visible;padding:0;scroll-snap-type:none;
  }
  /* The carousel is torn down at this width, so its controls go with it */
  .cs-ib-nav{display:none}
}

@media screen and (max-width:749px){
  /* mobile-full-page: the track owns the side padding so the cards can bleed off-screen */
  .cs-ib-slider .cs-ib-wrap{padding:0}
  .cs-ib-slider .cs-ib-head{padding:0 var(--cs-duo-ib-slide-edge)}
  /* The snap track must clip on the x axis, so inside it the reveal fades only:
     a translated card would be cut off at the bottom mid-transition. */
  .cs-ib-slider.cs-ib-anim .cs-ib-card,
  .cs-ib-slider.cs-ib-anim.cs-ib-in .cs-ib-card{transform:none}
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.csIbReady) return;
    root.dataset.csIbReady = '1';

    var track = root.querySelector('[data-cs-ib-track]');
    var dots = root.querySelector('[data-cs-ib-dots]');

    if ('IntersectionObserver' in window) {
      root.classList.add('cs-ib-anim');
      var io = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            root.classList.add('cs-ib-in');
            io.disconnect();
            return;
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      io.observe(root);
      // Safety net: never leave the cards hidden if the observer never fires.
      setTimeout(function () { root.classList.add('cs-ib-in'); }, 2500);
    }

    if (!track) return;
    var btns = dots ? Array.prototype.slice.call(dots.querySelectorAll('[data-cs-ib-page]')) : [];
    var prev = root.querySelector('[data-cs-ib-prev]');
    var next = root.querySelector('[data-cs-ib-next]');
    if (!btns.length && !prev && !next) return;

    var slides = Array.prototype.slice.call(track.children);
    var perPage = 2; /* matches the two-up mobile track */
    var pages = btns.length ? btns.length : Math.ceil(slides.length / perPage);
    if (pages < 2) return;

    function maxScroll() { return track.scrollWidth - track.clientWidth; }

    function edgeInset() {
      var v = parseFloat(window.getComputedStyle(track).paddingLeft);
      return v > 0 ? v : 0;
    }

    /* Scroll offset of the first card of page p — a real snap position, not a
       fraction of the maximum scroll. */
    function pageStart(p) {
      var el = slides[p * perPage];
      if (!el) return 0;
      var x = track.scrollLeft +
        (el.getBoundingClientRect().left - track.getBoundingClientRect().left) -
        edgeInset();
      return Math.max(0, Math.min(Math.round(x), maxScroll()));
    }

    function currentPage() {
      if (maxScroll() <= 4) return 0;
      var x = track.scrollLeft, best = 0, bestGap = Infinity;
      for (var p = 0; p < pages; p++) {
        var gap = Math.abs(pageStart(p) - x);
        if (gap < bestGap) { bestGap = gap; best = p; }
      }
      return best;
    }

    function sync() {
      var page = currentPage();
      var off = maxScroll() <= 4;
      for (var i = 0; i < btns.length; i++) {
        var on = i === page;
        btns[i].classList.toggle('is-active', on);
        btns[i].setAttribute('aria-selected', on ? 'true' : 'false');
      }
      if (prev) prev.disabled = off || page <= 0;
      if (next) next.disabled = off || page >= pages - 1;
    }

    function go(p) {
      if (maxScroll() <= 0) return;
      if (p < 0) p = 0;
      if (p > pages - 1) p = pages - 1;
      track.scrollLeft = pageStart(p);
    }

    btns.forEach(function (btn, i) {
      btn.addEventListener('click', function () { go(i); });
    });
    if (prev) prev.addEventListener('click', function () { go(currentPage() - 1); });
    if (next) next.addEventListener('click', function () { go(currentPage() + 1); });

    var timer;
    track.addEventListener('scroll', function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 70);
    }, { passive: true });

    window.addEventListener('resize', function () {
      clearTimeout(timer);
      timer = setTimeout(sync, 150);
    });

    sync();
  }

  function initAll() {
    var nodes = document.querySelectorAll('[data-cs-ib]');
    for (var i = 0; i < nodes.length; i++) init(nodes[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('shopify:section:load', initAll);
})();
{% endjavascript %}
