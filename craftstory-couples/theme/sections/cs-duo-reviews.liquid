{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.quote != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<div class="cs cs-duo-rev" data-layout="{{ section.settings.layout }}">
  <div class="cs-wrap">
    <div class="cs-sec">
      <div class="cs-sec-head">
        {%- if section.settings.eyebrow != blank -%}<span class="cs-eyebrow">✦ {{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="cs-h2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.proof_line != blank -%}
          <p class="cs-rev-proof"><span class="cs-rev-stars" aria-hidden="true">★★★★★</span> {{ section.settings.proof_line }}</p>
        {%- endif -%}
      </div>

      {%- comment -%}
        Le recapitulatif facultatif. Il n'existe que si un score est saisi :
        une note inventee est interdite ici comme ailleurs, et un panneau vide
        vaut mieux qu'un chiffre faux.
      {%- endcomment -%}
      {%- if section.settings.rating_score != blank -%}
        {%- assign bars = section.settings.rating_bars | newline_to_br | split: '<br />' -%}
        <div class="cs-rev-score">
          <div class="cs-rev-score-n">
            {%- if section.settings.rating_label != blank -%}<p class="cs-rev-score-l">{{ section.settings.rating_label }}</p>{%- endif -%}
            <p class="cs-rev-score-v">{{ section.settings.rating_score }}</p>
            <span class="cs-rev-stars" aria-hidden="true">★★★★★</span>
            {%- if section.settings.rating_count != blank -%}<p class="cs-rev-score-c">{{ section.settings.rating_count }}</p>{%- endif -%}
          </div>
          {%- if section.settings.rating_bars != blank -%}
            <ul class="cs-rev-bars">
              {%- for line in bars -%}
                {%- assign pair = line | strip | split: '|' -%}
                {%- if pair[0] != blank -%}
                  {%- assign pc = pair[1] | default: '0' | strip | plus: 0 -%}
                  <li><span>{{ pair[0] | strip }}</span><i><b style="width:{{ pc }}%"></b></i><small>{{ pc }}%</small></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if filled > 0 -%}
        <div class="cs-rev-track" data-cs-rev>
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank or block.settings.quote != blank -%}
              <figure class="cs-rev-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img class="cs-rev-shot" src="{{ block.settings.image | image_url: width: 900 }}"
                       alt="{{ block.settings.image.alt | default: 'Customer review' | escape }}" loading="lazy">
                {%- else -%}
                  <blockquote class="cs-rev-q">
                    {%- if block.settings.stars != blank -%}<span class="cs-rev-stars" aria-hidden="true">{{ block.settings.stars }}</span>{%- endif -%}
                    <p>{{ block.settings.quote }}</p>
                    {%- if block.settings.name != blank -%}
                      <footer class="cs-rev-by">
                        {%- if block.settings.avatar != blank -%}
                          <img class="cs-rev-face" src="{{ block.settings.avatar | image_url: width: 120 }}"
                               alt="{{ block.settings.name | escape }}" width="44" height="44" loading="lazy">
                        {%- endif -%}
                        <span class="cs-rev-who">{{ block.settings.name }}{% if block.settings.meta != blank %}<span class="cs-rev-meta">{{ block.settings.meta }}</span>{% endif %}</span>
                      </footer>
                    {%- endif -%}
                  </blockquote>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="cs-rev-dots" data-cs-rev-dots hidden></div>
      {%- elsif request.design_mode -%}
        <div class="cs-rev-empty">
          <strong>No reviews yet — this section stays hidden on the storefront.</strong>
          Add a real customer's words, or a screenshot of their message, to a block.
          It appears the moment you do.
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and filled > 0 -%}
        <div class="cs-rev-cta"><a class="cs-btn cs-btn-primary cs-btn-lg" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a></div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "CraftStory Duo Reviews",
  "settings": [
    { "type": "paragraph", "content": "A swipeable row of customer reviews. Two formats per block: a screenshot of a real message, or a typed quote. The whole section hides itself on the storefront while every block is empty, so the page never shows an empty shelf." },
    { "type": "paragraph", "content": "Only real customer words go here. Invented reviews, invented names and invented counts are illegal in the US and the UK, get ad accounts rejected, and are already forbidden by this store's copy rules. The fastest honest fill: email every buyer on delivery day and ask for one line plus permission to quote it." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What happens when they press play." },
    { "type": "text", "id": "proof_line", "label": "Proof line", "info": "Leave empty until the number is real. Example once it is: \"4.9 from 63 couples\"." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "rail",
      "options": [
        { "value": "rail", "label": "Swipeable row" },
        { "value": "list", "label": "Stacked list" }
      ],
      "info": "The stacked list suits a page where reading every review is the point, like the page after the flow." },
    { "type": "header", "content": "Rating summary" },
    { "type": "paragraph", "content": "The panel above the reviews. It only appears once a score is filled in, and the same rule applies as to the reviews themselves: a real score or none." },
    { "type": "text", "id": "rating_score", "label": "Score", "info": "For example 4.9" },
    { "type": "text", "id": "rating_label", "label": "Label above the score", "info": "For example Excellent" },
    { "type": "text", "id": "rating_count", "label": "Line under the stars", "info": "For example Based on 63 reviews" },
    { "type": "textarea", "id": "rating_bars", "label": "Bars", "info": "One per line, label then a vertical bar then the percentage. For example: 5 stars|87" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Free Preview" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "limit": 16, "settings": [
      { "type": "paragraph", "content": "Either drop a screenshot, or type the quote. A screenshot wins when you have one." },
      { "type": "image_picker", "id": "avatar", "label": "Their photo", "info": "Small round face beside the name. Optional." },
      { "type": "image_picker", "id": "image", "label": "Screenshot of the message" },
      { "type": "textarea", "id": "quote", "label": "Quote (their exact words)" },
      { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
      { "type": "text", "id": "name", "label": "Who said it" },
      { "type": "text", "id": "meta", "label": "Context", "info": "For example: 10th anniversary" }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Reviews", "blocks": [
      { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-rev{background:var(--cs-paper2)}
.cs-rev-proof{display:flex;align-items:center;justify-content:center;gap:.5em;font-weight:600;color:var(--cs-ink2);font-size:1rem}
.cs-rev-stars{color:var(--cs-star);letter-spacing:.08em;font-size:1.02em;line-height:1}
.cs-rev-track{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(12px,1.6vw,18px);align-items:start}

/* La liste empilee. Une seule colonne, pleine largeur, et plus de rail : les
   regles du glissement plus bas sont donc neutralisees ici. */
.cs-duo-rev[data-layout="list"] .cs-wrap{max-width:560px}
.cs-duo-rev[data-layout="list"] .cs-rev-track{display:flex;flex-direction:column;
  grid-template-columns:none;gap:12px;overflow:visible;cursor:auto;scroll-snap-type:none}
.cs-duo-rev[data-layout="list"] .cs-rev-card{flex:1 1 auto;width:auto;min-width:0;scroll-snap-align:none}
.cs-duo-rev[data-layout="list"] .cs-rev-dots{display:none !important}

/* Le recapitulatif de note */
.cs-rev-score{display:flex;gap:clamp(14px,3vw,26px);align-items:center;margin-bottom:clamp(18px,3.4vw,26px);
  padding:clamp(16px,3vw,22px);border-radius:var(--cs-r-lg);background:var(--cs-card);border:1px solid var(--cs-line)}
.cs-rev-score-n{flex:0 0 auto;text-align:center}
.cs-rev-score-l{margin:0;font-weight:800;font-size:.86rem;color:var(--cs-ink)}
.cs-rev-score-v{margin:2px 0 3px;font-family:var(--cs-serif);font-weight:600;font-size:2.1rem;line-height:1;
  letter-spacing:-.02em;color:var(--cs-ink)}
.cs-rev-score-c{margin:5px 0 0;font-size:.78rem;color:var(--cs-ink3);line-height:1.35}
.cs-rev-bars{flex:1 1 auto;min-width:0;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
.cs-rev-bars li{display:flex;align-items:center;gap:8px;font-size:.78rem;color:var(--cs-ink3)}
.cs-rev-bars span{flex:0 0 3.6em;white-space:nowrap}
.cs-rev-bars i{flex:1 1 auto;height:7px;border-radius:var(--cs-pill);background:var(--cs-line);overflow:hidden}
.cs-rev-bars b{display:block;height:100%;border-radius:var(--cs-pill);background:var(--cs-star)}
.cs-rev-bars small{flex:0 0 2.6em;text-align:right;font-variant-numeric:tabular-nums}
@media(max-width:480px){.cs-rev-score{flex-direction:column;gap:14px}.cs-rev-bars{width:100%}}
.cs-rev-card{margin:0;background:var(--cs-card);border:1px solid var(--cs-line);border-radius:var(--cs-r-lg);box-shadow:var(--cs-sh-sm);overflow:hidden}
.cs-rev-shot{width:100%;height:auto;display:block}
.cs-rev-q{margin:0;padding:clamp(16px,2vw,22px);display:flex;flex-direction:column;gap:10px}
.cs-rev-q p{font-family:var(--cs-serif);font-weight:600;font-size:clamp(1rem,1.4vw,1.1rem);line-height:1.35;color:var(--cs-ink)}
.cs-rev-by{font-size:.86rem;font-weight:700;color:var(--cs-ink2);display:flex;align-items:center;gap:10px;margin-top:auto}
.cs-rev-face{width:44px;height:44px;flex:0 0 44px;border-radius:var(--cs-pill);object-fit:cover}
.cs-rev-who{display:flex;flex-direction:column;gap:1px;min-width:0}
.cs-rev-meta{font-weight:600;color:var(--cs-ink3);font-size:.81rem}
.cs-rev-empty{max-width:640px;margin:0 auto;text-align:center;background:var(--cs-card);border:1px dashed var(--cs-ink3);border-radius:var(--cs-r-lg);padding:22px;color:var(--cs-ink2);font-size:.94rem;line-height:1.55}
.cs-rev-empty strong{display:block;color:var(--cs-ink);margin-bottom:5px}
.cs-rev-cta{display:flex;justify-content:center;margin-top:clamp(24px,3.4vw,38px)}
@media(max-width:1040px){
  .cs-duo-rev .cs-sec{padding:clamp(34px,7vw,52px) 0}
  .cs-rev-track{display:flex;grid-template-columns:none;gap:12px;overflow-x:auto;
    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;
    padding:2px 22px 4px;margin:0 -22px}
  .cs-rev-track::-webkit-scrollbar{display:none}
  .cs-rev-card{flex:0 0 78%;scroll-snap-align:center}
  .cs-rev-cta{width:100%}
  .cs-rev-cta .cs-btn{width:100%}
}

/* Une fleche blanche apres le libelle : le bouton dit ou cliquer. */
.cs-rev-cta .cs-btn::after{content:"\2192";font-weight:800;line-height:1;transition:transform .18s ease}
.cs-rev-cta .cs-btn:hover::after{transform:translateX(3px)}

/* Les bulles rendent le glissement visible : sans elles, rien ne dit qu'il
   reste des avis a droite. Elles servent aussi de raccourci au clic. */
.cs-rev-track{cursor:grab}
/* Pendant le glissement l'accrochage se battrait avec le doigt : on le coupe. */
.cs-rev-track.cs-rev-drag{cursor:grabbing;scroll-snap-type:none;user-select:none}
.cs-rev-dots{display:none;justify-content:center;align-items:center;gap:7px;margin-top:15px}
.cs-rev-dots button{width:7px;height:7px;padding:0;border:0;border-radius:var(--cs-pill);
  background:var(--cs-line);cursor:pointer;transition:background .2s ease,width .2s ease}
.cs-rev-dots button[aria-current="true"]{background:var(--cs-coral);width:19px}
@media(max-width:1040px){.cs-rev-dots{display:flex}}

/* Le libelle et la fleche restent sur une seule ligne : sur un ecran etroit
   le bouton passait sur deux lignes avec la fleche seule a droite. */
.cs-rev-cta .cs-btn{white-space:nowrap}
@media(max-width:560px){.cs-rev-cta .cs-btn{font-size:clamp(.82rem,3.7vw,1.07rem);padding-left:16px;padding-right:16px}}
{% endstylesheet %}
{% javascript %}
(function () {
  function setup(track) {
    // En liste, il n'y a ni glissement ni bulles a gerer : le rail n'existe pas.
    var host = track.closest('.cs-duo-rev');
    if (host && host.getAttribute('data-layout') === 'list') return;
    // Ce drapeau ne doit JAMAIS reprendre le nom d'attribut des bulles :
    // track.dataset.csRevDots poserait data-cs-rev-dots sur le rail, le
    // querySelector ci-dessous trouverait le rail avant les bulles, et
    // dots.innerHTML = '' effacerait les quatre avis a chaque chargement.
    if (track.dataset.csRevReady) return;
    track.dataset.csRevReady = '1';

    var dots = track.parentNode.querySelector('[data-cs-rev-dots]');
    var cards = track.querySelectorAll('.cs-rev-card');
    if (!dots || cards.length < 2) return;

    dots.hidden = false;
    dots.innerHTML = '';

    // scrollIntoView ferait aussi defiler la page verticalement. On calcule la
    // position dans le rail pour ne bouger que lui.
    function go(n) {
      var card = cards[n];
      track.scrollTo({
        left: card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2,
        behavior: 'smooth'
      });
    }

    for (var i = 0; i < cards.length; i++) {
      (function (n) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', 'Review ' + (n + 1));
        b.addEventListener('click', function () { go(n); });
        dots.appendChild(b);
      })(i);
    }

    function mark() {
      var middle = track.scrollLeft + track.clientWidth / 2;
      var best = 0, closest = Infinity;
      for (var i = 0; i < cards.length; i++) {
        var gap = Math.abs(cards[i].offsetLeft + cards[i].offsetWidth / 2 - middle);
        if (gap < closest) { closest = gap; best = i; }
      }
      for (var j = 0; j < dots.children.length; j++) {
        dots.children[j].setAttribute('aria-current', j === best ? 'true' : 'false');
      }
    }

    // Au doigt, overflow-x fait deja le travail. A la souris — donc dans
    // l'apercu de l'editeur — rien ne bouge sans ce glisser-deposer.
    var down = false, captured = false, startX = 0, startLeft = 0, moved = 0;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch') return;
      down = true; captured = false; moved = 0;
      startX = e.clientX; startLeft = track.scrollLeft;
    });
    track.addEventListener('pointermove', function (e) {
      if (!down) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > moved) moved = Math.abs(dx);
      // On ne capture le pointeur qu'une fois le glissement engage. Capturer
      // des le pointerdown detourne le pointerup vers le rail : le clic n'est
      // jamais emis, et tout bouton pose sur une carte devient mort.
      if (!captured && moved > 6) {
        captured = true;
        try { track.setPointerCapture(e.pointerId); } catch (err) {}
        track.classList.add('cs-rev-drag');
      }
      if (captured) track.scrollLeft = startLeft - dx;
    });
    function release() {
      if (!down) return;
      down = false; captured = false;
      track.classList.remove('cs-rev-drag');
    }
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
    track.addEventListener('pointerleave', release);
    // Un glissement ne doit pas se terminer en clic sur ce qu'il y a dessous.
    track.addEventListener('click', function (e) {
      if (moved > 6) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    var timer;
    track.addEventListener('scroll', function () {
      window.clearTimeout(timer);
      timer = window.setTimeout(mark, 60);
    }, { passive: true });
    mark();
  }

  function init(scope) {
    var host = scope && scope.querySelectorAll ? scope : document;
    var rails = host.querySelectorAll('[data-cs-rev]');
    for (var i = 0; i < rails.length; i++) setup(rails[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { init(document); });
  } else {
    init(document);
  }
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
})();
{% endjavascript %}
