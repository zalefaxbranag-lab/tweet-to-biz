{%- liquid
  assign menu_links = 0
  for block in section.blocks
    if block.type == 'link' and block.settings.label != blank
      assign menu_links = menu_links | plus: 1
    endif
  endfor
  assign drawer_id = 'cs-duo-menu-' | append: section.id
  assign search_id = 'cs-duo-search-' | append: section.id
  assign logo_w = section.settings.logo_width | default: 200
  assign logo_w_m = section.settings.logo_width_mobile | default: 120
-%}

{%- comment -%}
  Sticky has to live on the Shopify section wrapper, the way the reference header does
  (its wrapper carries position:sticky). The section stylesheet cannot read section.id,
  so only these few rules are inline. Everything else is in the stylesheet below.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}{
    {% if section.settings.sticky %}position:sticky;top:0;{% endif %}
    z-index:80;
  }
  #shopify-section-{{ section.id }} .cs-dhd-logo{
    --cs-dhd-logo-w:{{ logo_w }}px;
    --cs-dhd-logo-w-m:{{ logo_w_m }}px;
  }
</style>

<div class="cs cs-duo-head{% if section.settings.sticky %} cs-dhd-sticky{% endif %}" data-cs-head>
  <div class="cs-dhd-bar">
    <div class="cs-wrap cs-dhd-row">

      {%- comment -%} hamburger — visible at every width, like theirs (desktop drawer) {%- endcomment -%}
      <div class="cs-dhd-drawerbtn">
        <button
          type="button"
          class="cs-dhd-burger"
          data-cs-head-toggle
          aria-label="{{ section.settings.menu_label | default: 'Menu' | escape }}"
          aria-expanded="false"
          aria-controls="{{ drawer_id }}">
          <svg class="cs-dhd-ico cs-dhd-ico-open" viewBox="0 0 18 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M1 1h16M1 8h16M1 15h16"/>
          </svg>
          <svg class="cs-dhd-ico cs-dhd-ico-close" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M2 2l14 14M16 2L2 16"/>
          </svg>
        </button>
      </div>

      {%- comment -%} wordmark, with the small waveform mark above it {%- endcomment -%}
      <a class="cs-dhd-logo"
         href="{{ section.settings.logo_link | default: routes.root_url }}"
         {% if section.settings.logo_new_tab %}target="_blank" rel="noreferrer noopener"{% endif %}>
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 500 }}"
            srcset="{{ section.settings.logo | image_url: width: 200 }} 200w, {{ section.settings.logo | image_url: width: 300 }} 300w, {{ section.settings.logo | image_url: width: 400 }} 400w, {{ section.settings.logo | image_url: width: 500 }} 500w"
            sizes="(max-width: 749px) {{ logo_w_m }}px, {{ logo_w }}px"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            class="cs-dhd-logoimg"
            loading="eager">
        {%- else -%}
          {%- if section.settings.show_wave -%}
            <span class="cs-dhd-wave" aria-hidden="true">
              <svg viewBox="0 0 48 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" focusable="false">
                <path d="M2 7v0"/><path d="M8 4.5v5"/><path d="M14 2v10"/><path d="M20 5v4"/>
                <path d="M26 1v12"/><path d="M32 4v6"/><path d="M38 2.5v9"/><path d="M44 6v2"/>
              </svg>
            </span>
          {%- endif -%}
          <span class="cs-dhd-word">
            {{ section.settings.logo_text }}{% if section.settings.logo_text_accent != blank %} <em>{{ section.settings.logo_text_accent }}</em>{% endif %}
          </span>
        {%- endif -%}
      </a>

      {%- comment -%} right-hand icon rail {%- endcomment -%}
      <div class="cs-dhd-icons">

        <div class="cs-dhd-ctagroup">
          {%- if section.settings.track_label != blank -%}
            <a class="cs-dhd-track" href="{{ section.settings.track_link | default: '#' }}">{{ section.settings.track_label }}</a>
          {%- endif -%}
          {%- if section.settings.cta_label != blank -%}
            <a class="cs-dhd-cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="cs-dhd-iconbtn cs-dhd-searchbtn"
            data-cs-head-search
            aria-label="{{ section.settings.search_label | default: 'Search' | escape }}"
            aria-expanded="false"
            aria-controls="{{ search_id }}">
            <svg class="cs-dhd-ico cs-dhd-ico-open" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
              <circle cx="7.6" cy="7.6" r="5.6"/><path d="M11.8 11.8L16.5 16.5"/>
            </svg>
            <svg class="cs-dhd-ico cs-dhd-ico-close" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M2 2l14 14M16 2L2 16"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          <a class="cs-dhd-iconbtn cs-dhd-account" href="{{ routes.account_login_url }}">
            <svg viewBox="0 0 18 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
              <circle cx="9" cy="5.2" r="3.6"/><path d="M1.6 17.6c.6-4.2 3.3-6.2 7.4-6.2s6.8 2 7.4 6.2"/>
            </svg>
            <span class="cs-dhd-sr">{{ section.settings.login_label | default: 'Log in' }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a class="cs-dhd-iconbtn cs-dhd-cart" href="{{ routes.cart_url }}">
            <svg viewBox="0 0 18 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M1.8 6.2h14.4l.9 12.6H.9z"/><path d="M5.7 6.2V4.6a3.3 3.3 0 016.6 0v1.6"/>
            </svg>
            <span class="cs-dhd-sr">{{ section.settings.cart_label | default: 'Cart' }}</span>
          </a>
        {%- endif -%}

      </div>
    </div>

    {%- if section.settings.show_search -%}
      <div class="cs-dhd-searchpanel" id="{{ search_id }}" data-cs-head-searchpanel aria-hidden="true">
        <form class="cs-wrap cs-dhd-searchform" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="options[prefix]" value="last">
          <label class="cs-dhd-sr" for="{{ search_id }}-input">{{ section.settings.search_label | default: 'Search' }}</label>
          <input class="cs-dhd-searchinput" id="{{ search_id }}-input" type="search" name="q"
                 placeholder="{{ section.settings.search_label | default: 'Search' | escape }}"
                 autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
          <button class="cs-dhd-searchgo" type="submit">{{ section.settings.search_label | default: 'Search' }}</button>
        </form>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} the drawer itself {%- endcomment -%}
  <div class="cs-dhd-menu" id="{{ drawer_id }}" data-cs-head-drawer aria-hidden="true">
    <div class="cs-dhd-overlay" data-cs-head-close></div>
    <div class="cs-dhd-panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.menu_title | default: 'Menu' | escape }}" tabindex="-1" data-cs-head-panel>
      <div class="cs-dhd-panel-top">
        <h3 class="cs-dhd-title">{{ section.settings.menu_title | default: 'Menu' }}</h3>
        <button type="button" class="cs-dhd-close" data-cs-head-close aria-label="{{ section.settings.close_label | default: 'Close' | escape }}">
          <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M2 2l14 14M16 2L2 16"/>
          </svg>
        </button>
      </div>

      <nav class="cs-dhd-nav">
        {%- if menu_links > 0 -%}
          <ul class="cs-dhd-list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'link' and block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}>
                  <a class="cs-dhd-item" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <p class="cs-dhd-hint">Add the menu links — Theme editor ▸ CraftStory Duo Header ▸ Add block ▸ Menu link</p>
        {%- endif -%}
      </nav>

      {%- if section.settings.login_label != blank -%}
        <div class="cs-dhd-utility">
          <a class="cs-dhd-login" href="{{ routes.account_login_url }}">
            <svg viewBox="0 0 18 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
              <circle cx="9" cy="5.2" r="3.6"/><path d="M1.6 17.6c.6-4.2 3.3-6.2 7.4-6.2s6.8 2 7.4 6.2"/>
            </svg>
            <span>{{ section.settings.login_label }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "CraftStory Duo Header",
  "settings": [
    { "type": "paragraph", "content": "The bar at the top of the page: hamburger on the left, wordmark, then the orange button on the right. Every navigation link lives in the drawer — on phones and on desktop, the way the reference header works. Keep this section above CraftStory Duo Banner." },
    { "type": "checkbox", "id": "sticky", "label": "Stay at the top while scrolling", "default": true },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image", "info": "A wide wordmark, around 4:1. Leave it empty to use the text wordmark below." },
    { "type": "range", "id": "logo_width", "label": "Logo width on desktop", "min": 100, "max": 320, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width on mobile", "min": 80, "max": 200, "step": 5, "unit": "px", "default": 120 },
    { "type": "text", "id": "logo_text", "label": "Text wordmark", "default": "CraftStory", "info": "Used when no logo image is set." },
    { "type": "text", "id": "logo_text_accent", "label": "Second word, in coral", "default": "Couples" },
    { "type": "checkbox", "id": "show_wave", "label": "Small waveform mark above the wordmark", "default": true },
    { "type": "url", "id": "logo_link", "label": "Logo link", "info": "Empty means the home page." },
    { "type": "checkbox", "id": "logo_new_tab", "label": "Open the logo link in a new tab", "default": false, "info": "Off is the right behaviour for your own home page. The reference header has it on." },
    { "type": "header", "content": "Right-hand side" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Create Your Song" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#", "info": "Paste the path to the couples order form, for example /pages/couples-start" },
    { "type": "text", "id": "track_label", "label": "Text link before the button", "default": "Track Order", "info": "Desktop only, hidden below 990px — the same as the reference header." },
    { "type": "text", "id": "track_link", "label": "Text link target", "default": "#", "info": "For example /pages/track-your-order" },
    { "type": "checkbox", "id": "show_account", "label": "Show the account icon", "default": true, "info": "Hidden on phones, like theirs." },
    { "type": "checkbox", "id": "show_search", "label": "Show the search icon", "default": false, "info": "Off, because the reference header hides its search icon. Turn it on once the store has pages worth searching." },
    { "type": "checkbox", "id": "show_cart", "label": "Show the cart icon", "default": false, "info": "Off, because the reference header hides its cart. Turn it on when the store sells from a cart." },
    { "type": "header", "content": "Drawer" },
    { "type": "text", "id": "menu_title", "label": "Drawer title", "default": "Menu" },
    { "type": "text", "id": "menu_label", "label": "Hamburger label (for screen readers)", "default": "Menu" },
    { "type": "text", "id": "close_label", "label": "Close label (for screen readers)", "default": "Close" },
    { "type": "text", "id": "login_label", "label": "Account link at the bottom of the drawer", "default": "Log in", "info": "Leave empty to hide it." },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "search_label", "label": "Search label", "default": "Search" },
    { "type": "text", "id": "cart_label", "label": "Cart label", "default": "Cart" }
  ],
  "blocks": [
    { "type": "link", "name": "Menu link", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Create Your Song" },
      { "type": "text", "id": "link", "label": "Link", "default": "#" }
    ] }
  ],
  "presets": [
    { "name": "CraftStory Duo Header", "blocks": [
      { "type": "link", "settings": { "label": "Create Your Song", "link": "#" } },
      { "type": "link", "settings": { "label": "Track Order", "link": "#" } },
      { "type": "link", "settings": { "label": "Contact", "link": "#" } }
    ] }
  ]
}
{% endschema %}
{% stylesheet %}
.cs-duo-head{--cs-dhd-h:56px;--cs-dhd-logo-w:200px;--cs-dhd-logo-w-m:120px}
.cs-dhd-bar{background:var(--cs-paper);border-bottom:1px solid var(--cs-line);
  transition:box-shadow .2s ease}
.cs-dhd-stuck .cs-dhd-bar{box-shadow:0 10px 26px -20px rgba(36,27,58,.55)}
.cs-dhd-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;
  column-gap:10px;min-height:var(--cs-dhd-h);padding-top:6px;padding-bottom:6px}
/* their header-drawer: justify-self:start + margin-left:-1.2rem */
.cs-dhd-drawerbtn{justify-self:start;margin-left:-12px}
.cs-dhd-burger,.cs-dhd-iconbtn,.cs-dhd-close{display:inline-flex;align-items:center;
  justify-content:center;width:44px;height:44px;padding:0;border:0;background:none;
  color:var(--cs-ink);cursor:pointer;border-radius:50%;font:inherit;
  transition:background .18s ease,color .18s ease;text-decoration:none}
.cs-dhd-burger:hover,.cs-dhd-iconbtn:hover,.cs-dhd-close:hover{background:var(--cs-paper2)}
.cs-dhd-burger .cs-dhd-ico,.cs-dhd-searchbtn .cs-dhd-ico,.cs-dhd-iconbtn svg,.cs-dhd-close svg{width:20px;height:20px}
.cs-dhd-ico-close{display:none}
.cs-dhd-open .cs-dhd-burger .cs-dhd-ico-open{display:none}
.cs-dhd-open .cs-dhd-burger .cs-dhd-ico-close{display:block}
.cs-dhd-searchon .cs-dhd-searchbtn .cs-dhd-ico-open{display:none}
.cs-dhd-searchon .cs-dhd-searchbtn .cs-dhd-ico-close{display:block}
.cs-dhd-logo{justify-self:start;min-width:0;display:inline-flex;flex-direction:column;
  align-items:center;gap:2px;text-decoration:none;color:var(--cs-ink);line-height:1;
  max-width:var(--cs-dhd-logo-w-m)}
.cs-dhd-logoimg{width:100%;max-width:var(--cs-dhd-logo-w-m);height:auto;object-fit:contain}
.cs-dhd-wave{display:block;color:var(--cs-coral)}
.cs-dhd-wave svg{width:40px;height:11px;display:block}
.cs-dhd-word{font-family:var(--cs-serif);font-weight:600;letter-spacing:-.02em;
  font-size:clamp(1.02rem,4.2vw,1.32rem);white-space:nowrap}
.cs-dhd-word em{font-style:italic;color:var(--cs-coral)}
.cs-dhd-icons{justify-self:end;display:flex;align-items:center;gap:10px;min-width:0}
.cs-dhd-ctagroup{display:flex;align-items:center;gap:2rem}
.cs-dhd-track{display:none;white-space:nowrap;font-size:.95rem;font-weight:600;opacity:.9;
  text-decoration:none;color:var(--cs-ink)}
.cs-dhd-track:hover{opacity:1;text-decoration:underline}
.cs-dhd-cta{display:inline-flex;align-items:center;justify-content:center;
  background:var(--cs-coral);color:#fff;text-decoration:none;border-radius:var(--cs-pill);
  padding:10px 14px;font-family:var(--cs-sans);font-weight:700;font-size:14px;line-height:1;
  white-space:nowrap;box-shadow:0 6px 16px rgba(179,90,50,.25);
  transition:background .18s ease,transform .18s ease}
.cs-dhd-cta:hover{background:var(--cs-coral-deep);transform:translateY(-1px)}
.cs-dhd-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;
  clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
.cs-dhd-account{display:none}
/* search: off by default in the settings, like theirs, but the component is built */
.cs-dhd-searchpanel{display:none;border-top:1px solid var(--cs-line);background:var(--cs-card)}
.cs-dhd-searchon .cs-dhd-searchpanel{display:block}
.cs-dhd-searchform{display:flex;align-items:center;gap:9px;padding-top:11px;padding-bottom:13px}
.cs-dhd-searchinput{flex:1;min-width:0;font:inherit;font-size:1rem;color:var(--cs-ink);
  background:var(--cs-paper);border:1.5px solid var(--cs-line);border-radius:var(--cs-pill);
  padding:12px 16px;min-height:46px}
.cs-dhd-searchinput:focus{outline:2px solid var(--cs-coral);outline-offset:1px;border-color:transparent}
.cs-dhd-searchgo{flex:0 0 auto;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;
  color:#fff;background:var(--cs-ink);border:0;border-radius:var(--cs-pill);padding:12px 18px;min-height:46px}
/* drawer */
.cs-dhd-menu{position:fixed;inset:0;z-index:70;visibility:hidden}
.cs-dhd-open .cs-dhd-menu{visibility:visible}
.cs-dhd-overlay{position:absolute;inset:0;background:rgba(28,21,51,.52);opacity:0;
  transition:opacity .24s ease}
.cs-dhd-open .cs-dhd-overlay{opacity:1}
.cs-dhd-panel{position:absolute;top:0;left:0;bottom:0;width:min(88vw,400px);
  display:flex;flex-direction:column;background:var(--cs-paper);
  border-right:1px solid var(--cs-line);box-shadow:var(--cs-sh-lg);
  transform:translateX(-102%);transition:transform .26s ease;overflow-y:auto;
  padding-bottom:env(safe-area-inset-bottom,0px)}
.cs-dhd-open .cs-dhd-panel{transform:translateX(0)}
.cs-dhd-panel-top{display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:10px 12px 10px 20px;border-bottom:1px solid var(--cs-line)}
.cs-dhd-title{font-family:var(--cs-serif);font-weight:600;font-size:1.18rem;margin:0}
.cs-dhd-nav{padding:8px 0 4px}
.cs-dhd-list{list-style:none;margin:0;padding:0}
.cs-dhd-item{display:flex;align-items:center;min-height:52px;padding:16px 20px;
  font-size:1.06rem;font-weight:600;color:var(--cs-ink);text-decoration:none;line-height:1.3}
.cs-dhd-item:hover{background:var(--cs-paper2);color:var(--cs-coral)}
.cs-dhd-hint{padding:16px 20px;font-size:.86rem;font-weight:600;color:var(--cs-ink3);line-height:1.45}
.cs-dhd-utility{margin-top:auto;border-top:1px solid var(--cs-line);padding:14px 20px 18px}
.cs-dhd-login{display:inline-flex;align-items:center;gap:10px;min-height:44px;
  font-size:1rem;font-weight:600;color:var(--cs-ink);text-decoration:none}
.cs-dhd-login svg{width:19px;height:19px;flex:0 0 19px}
.cs-dhd-login:hover{color:var(--cs-coral)}
.cs-dhd-burger:focus-visible,.cs-dhd-iconbtn:focus-visible,.cs-dhd-close:focus-visible,
.cs-dhd-logo:focus-visible,.cs-dhd-cta:focus-visible,.cs-dhd-track:focus-visible,
.cs-dhd-item:focus-visible,.cs-dhd-login:focus-visible{outline:2px solid var(--cs-coral);
  outline-offset:2px;border-radius:var(--cs-r)}
html.cs-head-locked,html.cs-head-locked body{overflow:hidden}
@media(max-width:480px){
  /* text wordmark stacks so the row never overflows at 375px */
  .cs-dhd-word{white-space:normal;text-align:center;line-height:1.06;font-size:1rem}
  .cs-dhd-word em{display:block}
}
@media(max-width:360px){
  .cs-dhd-row{column-gap:6px}
  .cs-dhd-cta{padding:10px 12px;font-size:13.5px}
}
@media(min-width:750px){
  .cs-dhd-logo,.cs-dhd-logoimg{max-width:var(--cs-dhd-logo-w)}
  .cs-dhd-account{display:inline-flex}
  .cs-dhd-wave svg{width:52px;height:13px}
  .cs-dhd-cta{padding:12px 18px;font-size:16px}
}
@media(min-width:990px){
  .cs-duo-head{--cs-dhd-h:72px}
  .cs-dhd-row{padding-top:12px;padding-bottom:12px;column-gap:16px}
  .cs-dhd-track{display:inline-block}
}
@media(prefers-reduced-motion:reduce){
  .cs-dhd-panel,.cs-dhd-overlay{transition:none}
}
{% endstylesheet %}
{% javascript %}
(function () {
  if (window.csDuoHeadBound) return;
  window.csDuoHeadBound = true;

  var LOCK = 'cs-head-locked';
  var lastTrigger = null;

  function root(el) { return el ? el.closest('[data-cs-head]') : null; }
  function drawer(r) { return r ? r.querySelector('[data-cs-head-drawer]') : null; }
  function panel(r) { return r ? r.querySelector('[data-cs-head-panel]') : null; }
  function toggleBtn(r) { return r ? r.querySelector('[data-cs-head-toggle]') : null; }

  function anyOpen() { return document.querySelector('[data-cs-head].cs-dhd-open'); }

  function lock(on) {
    try {
      if (on) document.documentElement.classList.add(LOCK);
      else if (!anyOpen()) document.documentElement.classList.remove(LOCK);
    } catch (e) {}
  }

  function focusable(p) {
    if (!p) return [];
    var sel = 'a[href],button:not([disabled]),input:not([type="hidden"]):not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
    return Array.prototype.filter.call(p.querySelectorAll(sel), function (el) {
      return el.offsetWidth > 0 || el.offsetHeight > 0 || el === document.activeElement;
    });
  }

  function open(r, trigger) {
    if (!r || r.classList.contains('cs-dhd-open')) return;
    lastTrigger = trigger || toggleBtn(r);
    r.classList.add('cs-dhd-open');
    var d = drawer(r);
    if (d) d.removeAttribute('aria-hidden');
    var t = toggleBtn(r);
    if (t) t.setAttribute('aria-expanded', 'true');
    lock(true);
    var p = panel(r);
    if (p) { try { p.focus(); } catch (e) {} }
  }

  function close(r) {
    if (!r || !r.classList.contains('cs-dhd-open')) return;
    r.classList.remove('cs-dhd-open');
    var d = drawer(r);
    if (d) d.setAttribute('aria-hidden', 'true');
    var t = toggleBtn(r);
    if (t) t.setAttribute('aria-expanded', 'false');
    lock(false);
    var back = lastTrigger && document.contains(lastTrigger) ? lastTrigger : t;
    lastTrigger = null;
    if (back) { try { back.focus(); } catch (e) {} }
  }

  function toggleSearch(r, btn) {
    if (!r) return;
    var on = r.classList.toggle('cs-dhd-searchon');
    btn.setAttribute('aria-expanded', on ? 'true' : 'false');
    var sp = r.querySelector('[data-cs-head-searchpanel]');
    if (sp) {
      if (on) sp.removeAttribute('aria-hidden');
      else sp.setAttribute('aria-hidden', 'true');
    }
    var input = sp && sp.querySelector('input[type="search"]');
    if (on && input) { try { input.focus(); } catch (e) {} }
    else if (!on && btn) { try { btn.focus(); } catch (e) {} }
  }

  // Delegated, so it survives a theme-editor re-render of the section.
  document.addEventListener('click', function (e) {
    var t = e.target.closest ? e.target.closest('[data-cs-head-toggle]') : null;
    if (t) {
      e.preventDefault();
      var r = root(t);
      if (r && r.classList.contains('cs-dhd-open')) close(r); else open(r, t);
      return;
    }
    var c = e.target.closest ? e.target.closest('[data-cs-head-close]') : null;
    if (c) { e.preventDefault(); close(root(c)); return; }
    var s = e.target.closest ? e.target.closest('[data-cs-head-search]') : null;
    if (s) { e.preventDefault(); toggleSearch(root(s), s); return; }
  });

  document.addEventListener('keydown', function (e) {
    var r = anyOpen();
    if (e.key === 'Escape' || e.key === 'Esc') {
      if (r) { e.preventDefault(); close(r); return; }
      var sr = document.querySelector('[data-cs-head].cs-dhd-searchon');
      if (sr) { sr.classList.remove('cs-dhd-searchon'); }
      return;
    }
    if (e.key !== 'Tab' || !r) return;
    var items = focusable(panel(r));
    if (!items.length) return;
    var first = items[0];
    var last = items[items.length - 1];
    var active = document.activeElement;
    if (!panel(r).contains(active)) { e.preventDefault(); first.focus(); return; }
    if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
  });

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () {
      var stuck = (window.pageYOffset || document.documentElement.scrollTop || 0) > 4;
      Array.prototype.forEach.call(document.querySelectorAll('[data-cs-head].cs-dhd-sticky'), function (r) {
        r.classList.toggle('cs-dhd-stuck', stuck);
      });
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.addEventListener('shopify:section:load', function (e) {
    onScroll();
    var r = e.target && e.target.querySelector ? e.target.querySelector('[data-cs-head]') : null;
    if (r) lock(false);
  });
})();
{% endjavascript %}
