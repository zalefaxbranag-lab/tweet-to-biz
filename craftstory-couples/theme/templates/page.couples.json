    "steps": {
      "type": "cs-duo-steps",
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Tell us about the two of you",
            "body": "Five questions: how you met, what you call each other, the moment you would keep, the style you want. Type it the way you would say it.",
            "note": "2 minutes"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "We write and record the song",
            "body": "Your answers become real lyrics with their name in them, then a finished track in the genre you picked.",
            "note": "Nothing for you to do"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "We film the music video",
            "body": "The two of you become the couple on screen, so the video tells your story and not a stock one.",
            "note": "Included"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Hear your free preview",
            "body": "You get a preview before you decide anything. If it is not right, you pay nothing and you can tell us to start over.",
            "note": "Free"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3",
        "s4"
      ],
      "settings": {}
    },
