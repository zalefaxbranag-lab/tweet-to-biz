    "faq": {
      "type": "cs-duo-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "What makes this music video special ?",
            "a": "<p>It is written from scratch for the two of you. Your names, your places and the moments only you two know go into the lyrics, and the music video is animated around the same story.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How long until I receive the song ?",
            "a": "<p>Your free preview arrives within minutes. The finished song and music video follow within 48 hours.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "What if I need it faster ?",
            "a": "<p>Tell us the date when you order and we will say straight away whether we can make it. If we cannot, you pay nothing.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "What occasions work best ?",
            "a": "<p>Weddings, proposals, anniversaries, the wedding morning, a long stretch apart, or no occasion at all. Anything with a story behind it works.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "How do you create the music video ?",
            "a": "<p>You answer five plain questions about the two of you. We turn those answers into lyrics, record the song in the genre you pick, and animate a music video to match.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "How do I get my music video ?",
            "a": "<p>By email, as a private link you can open on any phone or computer. Nothing is shipped and nothing can get lost in the post.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "Can I play it at a party or event ?",
            "a": "<p>Yes. It is yours — first dance, reception, an anniversary dinner, or just the car. Play it wherever you want, as often as you want.</p>",
            "open": false,
            "delivery_line": false,
            "guarantee_line": false,
            "icon": ""
          }
        }
