        "r2": {
          "type": "review",
          "settings": {
            "quote": "We used it for our first dance. Half the room asked who the artist was. Nobody believed it had been written for us.",
            "stars": "★★★★★",
            "name": "Amelia & Josh",
            "meta": "Wedding"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "The video is the part that got him. Seeing the two of us on screen, in our own kitchen, to words I had written about him.",
            "stars": "★★★★★",
            "name": "Priya K.",
            "meta": "Just because"
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "quote": "Ordered on the Tuesday, had it on the Thursday. He has played it every morning since, and he is not a sentimental man.",
