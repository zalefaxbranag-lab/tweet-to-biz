    "faq": {
      "type": "cs-duo-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Do I have to be good with words?",
            "a": "<p>No. You are not writing anything. You answer five plain questions about the two of you, in your own words, and we turn those answers into lyrics.</p>",
            "open": false
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Do the two of us really appear in the music video?",
            "a": "<p>Yes — that is the part nobody else does. The couple on screen is built to look like you, so the video tells your story instead of a stock one.</p>",
            "open": false
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Can I choose the style?",
            "a": "<p>You pick the genre and the mood. Country, soul, pop, acoustic, rap — whatever they would actually put on.</p>",
            "open": false
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "How long does it take?",
            "a": "<p>You hear a free preview on the same visit, before you pay anything.</p>",
            "open": false,
            "delivery_line": true
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "What if I do not like it?",
            "a": "<p>The free preview comes first, so you decide after hearing it. If it is not right, you owe nothing.</p>",
            "open": false,
            "guarantee_line": true
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "What exactly do I receive?",
            "a": "<p>A full-length song and a music video, both about the two of you, sent as a private link you can open on any phone or computer and share however you like.</p>",
            "open": false
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "Can we play it at the wedding?",
            "a": "<p>Yes. It is yours — first dance, reception, an anniversary dinner, or just the car. Play it wherever you want, as often as you want.</p>",
            "open": false
          }
        }
      },
